-enum { PS3_FAULT_SEGV = 0, PS3_FAULT_BUS = 1, PS3_FAULT_SLOTS = 2 };
-static struct sigaction s_prev_fault[PS3_FAULT_SLOTS];
-static int              s_prev_fault_valid[PS3_FAULT_SLOTS];
