+static int rtcube_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_CUBE_RT"); on = !(e && e[0] == '0'); }
+    return on;
+}
+/* Rows one face occupies: level 0 and every smaller level below it. */
+static u32 rtcube_rows(u32 h, u32 mips)
+{
+    u32 rows = 0;
+    for (u32 l = 0; l < mips; l++) rows += (h >> l) ? (h >> l) : 1u;
+    return rows;
+}
+/* The cube for a unit bound at `raw` whose face 0 is target `slot`, or -1. */
+static int rtcube_get(u32 raw, u32 w, u32 h, u32 mips, int slot)
+{
+    const OffRT* r0 = &s_d3d.off_rt[slot];
+    if (w != h || !w || !r0->pitch) return -1;
+    if (!mips) mips = 1;
+    while (mips > 1 && rtcube_rows(h, mips) > r0->h) mips--;   /* only levels the face holds */
+    int free_i = -1;
+    for (int i = 0; i < RTCUBE_MAX; i++) {
+        RtCube* c = &s_rtcube[i];
+        if (c->res && c->raw == raw && c->w == w && c->mips == mips && c->dxgi == r0->dxgi) return i;
+        if (!c->res && free_i < 0) free_i = i;
+    }
+    if (free_i < 0) return -1;
+    RtCube* c = &s_rtcube[free_i];
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w; td.Height = h; td.DepthOrArraySize = 6; td.MipLevels = (UINT16)mips;
+    td.Format = (DXGI_FORMAT)r0->dxgi; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
