+uint64_t ps3_tl_us(void)
+{
+    LARGE_INTEGER t; QueryPerformanceCounter(&t);
+    if (!s_tl_freq.QuadPart) { QueryPerformanceFrequency(&s_tl_freq); }
+    return (uint64_t)((t.QuadPart - s_tl_t0.QuadPart) * 1000000 / s_tl_freq.QuadPart);
