+        colours[i][2] = (u8)((b5 << 3) | (b5 >> 2)); colours[i][3] = 255;
+    }
+    for (int k = 0; k < 3; k++) {
+        if (a > b || format != 0x86) {
+            colours[2][k] = (u8)((2u * colours[0][k] + colours[1][k]) / 3);
+            colours[3][k] = (u8)((colours[0][k] + 2u * colours[1][k]) / 3);
+        } else {
+            colours[2][k] = (u8)((colours[0][k] + colours[1][k]) / 2);
+            colours[3][k] = 0;
+        }
+    }
+    colours[2][3] = 255; colours[3][3] = (a <= b && format == 0x86) ? 0 : 255;
+    u32 indices = (u32)c[4] | ((u32)c[5] << 8) | ((u32)c[6] << 16) | ((u32)c[7] << 24);
+    memcpy(out, colours[(indices >> (2 * pixel)) & 3], 4);
+    if (format == 0x87) out[3] = (u8)(((block[pixel / 2] >> (4 * (pixel & 1))) & 15) * 17);
+    if (format == 0x88) {
+        u8 alpha[8]; alpha[0] = block[0]; alpha[1] = block[1];
+        if (alpha[0] > alpha[1]) {
+            for (u32 i = 2; i < 8; i++) alpha[i] = (u8)(((8-i)*alpha[0] + (i-1)*alpha[1]) / 7);
+        } else {
+            for (u32 i = 2; i < 6; i++) alpha[i] = (u8)(((6-i)*alpha[0] + (i-1)*alpha[1]) / 5);
+            alpha[6] = 0; alpha[7] = 255;
+        }
+        u64 bits = 0; for (u32 i = 0; i < 6; i++) bits |= (u64)block[2+i] << (8*i);
+        out[3] = alpha[(bits >> (3*pixel)) & 7];
+    }
+}
