+static u8 pad_sdl_dyn_axis(int raw)
+{
+    /* the same dead zone the XInput path uses */
+    return pad_xinput_stick_to_u8((short)raw, PAD_STICK_DEADZONE);
+}
+
+static unsigned s_guide;   /* ports whose PS/guide button is down this poll */
+static unsigned s_sdl_guide;
+static PadHostState s_sdl_state[PAD_MAX_HOST_PORTS];
+
+static void pad_poll_sdl_dyn(void)
+{
+    s_sdl_guide = 0;
+    static unsigned long long last_scan = 0;
+    unsigned long long now = GetTickCount64();
+    s_sdl.GameControllerUpdate();
+    /* Retire removed handles BEFORE assigning new devices to ports. A rapid
+     * unplug/replug must not move player one into the next empty port. */
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+        if (s_sdl_pad[i] && !s_sdl.GameControllerGetAttached(s_sdl_pad[i])) {
+            s_sdl.GameControllerClose(s_sdl_pad[i]);
+            s_sdl_pad[i] = NULL;
+            last_scan = 0;
+            printf("[cellPad] port %d: controller removed\n", i);
+            fflush(stdout);
+        }
+    }
+    if (!last_scan || now - last_scan >= 1000) { last_scan = now; pad_sdl_dyn_scan(); }
+
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+        void* gc = s_sdl_pad[i];
+        PadHostState* hs = &s_sdl_state[i];
+        memset(hs, 0, sizeof(*hs));
+        hs->analog_lx = hs->analog_ly = hs->analog_rx = hs->analog_ry = 128;
+        if (!gc || !s_sdl.GameControllerGetAttached(gc)) {
+            if (gc) { s_sdl.GameControllerClose(gc); s_sdl_pad[i] = NULL;
+                      printf("[cellPad] port %d: controller removed%c", i, 10); fflush(stdout); }
+            hs->connected = 0;
+            continue;
+        }
+        static const struct { int sdl; u16 btn; } map[] = {
+            { 0, CELL_PAD_CTRL_CROSS },    { 1, CELL_PAD_CTRL_CIRCLE },
+            { 2, CELL_PAD_CTRL_SQUARE },   { 3, CELL_PAD_CTRL_TRIANGLE },
+            { 4, CELL_PAD_CTRL_SELECT },   { 6, CELL_PAD_CTRL_START },
+            { 7, CELL_PAD_CTRL_L3 },       { 8, CELL_PAD_CTRL_R3 },
+            { 9, CELL_PAD_CTRL_L1 },       { 10, CELL_PAD_CTRL_R1 },
+            { 11, CELL_PAD_CTRL_UP },      { 12, CELL_PAD_CTRL_DOWN },
+            { 13, CELL_PAD_CTRL_LEFT },    { 14, CELL_PAD_CTRL_RIGHT },
+        };
+        u16 btns = 0;
+        for (unsigned k = 0; k < sizeof map / sizeof map[0]; k++)
+            if (s_sdl.GameControllerGetButton(gc, map[k].sdl)) btns |= map[k].btn;
+        int lt = s_sdl.GameControllerGetAxis(gc, 4), rt = s_sdl.GameControllerGetAxis(gc, 5);
+        if (lt > 3000) btns |= CELL_PAD_CTRL_L2;
+        if (rt > 3000) btns |= CELL_PAD_CTRL_R2;
+        /* SDL_CONTROLLER_BUTTON_GUIDE (the PS button): not a game button, for
+         * the port's own overlay (g_pad_menu_buttons). */
+        if (s_sdl.GameControllerGetButton(gc, 5)) s_sdl_guide |= 1u << i;
+
+        hs->connected = 1;
+        hs->buttons = btns;
+        hs->analog_lx = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 0));
+        hs->analog_ly = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 1));
+        hs->analog_rx = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 2));
+        hs->analog_ry = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 3));
+        hs->trigger_l2 = (u8)(lt < 0 ? 0 : lt * 255 / 32767);
+        hs->trigger_r2 = (u8)(rt < 0 ? 0 : rt * 255 / 32767);
+        hs->press_up       = (btns & CELL_PAD_CTRL_UP)       ? 255 : 0;
+        hs->press_down     = (btns & CELL_PAD_CTRL_DOWN)     ? 255 : 0;
+        hs->press_left     = (btns & CELL_PAD_CTRL_LEFT)     ? 255 : 0;
+        hs->press_right    = (btns & CELL_PAD_CTRL_RIGHT)    ? 255 : 0;
+        hs->press_triangle = (btns & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+        hs->press_circle   = (btns & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+        hs->press_cross    = (btns & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+        hs->press_square   = (btns & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+        hs->press_l1       = (btns & CELL_PAD_CTRL_L1)       ? 255 : 0;
+        hs->press_r1       = (btns & CELL_PAD_CTRL_R1)       ? 255 : 0;
+    }
+}
