+/* Where the picture is in the window's client area, in client pixels (the
+ * port's overlay maps the mouse with it). */
+void rsx_d3d12_output_rect(int* x, int* y, int* w, int* h)
+{
+    RECT rc = {0};
+    if (s_d3d.hwnd) GetClientRect(s_d3d.hwnd, &rc);
+    *x = 0; *y = 0; *w = rc.right; *h = rc.bottom;
+    if (!s_out_on || !s_out_w || !s_out_h) return;   /* the swap chain is stretched over it */
+    const double sx = (double)rc.right / s_out_w, sy = (double)rc.bottom / s_out_h;
+    *x = (int)(s_out_vp.TopLeftX * sx + 0.5); *y = (int)(s_out_vp.TopLeftY * sy + 0.5);
+    *w = (int)(s_out_vp.Width * sx + 0.5);    *h = (int)(s_out_vp.Height * sy + 0.5);
+}
+
+/* The swap chain's size and the picture's place in it. The picture keeps its
+ * shape: the render size's, or the ultrawide aspect when anamorphic.
+ *   RSX_OUTPUT_SIZE=WxH   the window's client size (2560x1440, 3440x1440...)
+ *   RSX_WINDOW_MODE=borderless   a borderless window over the primary monitor
+ *   RSX_OUTPUT_PASS=0     no scaling pass: DXGI stretches the frame (old way) */
+static void out_setup(u32 w, u32 h)
+{
+    float disp = (float)w / (float)h;
+    s_out_w = w; s_out_h = h;
+    if (rsx_ultrawide() == 1) { disp = uw_aspect(); s_out_w = uw_wide_w(h); }
+    const char* e = getenv("RSX_OUTPUT_SIZE");
+    unsigned ow = 0, oh = 0;
+    if (e && sscanf(e, "%ux%u", &ow, &oh) == 2 && ow >= 320 && oh >= 200 && ow <= 16384 && oh <= 16384) {
+        s_out_w = ow; s_out_h = oh;
+    }
+    const char* m = getenv("RSX_WINDOW_MODE");
+    s_borderless = m && (m[0] == 'b' || m[0] == 'B');
+    if (s_borderless) {
+        POINT pt = { 0, 0 };
+        MONITORINFO mi; memset(&mi, 0, sizeof mi); mi.cbSize = sizeof mi;
+        if (GetMonitorInfoA(MonitorFromPoint(pt, MONITOR_DEFAULTTOPRIMARY), &mi)) {
+            s_mon_rc = mi.rcMonitor;
+            s_out_w = (u32)(s_mon_rc.right - s_mon_rc.left); s_out_h = (u32)(s_mon_rc.bottom - s_mon_rc.top);
+        } else s_borderless = 0;
+    }
