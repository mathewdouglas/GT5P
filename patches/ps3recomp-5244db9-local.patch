+/* Output pass: the display image, scaled into the swap chain's picture
+ * rectangle (letterboxed when the shapes differ, bars black). Catmull-Rom
+ * bicubic from nine bilinear taps, which keeps an upscale (1080 to 1440)
+ * sharper than bilinear; RSX_OUTPUT_FILTER=linear for bilinear. s15 is the
+ * bank's linear/clamp sampler. */
+static ID3D12PipelineState* s_out_pso;
+
+static int output_pso_ensure(void)
+{
+    if (s_out_pso) return 1;
+    static int failed;
+    if (failed) return 0;
+    static const char src[] =
+        "Texture2D t : register(t0); SamplerState s : register(s15);"
+        "struct V { float4 p : SV_Position; float2 uv : TEXCOORD0; };"
+        "V vs(uint i : SV_VertexID) { V o; float2 c = float2(i == 1 ? 2 : 0, i == 2 ? 2 : 0);"
+        " o.uv = c; o.p = float4(c.x * 2 - 1, 1 - c.y * 2, 0, 1); return o; }"
+        "float3 tap(float2 uv) { return t.SampleLevel(s, uv, 0).rgb; }"
+        "float4 ps_lin(V v) : SV_Target { return float4(tap(v.uv), 1); }"
+        "float4 ps_cub(V v) : SV_Target {"
+        " float2 sz; t.GetDimensions(sz.x, sz.y);"
+        " float2 p = v.uv * sz, c = floor(p - 0.5) + 0.5, f = p - c;"
+        " float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f)), w1 = 1.0 + f * f * (-2.5 + 1.5 * f);"
+        " float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f)), w3 = f * f * (-0.5 + 0.5 * f);"
+        " float2 wm = w1 + w2, a = (c - 1.0) / sz, b = (c + w2 / wm) / sz, d = (c + 2.0) / sz;"
+        " float3 r = (tap(float2(a.x, a.y)) * w0.x + tap(float2(b.x, a.y)) * wm.x + tap(float2(d.x, a.y)) * w3.x) * w0.y"
+        "          + (tap(float2(a.x, b.y)) * w0.x + tap(float2(b.x, b.y)) * wm.x + tap(float2(d.x, b.y)) * w3.x) * wm.y"
+        "          + (tap(float2(a.x, d.y)) * w0.x + tap(float2(b.x, d.y)) * wm.x + tap(float2(d.x, d.y)) * w3.x) * w3.y;"
+        " return float4(saturate(r), 1); }";
+    const char* f = getenv("RSX_OUTPUT_FILTER");
+    const char* ps_name = (f && (f[0] == 'l' || f[0] == 'L')) ? "ps_lin" : "ps_cub";
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL;
+    HRESULT hr = D3DCompile(src, sizeof(src) - 1, "output", NULL, NULL, "vs", "vs_5_0", 0, 0, &vs, &err);
+    if (err) { err->lpVtbl->Release(err); err = NULL; }
+    if (SUCCEEDED(hr)) hr = D3DCompile(src, sizeof(src) - 1, "output", NULL, NULL, ps_name, "ps_5_0", 0, 0, &ps, &err);
+    if (SUCCEEDED(hr)) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = s_d3d.vp_root_sig;
+        pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+        pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+        pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+        pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+        pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.SampleMask = UINT_MAX;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        pd.NumRenderTargets = 1;
+        pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+        pd.SampleDesc.Count = 1;
+        hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(s_d3d.device, &pd,
+            &IID_ID3D12PipelineState, (void**)&s_out_pso);
+    }
+    if (FAILED(hr)) {
+        failed = 1;
+        fprintf(stderr, "[output] pipeline creation failed 0x%08lX %s%c", (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "", 10);
+    }
+    if (err) err->lpVtbl->Release(err);
+    if (vs) vs->lpVtbl->Release(vs);
+    if (ps) ps->lpVtbl->Release(ps);
+    return s_out_pso != NULL;
