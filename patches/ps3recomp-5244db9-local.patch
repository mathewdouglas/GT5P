+    if (s_gf_call) return (int)vi;               /* the guest index; vgpu_finish rebases */
+    u32 h = (vi * 0x9E3779B1u) >> 20;            /* 4096 buckets */
+    while (s_ixm_gen[h] == s_ixm_cur) {
+        if (s_ixm_key[h] == vi) return (int)s_ixm_val[h];
+        h = (h + 1) & (IXMAP_N - 1);
+    }
+    if (s_ix_nv >= s_ix_maxv) return -1;
+    u8* d = s_ix_dst + (size_t)s_ix_nv * s_cur_vstride;
+    for (int k = 0; k < s_vplan_n; k++) {
+        float v[4];
+        vplan_fetch(&s_vplan[k], st, vi, v);
+        if (s_vplan[k].idx == 0) {
+            const rsx_vertex_attrib* a = &st->vertex_attribs[0];
+            u32 n = a->size ? a->size : 4; if (n > 4) n = 4;
+            rsx_vtx_pos_dbg(st, v, n);
+        }
+        memcpy(d + 16 * k, v, 16);
+    }
+    s_ixm_gen[h] = s_ixm_cur; s_ixm_key[h] = vi; s_ixm_val[h] = s_ix_nv;
+    return (int)s_ix_nv++;
+}
+/* Bytes one element of an attribute takes (rsx_fetch_attrib's formats). */
+static u32 vf_elem_bytes(u32 type, u32 n)
+{
+    switch (type) {
+    case 3: case 1: case 5: return 2u * n;
+    case 4: case 7:         return n;
+    case 6:                 return 4u;
+    default:                return 4u * n;
+    }
+}
+/* Guest RSX bytes [off, off + len) of LOCAL (main_ = 0) or MAIN memory into
+ * dst, resolving each 1 MB page as vplan_fetch does. */
+static int vraw_copy(u8* dst, u32 main_, u32 off, u32 len)
+{
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    extern uint8_t* vm_base;
+    while (len) {
+        u32 in = off & 0xFFFFFu, n = 0x100000u - in;
+        if (n > len) n = len;
+        u32 ea = cellGcmResolveLocated(main_ ? 0 : 1, off & ~0xFFFFFu);
+        if (ea == 0xFFFFFFFFu) return 0;
+        memcpy(dst, vm_base + ea + in, n);
+        dst += n; off += n; len -= n;
+    }
+    return 1;
+}
+/* 0 when guest RSX bytes [off, off + len) equal `mine`. */
+static int vraw_cmp(const u8* mine, u32 main_, u32 off, u32 len)
+{
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    extern uint8_t* vm_base;
+    while (len) {
+        u32 in = off & 0xFFFFFu, n = 0x100000u - in;
+        if (n > len) n = len;
+        u32 ea = cellGcmResolveLocated(main_ ? 0 : 1, off & ~0xFFFFFu);
+        if (ea == 0xFFFFFFFFu || memcmp(mine, vm_base + ea + in, n)) return 1;
+        mine += n; off += n; len -= n;
+    }
+    return 0;
+}
+/* Guest bytes into ring offset `off` of this frame's half: the mirror, then
+ * the upload heap. */
+static int vraw_put(u32 off, u32 loc, u32 src, u32 len)
+{
+    if (!s_vraw_mirror)
+        return vraw_copy(s_vraw_mapped + (size_t)FR->parity * VRAW_BYTES + off, loc, src, len);
+    if (!vraw_copy(s_vraw_mirror + off, loc, src, len)) return 0;
+    memcpy(s_vraw_mapped + (size_t)FR->parity * VRAW_BYTES + off, s_vraw_mirror + off, len);
+    return 1;
+}
+/* Copies the raw bytes for the indices in s_ix_tmp (guest indices), sets the
+ * descriptors and rebases the indices. 0 when it cannot (ring full, stray
+ * index, unmapped page): the caller then converts on the CPU. */
+static int vgpu_finish_impl(void);
+/* The shader's decode, on the CPU, from the mirror of the raw ring. */
+static void vgpu_cpu_decode(int k, u32 vid, float out[4])
+{
+    memcpy(out, s_gf_def[k], 16);
+    const u32* d = s_gf_desc[k];
+    if (!(d[2] & 0x100u)) return;
+    u32 ty = d[2] & 0xFu, n = (d[2] >> 4) & 7u;
+    const u32 pbase = (2u - (u32)FR->parity) * VRAW_BYTES;   /* the persistent area, from this half */
+    const u8* s = (d[0] >= pbase && s_vper_mirror ? s_vper_mirror + (d[0] - pbase) : s_vraw_mirror + d[0]) + vid * d[1];
+    switch (ty) {
+    case 2: for (u32 c = 0; c < n; c++) out[c] = vf_bef(s + 4 * c); break;
+    case 3: for (u32 c = 0; c < n; c++) out[c] = rsx_rd_half_be(s + 2 * c); break;
+    case 4: for (u32 c = 0; c < n; c++) out[c] = s[c] / 255.0f; break;
+    case 1: for (u32 c = 0; c < n; c++) out[c] = (float)(s16)((s[2*c] << 8) | s[2*c+1]) / 32767.0f; break;
+    case 5: for (u32 c = 0; c < n; c++) out[c] = (float)(s16)((s[2*c] << 8) | s[2*c+1]); break;
+    case 6: { u32 w; memcpy(&w, s, 4); w = _byteswap_ulong(w);
+              int x = (int)(w & 0x7FFu), y = (int)((w >> 11) & 0x7FFu), z = (int)((w >> 22) & 0x3FFu);
+              if (x & 0x400) x -= 0x800; if (y & 0x400) y -= 0x800; if (z & 0x200) z -= 0x400;
+              out[0] = (float)x / 1023.0f; out[1] = (float)y / 1023.0f; out[2] = (float)z / 511.0f; break; }
+    case 7: for (u32 c = 0; c < n; c++) out[c] = (float)s[c]; break;
+    default: for (u32 c = 0; c < n; c++) out[c] = vf_bef(s + 4 * c); break;
+    }
+}
+static void vgpu_check(u32 vb)
+{
+    static u64 nchk = 0, nbad = 0;
+    for (u32 i = 0; i < s_ix_n; i++) {
+        u32 vid = s_ix_tmp[i], vi = vid + vb;
+        for (int k = 0; k < s_vplan_n; k++) {
+            float a[4], b[4];
+            vgpu_cpu_decode(s_vplan[k].idx, vid, a);
+            vplan_fetch(&s_vplan[k], s_gf_st, vi, b);
+            nchk++;
+            if (memcmp(a, b, 16)) {
+                if (nbad++ < 24)
+                    fprintf(stderr, "[VTXGPU-CHECK] a%d vi=%u vid=%u type=%u gpu=(%g %g %g %g) cpu=(%g %g %g %g) desc=%u/%u/0x%X%c",
+                            s_vplan[k].idx, vi, vid, s_vplan[k].type, a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3],
+                            s_gf_desc[s_vplan[k].idx][0], s_gf_desc[s_vplan[k].idx][1], s_gf_desc[s_vplan[k].idx][2], 10);
+            }
+        }
+    }
+    static double last = 0; double now = perf_now();
+    if (now - last > 5.0) { last = now;
+        fprintf(stderr, "[VTXGPU-CHECK] %llu attribute fetches checked, %llu differ%c",
+                (unsigned long long)nchk, (unsigned long long)nbad, 10); }
+}
+static int vgpu_finish(void)
+{
+    s_gf_il = 0;
+    if (vgpu_check_on()) {
+        int r = vgpu_finish_impl();
+        if (r && s_ix_n) vgpu_check(s_gf_check_vb);
+        return r;
+    }
+    if (!vstat_on()) return vgpu_finish_impl();
+    double t0 = perf_now(); u32 off0 = s_vraw_off;
+    int r = vgpu_finish_impl();
+    s_vs_gft += perf_now() - t0; s_vs_gfn++;
+    if (r) { s_vs_gfspan += s_ix_nv; if (s_vraw_off > off0) s_vs_gfbytes += s_vraw_off - off0; }
+    else s_vs_gffail++;
+    return r;
+}
+static VcEnt* vc_get(u64 key)
+{
+    u32 h = (u32)((key * 0x9E3779B97F4A7C15ull) >> 51);      /* VC_N = 8192 */
+    for (u32 i = 0; i < 32; i++, h = (h + 1) & (VC_N - 1)) {
+        VcEnt* e = &s_vc[h];
+        if (!e->used) {
+            if (s_vc_count >= VC_N * 3u / 4u) return NULL;
+            memset(e, 0, sizeof *e); e->used = 1; e->key = key; s_vc_count++;
+            e->vmin = 0xFFFFFFFFu;
+            return e;
+        }
+        if (e->key == key) return e;
+    }
+    return NULL;
+}
+static void vc_frame_end(void)
+{
+    s_vc_frame++;
+    if (!s_vc || s_vc_count < VC_N / 2u) return;
+    /* Drop the streams not seen for four frames (mostly the SPU ring's). */
+    static VcEnt* tmp = NULL;
+    if (!tmp && !(tmp = (VcEnt*)malloc((size_t)VC_N * sizeof(VcEnt)))) return;
+    memcpy(tmp, s_vc, (size_t)VC_N * sizeof(VcEnt));
+    memset(s_vc, 0, (size_t)VC_N * sizeof(VcEnt)); s_vc_count = 0;
+    for (u32 i = 0; i < VC_N; i++)
+        if (tmp[i].used && tmp[i].seen + 4u >= s_vc_frame) {
+            VcEnt* e = vc_get(tmp[i].key);
+            if (e) *e = tmp[i];
+        }
+}
+/* Cross-frame cache for one stream of this upload: 1 and *pl filled when it
+ * serves [vmin, vmax]; 0 to use the per-frame ring. */
+static int vc_place(const GfStream* t, u32 vmin, u32 vmax, GfPlace* pl)
+{
+    const u32 S = t->S, hib = t->hi - t->lo;
+    u64 key = ((u64)t->loc << 63) ^ ((u64)S << 40) ^ t->lo;
+    VcEnt* e = vc_get(key);
+    if (!e) return 0;
+    if (e->seen != s_vc_frame) {          /* first use this frame */
+        e->streak = (e->seen + 1u == s_vc_frame) ? e->streak + 1u : 0u;
+        e->seen = s_vc_frame;
+        if (!e->streak) { e->vmin = vmin; e->vmax = vmax; e->hib = hib; e->copy = 0; e->miss = 0; }
+        if (e->copy) e->clean++;          /* frames begun since its last mismatch or copy */
+    }
+    if (vmin < e->vmin) e->vmin = vmin;
+    if (vmax > e->vmax) e->vmax = vmax;
+    if (hib > e->hib) e->hib = hib;
+    if (e->gen != s_vper_gen) e->copy = 0;
+    if (e->vol || !e->streak) return 0;
+    const u32 pbase = (2u - (u32)FR->parity) * VRAW_BYTES;
+    static int strict = -1;
+    if (strict < 0) { const char* v = getenv("RSX_VTXCACHE_VERIFY"); strict = (v && v[0] == 'd') ? 1 : 0; }
+    if (e->copy && vmin >= e->cvmin && vmax <= e->cvmax && hib <= e->chib) {
+        if (!strict && e->clean >= 8u) {
+            /* Stable: the whole copy once a frame. */
+            if (e->vframe != s_vc_frame) {
+                if (!vraw_cmp(s_vper_mirror + e->dst, t->loc, e->src_lo, e->len)) { e->vframe = s_vc_frame; s_vs_vchitb += e->len; }
+                else e->clean = 0;
+            }
+            if (e->vframe == s_vc_frame) {
+                pl->dst = pbase + e->dst; pl->src_lo = e->src_lo; pl->base = e->cvmin;
+                pl->region = e->region; pl->reused = 1; pl->cached = 1;
+                s_vs_vchit++; s_vs_vcfree++;
+                return 1;
+            }
+        }
+        /* Used only if every byte of this upload's range still matches. */
+        u32 so = t->lo + vmin * S, n = (t->hi + vmax * S) - so;
+        if (!vraw_cmp(s_vper_mirror + e->dst + (so - e->src_lo), t->loc, so, n)) {
+            pl->dst = pbase + e->dst; pl->src_lo = e->src_lo; pl->base = e->cvmin;
+            pl->region = e->region; pl->reused = 1; pl->cached = 1;
+            s_vs_vchit++; s_vs_vchitb += n;
+            return 1;
+        }
+        s_vs_vcmiss++;
+        e->copy = 0; e->clean = 0;
+        if (++e->miss >= 4) { e->vol = 1; return 0; }   /* rewritten too often: leave it to the ring */
+    }
+    if (s_vc_frame < s_vper_resume) return 0;
+    /* Copy the whole range the stream's draws have used. */
+    u32 src_lo = t->lo + e->vmin * S, len = (e->vmax - e->vmin) * S + e->hib;
+    if (len > s_vc_max) return 0;
+    u32 dst = ((s_vper_off + 15u) & ~15u) + (src_lo & 3u);
+    if ((u64)dst + len + 16u > VPER_BYTES) {
+        /* Full: start again empty once the frames in flight are done with it. */
+        s_vper_gen++; s_vper_off = 0; s_vper_resume = s_vc_frame + 3u; s_vs_vcflush++;
+        return 0;
+    }
+    if (!vraw_copy(s_vper_mirror + dst, t->loc, src_lo, len)) return 0;
+    memcpy(s_vraw_mapped + (size_t)2 * VRAW_BYTES + dst, s_vper_mirror + dst, len);
+    if (dst < s_vper_dirty_lo) s_vper_dirty_lo = dst;
+    if (dst + len > s_vper_dirty_hi) s_vper_dirty_hi = dst + len;
+    s_vper_off = dst + len + 16u;
+    e->copy = 1; e->gen = s_vper_gen; e->cvmin = e->vmin; e->cvmax = e->vmax; e->chib = e->hib;
+    e->dst = dst; e->src_lo = src_lo; e->len = len; e->region = ++s_gf_region;
+    e->clean = 0; e->vframe = 0;
+    s_vs_vccopy++; s_vs_vccopyb += len;
+    pl->dst = pbase + dst; pl->src_lo = src_lo; pl->base = e->cvmin;
+    pl->region = e->region; pl->reused = 1; pl->cached = 1;
+    return 1;
+}
+/* The per-frame ring for one stream: a recent region of the same stream when
+ * the upload's bytes still match, an extension of the region copied last, or
+ * a new region. 0 when the ring is full or a page is unmapped. */
+static int gf_ring_place(const GfStream* t, u32 vmin, u32 vmax, GfPlace* pl)
+{
+    const u32 S = t->S, loc = t->loc, lo = t->lo, hi = t->hi;
+    const u32 key = (u32)(((((u64)loc << 63) ^ ((u64)S << 40) ^ lo) * 0x9E3779B97F4A7C15ull) >> 32) ^ (hi - lo);
+    /* A mesh arrives as batches of 256 indices whose vertex ranges overlap
+     * in no particular order, and batches of a few meshes interleave. A
+     * batch inside a recent region of the same stream copies nothing; one
+     * past the end of the region copied last extends it; otherwise a new
+     * region. No margin: bytes outside what a batch references may be ring
+     * space the SPU has not written yet. A region is reused only if every
+     * byte of the batch's range still matches what was copied: exact,
+     * whatever the game rewrites when (the label-window and spot-check rules
+     * both let stale vertices through: dark patches on car doors). */
+    GfRegion* r = NULL;
+    static int reuse = -1;
+    if (reuse < 0) { const char* e = getenv("RSX_VTXGPU_REUSE"); reuse = !(e && e[0] == '0'); }
+    for (int i = 0; i < GF_REGIONS && !r && reuse; i++) {
+        GfRegion* c = &s_gf_reg[i];
+        if (!c->valid || c->key != key || vmin < c->vmin) continue;
+        if (vmax > c->vmax && i != s_gf_tail) continue;
+        /* Extend only into the vertices just past the region: meshes share
+         * one large vertex array, and extending to a batch far along it
+         * copied everything in between. */
+        if (vmax > c->vmax && vmin > c->vmax + 1u) continue;
+        u32 top = vmax < c->vmax ? vmax : c->vmax;
+        u32 so = lo + vmin * S, n = (hi + top * S) - so;
+        if (vraw_cmp(s_vraw_mirror + c->dst + (so - c->src_lo), loc, so, n)) c->valid = 0;
+        else r = c;
+    }
+    int ext = r != NULL;
+    if (r && vmax > r->vmax) {
+        u32 have = r->src_lo + r->len;
+        u32 want = hi + vmax * S;
+        if (r->dst + r->len + 16u != s_vraw_off || want - have > (4u << 20) ||
+            (u64)s_vraw_off + (want - have) > VRAW_BYTES ||
+            !vraw_put(r->dst + r->len, loc, have, want - have))
+            ext = 0;
+        else {
+            r->len += want - have; r->vmax = vmax;
+            s_vs_gfext++; s_vs_gfextb += want - have;
+            s_vraw_off = r->dst + r->len + 16u;
+        }
+    }
+    if (!ext) {
+        s_vs_gfnew++;
+        u32 src_lo = lo + vmin * S, len = (hi + vmax * S) - src_lo;
+        u32 dst = ((s_vraw_off + 15u) & ~15u) + (src_lo & 3u);
+        if ((u64)dst + len + 16u > VRAW_BYTES || !vraw_put(dst, loc, src_lo, len)) return 0;
+        s_vraw_off = dst + len + 16u;
+        s_vs_gfnewb += len; s_vs_gfstride += S;
+        int slot = 0;
+        for (int i = 1; i < GF_REGIONS; i++)
+            if (!s_gf_reg[i].valid || (s_gf_reg[slot].valid && s_gf_reg[i].age < s_gf_reg[slot].age)) slot = i;
+        if (!s_gf_reg[0].valid) slot = 0;
+        r = &s_gf_reg[slot];
+        r->valid = 1; r->key = key; r->dst = dst; r->len = len;
+        r->vmin = vmin; r->vmax = vmax;
+        r->src_lo = src_lo; r->stride = S; r->loc = loc;
+        r->region = ++s_gf_region;
+        r->epoch = g_rsx_sema_epoch;
+        s_gf_tail = slot;
+        pl->reused = 0;
+    } else {
+        pl->reused = 1;   /* a record reading the same region may take this upload */
+        s_vs_gfreuse++;
+    }
+    r->age = ++s_gf_age;
+    pl->dst = r->dst; pl->src_lo = r->src_lo; pl->base = r->vmin; pl->region = r->region; pl->cached = 0;
+    return 1;
+}
+static int vgpu_finish_impl(void)
+{
+    const rsx_state* st = s_gf_st;
+    s_gf_extended = 0;
+    for (int i = 0; i < 16; i++) {
+        memcpy(s_gf_def[i], st->vertex_data4f[i], 16);
+        s_gf_desc[i][0] = s_gf_desc[i][1] = s_gf_desc[i][2] = s_gf_desc[i][3] = 0;
+    }
+    if (!s_ix_n) { s_ix_nv = 0; return 1; }
+    u32 vmin = 0xFFFFFFFFu, vmax = 0;
+    for (u32 i = 0; i < s_ix_n; i++) { u32 v = s_ix_tmp[i]; if (v < vmin) vmin = v; if (v > vmax) vmax = v; }
+    if (vmax - vmin > (1u << 20)) return 0;
+    u32 key = 2166136261u, S = 0, loc = 0, lo = 0xFFFFFFFFu, hi = 0;
+    int nf = 0, same = 1;
+    for (int k = 0; k < s_vplan_n; k++) {
+        const VtxPlan* q = &s_vplan[k];
+        key = (key ^ (u32)q->idx) * 16777619u;
+        if (!q->fetch) continue;
+        key = (key ^ q->type ^ (q->n << 4) ^ ((u32)q->main << 8)) * 16777619u;
+        key = (key ^ q->stride) * 16777619u;
+        key = (key ^ q->off) * 16777619u;
+        u32 e = vf_elem_bytes(q->type, q->n);
+        if (!nf) { S = q->stride; loc = (u32)q->main; }
+        else if (q->stride != S || (u32)q->main != loc) same = 0;
+        if (q->off < lo) lo = q->off;
+        if (q->off + e > hi) hi = q->off + e;
+        nf++;
+    }
+    u32 vb = vmin;
+    /* RSX_VTXGPU_FLOATIN=1 (test): the ring holds CPU-converted float4s, not
+     * the guest's bytes, so everything but the shader's format decode runs. */
+    { static int fi = -1; if (fi < 0) { const char* e = getenv("RSX_VTXGPU_FLOATIN"); fi = e ? atoi(e) : 0; }
+      if (fi == 2) {
+          /* Test: the old path's layout (every planned attribute, 16 bytes
+           * each, little-endian floats) in the raw ring, drawn through the
+           * input assembler with the old shader. */
+          u32 nv = vmax - vmin + 1, rec = (u32)s_vplan_n * 16u, len = nv * rec;
+          u32 dst = (s_vraw_off + 255u) & ~255u;
+          if ((u64)dst + len + 16u > VRAW_BYTES) return 0;
+          u8* out = s_vraw_mapped + (size_t)FR->parity * VRAW_BYTES + dst;
+          for (u32 v = 0; v < nv; v++)
+              for (int k = 0; k < s_vplan_n; k++) {
+                  float f[4];
+                  vplan_fetch(&s_vplan[k], st, vmin + v, f);
+                  memcpy(out + (size_t)v * rec + (u32)k * 16u, f, 16);
+              }
+          s_vraw_off = dst + len + 16u;
+          s_gf_tail = -1; s_gf_region_used = ++s_gf_region;
+          for (u32 i = 0; i < s_ix_n; i++) s_ix_tmp[i] -= vmin;
+          s_ix_nv = nv; s_gf_check_vb = vmin;
+          s_gf_il_ofs = dst; s_gf_il = 1;
+          return 1;
+      }
+      if (fi == 1 && nf) {
+          u32 nv = vmax - vmin + 1, rec = (u32)nf * 16u, len = nv * rec;
+          u32 dst = (s_vraw_off + 15u) & ~15u;
+          if ((u64)dst + len + 16u > VRAW_BYTES) return 0;
+          u8* out = s_vraw_mapped + (size_t)FR->parity * VRAW_BYTES + dst;
+          u8* mir = s_vraw_mirror ? s_vraw_mirror + dst : NULL;
+          for (u32 v = 0; v < nv; v++) {
+              int k2 = 0;
+              for (int k = 0; k < s_vplan_n; k++) {
+                  if (!s_vplan[k].fetch) continue;
+                  float f[4];
+                  vplan_fetch(&s_vplan[k], st, vmin + v, f);
+                  memcpy(out + (size_t)v * rec + k2 * 16u, f, 16);
+                  if (mir) memcpy(mir + (size_t)v * rec + k2 * 16u, f, 16);
+                  k2++;
+              }
+          }
+          int k2 = 0;
+          for (int k = 0; k < s_vplan_n; k++) {
+              const VtxPlan* q = &s_vplan[k];
+              if (!q->fetch) continue;
+              /* little-endian floats: the shader byte-swaps, so swap here */
+              s_gf_desc[q->idx][0] = dst + (u32)k2 * 16u;
+              s_gf_desc[q->idx][1] = rec;
+              s_gf_desc[q->idx][2] = 2u | (4u << 4) | 0x100u;
+              k2++;
+          }
+          for (u32 v = 0; v < nv; v++) for (u32 w = 0; w < rec; w += 4) {
