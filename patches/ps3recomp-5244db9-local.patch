diff --git a/runtime/spu/spu_fpmode.h b/runtime/spu/spu_fpmode.h
new file mode 100644
index 00000000..55c10331
--- /dev/null
+++ b/runtime/spu/spu_fpmode.h
@@ -0,0 +1,21 @@
+/* Host floating-point mode for threads that run SPU code. */
+#pragma once
+#include <stdlib.h>
+#if defined(_M_X64) || defined(__x86_64__)
+#include <xmmintrin.h>
+#endif
+
+/* The SPU's single-precision unit flushes denormal inputs and results to
+ * zero; x86 computes them, through microcode assists about a hundred times
+ * slower. A sound job's IIR filter whose state decays toward zero (GT5P's
+ * mixer at 0x1E8 of image j65DD2F53, hood camera) spent 40% of the job
+ * thread there. Each host thread that runs SPU code calls this once at its
+ * start: MXCSR flush-to-zero and denormals-are-zero. SPU_FTZ=0 leaves MXCSR
+ * alone. Never call it on a PPU thread: PPU floating point keeps denormals. */
+static inline void spu_host_fp_mode(void)
+{
+#if defined(_M_X64) || defined(__x86_64__)
+    const char* e = getenv("SPU_FTZ");
+    if (!(e && *e == '0')) _mm_setcsr(_mm_getcsr() | 0x8040u);
+#endif
+}
