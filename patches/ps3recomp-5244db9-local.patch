+    *x = 0; *y = 0; *w = rc.right; *h = rc.bottom;
+    if (!s_out_on || !s_out_w || !s_out_h) return;   /* the swap chain is stretched over it */
+    const double sx = (double)rc.right / s_out_w, sy = (double)rc.bottom / s_out_h;
+    *x = (int)(s_out_vp.TopLeftX * sx + 0.5); *y = (int)(s_out_vp.TopLeftY * sy + 0.5);
+    *w = (int)(s_out_vp.Width * sx + 0.5);    *h = (int)(s_out_vp.Height * sy + 0.5);
