+static void xf_frame_end(void)
+{
+    if (!xfstat_on()) return;
+    s_xf_cur = (s_xf_cur + 1) % 3; s_xf_gen++; s_xf_frames++;
+    double now = perf_now();
+    if (s_xf_last == 0) s_xf_last = now;
+    if (now - s_xf_last < 5.0) return;
+    s_xf_last = now;
+    double f = s_xf_frames ? (double)s_xf_frames : 1.0;
+    fprintf(stderr, "[xfstat] 5 s, %llu frames: per frame %.0f indexed calls, %.2f MB index bytes, %.2f MB vertex bytes referenced%c",
