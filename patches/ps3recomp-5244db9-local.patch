+    return h;
+}
+static int dxbc_mem_on(void)
+{
+    const char* e = getenv("RSX_DXBC_MEM");
+    return !e || strcmp(e, "0");
+}
+static unsigned dxbc_mem_index(u64 h)
+{
+    return (unsigned)(h ^ (h >> 32)) & (DXBC_MEM_SLOTS - 1);
+}
+static int dxbc_mem_get(u64 h, ID3DBlob** out)
+{
+    if (!dxbc_mem_on()) return 0;
+    unsigned i = dxbc_mem_index(h);
+    AcquireSRWLockExclusive(&s_dxbc_mem_lk);
+    int hit = s_dxbc_mem[i].blob && s_dxbc_mem[i].hash == h;
+    if (hit) {
+        *out = s_dxbc_mem[i].blob;
+        (*out)->lpVtbl->AddRef(*out);
+        s_dxbc_mem_hits++;
+    } else s_dxbc_mem_misses++;
+    if (getenv("RSX_PSO_TIMING")) {
+        static DWORD last;
+        DWORD now = GetTickCount();
+        if (now - last >= 5000) {
+            last = now;
+            fprintf(stderr, "[dxbc-mem] hits=%llu misses=%llu live=%zu KiB\n",
+                    (unsigned long long)s_dxbc_mem_hits,
+                    (unsigned long long)s_dxbc_mem_misses, s_dxbc_mem_bytes / 1024);
+        }
+    }
+    ReleaseSRWLockExclusive(&s_dxbc_mem_lk);
+    return hit;
+}
+static void dxbc_mem_put(u64 h, ID3DBlob* blob)
+{
+    if (!blob || !dxbc_mem_on()) return;
+    size_t bytes = blob->lpVtbl->GetBufferSize(blob);
+    if (bytes > DXBC_MEM_BYTES) return;
+    unsigned i = dxbc_mem_index(h);
+    AcquireSRWLockExclusive(&s_dxbc_mem_lk);
+    if (s_dxbc_mem[i].blob) {
+        s_dxbc_mem_bytes -= s_dxbc_mem[i].bytes;
+        s_dxbc_mem[i].blob->lpVtbl->Release(s_dxbc_mem[i].blob);
+        s_dxbc_mem[i].blob = NULL;
+    }
+    while (s_dxbc_mem_bytes + bytes > DXBC_MEM_BYTES) {
+        unsigned ev = s_dxbc_mem_clock++ & (DXBC_MEM_SLOTS - 1);
+        if (!s_dxbc_mem[ev].blob) continue;
+        s_dxbc_mem_bytes -= s_dxbc_mem[ev].bytes;
+        s_dxbc_mem[ev].blob->lpVtbl->Release(s_dxbc_mem[ev].blob);
+        s_dxbc_mem[ev].blob = NULL;
+    }
+    blob->lpVtbl->AddRef(blob);
+    s_dxbc_mem[i].hash = h;
+    s_dxbc_mem[i].blob = blob;
+    s_dxbc_mem[i].bytes = bytes;
+    s_dxbc_mem_bytes += bytes;
+    ReleaseSRWLockExclusive(&s_dxbc_mem_lk);
+}
+static void dxbc_mem_clear(void)
+{
+    AcquireSRWLockExclusive(&s_dxbc_mem_lk);
+    for (unsigned i = 0; i < DXBC_MEM_SLOTS; i++) {
+        if (s_dxbc_mem[i].blob) s_dxbc_mem[i].blob->lpVtbl->Release(s_dxbc_mem[i].blob);
+        memset(&s_dxbc_mem[i], 0, sizeof s_dxbc_mem[i]);
+    }
+    s_dxbc_mem_bytes = 0;
+    s_dxbc_mem_clock = 0;
+    s_dxbc_mem_hits = s_dxbc_mem_misses = 0;
+    ReleaseSRWLockExclusive(&s_dxbc_mem_lk);
+}
+
+/* RSX_SHADER_PACK (on; =0 off): the race's shader bytecode in one file.
+ * Each first sighting of a pipeline needs its shaders' DXBC to form the
+ * pipeline key, and the cache keeps one file per shader -- 54,000 of them.
+ * Read cold, each took 4.9 ms (0.06 ms warm); a race start meets about
+ * 2,000, on the replay thread, and with a few hundred MB of RAM free nothing
+ * stays warm: "dxbc 1042 ms" in five seconds, frames 22-97 ms (Phase 103).
+ * While a race runs, every shader looked up is kept here with its bytecode;
+ * when the race ends the set is written to <cache>/race-shaders-v1.pack (on
+ * a thread of its own) and freed. The next race loading reads it back in one
+ * sequential read, and lookups check it before the per-file cache. The file
+ * keeps this race's shaders first and older ones up to RSX_SHADER_PACK_MB
+ * (default 64). The pack is derived local cache data, like shadercache/.
+ * Menus and dealerships have their own pack, menu-shaders-v1.pack, loaded at
+ * the first script of the run and again when a race ends (Phase 105): the
+ * same per-file reads made first visits to their pages stutter. */
+#define SPACK_SLOTS 16384
+static struct { u64 key; ID3DBlob* blob; int used; } s_spack[SPACK_SLOTS];
+static u32 s_spack_n, s_spack_new; static size_t s_spack_bytes; static u64 s_spack_hits;
+static volatile LONG s_spack_active;
+static int s_spack_scope;               /* 0 menus/dealerships, 1 race */
+static SRWLOCK s_spack_lk = SRWLOCK_INIT;
+static int spack_on(void) {
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_SHADER_PACK"); on = !(e && e[0] == '0'); }
+    return on;
+}
+static size_t spack_cap(void) {
+    static size_t cap;
+    if (!cap) { const char* e = getenv("RSX_SHADER_PACK_MB"); long mb = e ? atol(e) : 64;
+                cap = (size_t)(mb < 8 ? 8 : mb > 512 ? 512 : mb) << 20; }
+    return cap;
+}
+static int spack_path(char* p, size_t n, int scope) {
+    const char* dir = getenv("RSX_SHADER_CACHE"); if (!dir) dir = "shadercache";
+    if (dir[0] == '0' && !dir[1]) return 0;
+    return snprintf(p, n, "%s/%s-shaders-v1.pack", dir, scope ? "race" : "menu") > 0;
+}
+/* Under s_spack_lk: the slot holding `key`, or the empty slot that ends its probe. */
+static u32 spack_slot_locked(u64 key) {
+    u32 k = (u32)(key ^ (key >> 32)) & (SPACK_SLOTS - 1);
+    while (s_spack[k].blob && s_spack[k].key != key) k = (k + 1) & (SPACK_SLOTS - 1);
+    return k;
+}
+static int spack_get(u64 key, ID3DBlob** out) {
+    if (!s_spack_active) return 0;
+    AcquireSRWLockExclusive(&s_spack_lk);
+    u32 k = spack_slot_locked(key);
+    int hit = s_spack[k].blob != NULL;
+    if (hit) { *out = s_spack[k].blob; (*out)->lpVtbl->AddRef(*out); s_spack[k].used = 1; s_spack_hits++; }
+    ReleaseSRWLockExclusive(&s_spack_lk);
+    return hit;
+}
+/* Under s_spack_lk. Takes a reference. */
+static int spack_add_locked(u64 key, ID3DBlob* blob, int used) {
+    if (s_spack_n >= SPACK_SLOTS * 3 / 4) return 0;
+    u32 k = spack_slot_locked(key);
+    if (s_spack[k].blob) return 0;
+    blob->lpVtbl->AddRef(blob);
+    s_spack[k].key = key; s_spack[k].blob = blob; s_spack[k].used = used;
+    s_spack_n++; s_spack_bytes += blob->lpVtbl->GetBufferSize(blob);
+    return 1;
+}
+static void spack_record(u64 key, ID3DBlob* blob) {
+    if (!s_spack_active || !blob) return;
+    AcquireSRWLockExclusive(&s_spack_lk);
+    if (s_spack_active && spack_add_locked(key, blob, 1)) s_spack_new++;
+    ReleaseSRWLockExclusive(&s_spack_lk);
+}
+static const char s_spack_magic[8] = { 'G','T','5','P','S','P','K','1' };
+static void spack_end_ex(int sync);
+/* Read a scope's pack and start recording it (a guest thread: race loading,
+ * or a script load). A different scope still active is saved and freed first. */
+static void spack_begin(int scope) {
+    if (!spack_on()) return;
+    if (s_spack_active && s_spack_scope != scope) spack_end_ex(0);
+    char path[512]; if (!spack_path(path, sizeof path, scope)) return;
+    const ULONGLONG t0 = GetTickCount64();
+    u32 loaded = 0;
+    AcquireSRWLockExclusive(&s_spack_lk);
+    if (!s_spack_active) {
+        FILE* f = fopen(path, "rb");
+        u8* buf = NULL; long n = 0;
+        if (f) {
+            fseek(f, 0, SEEK_END); n = ftell(f); fseek(f, 0, SEEK_SET);
+            if (n > 12 && (size_t)n <= spack_cap() + (size_t)SPACK_SLOTS * 12u + 12u) buf = (u8*)malloc((size_t)n);
+            if (buf && fread(buf, 1, (size_t)n, f) != (size_t)n) { free(buf); buf = NULL; }
+            fclose(f);
+        }
+        if (buf && !memcmp(buf, s_spack_magic, 8)) {
+            u32 count; memcpy(&count, buf + 8, 4);
+            size_t off = 12;
+            for (u32 i = 0; i < count && off + 12 <= (size_t)n; i++) {
+                u64 key; u32 bytes; memcpy(&key, buf + off, 8); memcpy(&bytes, buf + off + 8, 4); off += 12;
+                if (!bytes || bytes > (size_t)n - off) break;
+                ID3DBlob* b = NULL;
+                if (SUCCEEDED(D3DCreateBlob(bytes, &b))) {
+                    memcpy(b->lpVtbl->GetBufferPointer(b), buf + off, bytes);
+                    loaded += (u32)spack_add_locked(key, b, 0);
+                    b->lpVtbl->Release(b);
+                }
+                off += bytes;
+            }
+        }
+        free(buf);
+        s_spack_new = 0; s_spack_hits = 0; s_spack_scope = scope;
+        InterlockedExchange(&s_spack_active, 1);
+    }
+    ReleaseSRWLockExclusive(&s_spack_lk);
+    fprintf(stderr, "[shader-pack] %s set: %u shaders, %.1f MiB, read in %llu ms%c", scope ? "race" : "menu",
+            loaded, s_spack_bytes / 1048576.0, (unsigned long long)(GetTickCount64() - t0), 10);
+}
+static void spack_race_begin(void) { spack_begin(1); }
+typedef struct { char path[512]; u32 n; struct { u64 key; ID3DBlob* blob; int used; } e[1]; } SpackSnap;
+static DWORD WINAPI spack_write_thread(LPVOID p) {
+    SpackSnap* s = (SpackSnap*)p;
+    char path[512], tmp[540];
+    static SRWLOCK wlk = SRWLOCK_INIT;   /* a checkpoint and the race's end may overlap */
+    AcquireSRWLockExclusive(&wlk);
+    if (s->path[0]) {
+        snprintf(path, sizeof path, "%s", s->path);
+        snprintf(tmp, sizeof tmp, "%s.tmp", path);
+        FILE* f = fopen(tmp, "wb");
+        if (f) {
+            u32 count = 0; size_t bytes = 0; const size_t cap = spack_cap();
+            fwrite(s_spack_magic, 1, 8, f); fwrite(&count, 4, 1, f);
+            for (int pass = 1; pass >= 0; pass--)          /* this race's shaders first */
+                for (u32 i = 0; i < s->n; i++) {
+                    if (s->e[i].used != pass) continue;
+                    u32 sz = (u32)s->e[i].blob->lpVtbl->GetBufferSize(s->e[i].blob);
+                    if (bytes + sz > cap) continue;
+                    fwrite(&s->e[i].key, 8, 1, f); fwrite(&sz, 4, 1, f);
+                    fwrite(s->e[i].blob->lpVtbl->GetBufferPointer(s->e[i].blob), 1, sz, f);
+                    bytes += sz; count++;
+                }
+            fseek(f, 8, SEEK_SET); fwrite(&count, 4, 1, f);
+            int ok = !ferror(f); fclose(f);
+            if (ok && MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING))
+                fprintf(stderr, "[shader-pack] saved %u shaders (%.1f MiB) to %s%c", count, bytes / 1048576.0, path, 10);
+            else DeleteFileA(tmp);
+        }
+    }
+    ReleaseSRWLockExclusive(&wlk);
+    for (u32 i = 0; i < s->n; i++) s->e[i].blob->lpVtbl->Release(s->e[i].blob);
+    free(s);
+    return 0;
+}
+/* Leaving a scope: stop recording, save if anything was added, free the set.
+ * At shutdown (sync) the file is written before returning. */
+static void spack_end_ex(int sync) {
+    if (!InterlockedExchange(&s_spack_active, 0)) return;
+    AcquireSRWLockExclusive(&s_spack_lk);
+    SpackSnap* s = (SpackSnap*)malloc(sizeof(SpackSnap) + (size_t)s_spack_n * sizeof s->e[0]);
+    const int save = s_spack_new > 0 && s && spack_path(s->path, sizeof s->path, s_spack_scope);
+    fprintf(stderr, "[shader-pack] %s set ended: %llu pack hits, %u new shaders%s%c", s_spack_scope ? "race" : "menu",
+            (unsigned long long)s_spack_hits, s_spack_new, save ? "; saving" : "", 10);
+    if (s) s->n = 0;
+    for (u32 k = 0; k < SPACK_SLOTS; k++) {
+        if (!s_spack[k].blob) continue;
+        if (save) { s->e[s->n].key = s_spack[k].key; s->e[s->n].blob = s_spack[k].blob; s->e[s->n].used = s_spack[k].used; s->n++; }
+        else s_spack[k].blob->lpVtbl->Release(s_spack[k].blob);
+        memset(&s_spack[k], 0, sizeof s_spack[k]);
+    }
+    s_spack_n = 0; s_spack_bytes = 0; s_spack_new = 0;
+    ReleaseSRWLockExclusive(&s_spack_lk);
+    if (!save) { free(s); return; }
+    HANDLE t = sync ? NULL : CreateThread(NULL, 0, spack_write_thread, s, 0, NULL);
+    if (t) CloseHandle(t); else spack_write_thread(s);
+}
+static void spack_race_end_ex(int sync) { spack_end_ex(sync); }
+/* A race ended: save it, then the menu set for the pages that follow. */
+static void spack_race_end(void) { spack_end_ex(0); spack_begin(0); }
+static void spack_debug(FILE* out) {
+    fprintf(out, "Shader pack: enabled=%d scope=%s active=%ld shaders=%u size=%.1f MiB hits=%llu new=%u\n",
+            spack_on(), s_spack_scope ? "race" : "menu", s_spack_active, s_spack_n, s_spack_bytes / 1048576.0,
+            (unsigned long long)s_spack_hits, s_spack_new);
+}
+/* Every few seconds from the replay thread: once a scope has gone 10 s
+ * without a new shader, save what it has learned and keep the set loaded,
+ * so a crash or a killed process does not lose it. */
+static volatile LONG64 s_spack_last_new_ms;
+static void spack_checkpoint(void) {
+    if (!s_spack_active || !s_spack_new) return;
+    static u32 seen_new;
+    const ULONGLONG now = GetTickCount64();
+    if (s_spack_new != seen_new) { seen_new = s_spack_new; s_spack_last_new_ms = (LONG64)now; return; }
+    if (now - (ULONGLONG)s_spack_last_new_ms < 10000) return;
+    AcquireSRWLockExclusive(&s_spack_lk);
+    SpackSnap* s = s_spack_active ? (SpackSnap*)malloc(sizeof(SpackSnap) + (size_t)s_spack_n * sizeof s->e[0]) : NULL;
+    if (s && !spack_path(s->path, sizeof s->path, s_spack_scope)) { free(s); s = NULL; }
+    if (s) {
+        s->n = 0;
+        for (u32 k = 0; k < SPACK_SLOTS; k++) if (s_spack[k].blob) {
+            s_spack[k].blob->lpVtbl->AddRef(s_spack[k].blob);
+            s->e[s->n].key = s_spack[k].key; s->e[s->n].blob = s_spack[k].blob; s->e[s->n].used = s_spack[k].used; s->n++;
+        }
+        s_spack_new = 0; seen_new = 0;
+    }
+    ReleaseSRWLockExclusive(&s_spack_lk);
+    if (!s) return;
+    HANDLE t = CreateThread(NULL, 0, spack_write_thread, s, 0, NULL);
+    if (t) CloseHandle(t); else spack_write_thread(s);
+}
+
+static HRESULT d3d_compile_cached_file(const char* src, size_t len, const char* name,
+                                       const char* target, UINT flags,
+                                       ID3DBlob** out, ID3DBlob** err, u64 h);
+static HRESULT d3d_compile_cached(const char* src, size_t len, const char* name,
+                                  const char* target, UINT flags,
+                                  ID3DBlob** out, ID3DBlob** err)
+{
+    u64 h = shader_source_key(src, len, target, flags);
+    if (spack_get(h, out)) { if (err) *err = NULL; return S_OK; }
+    HRESULT hr = d3d_compile_cached_file(src, len, name, target, flags, out, err, h);
+    if (SUCCEEDED(hr) && *out) spack_record(h, *out);
+    return hr;
+}
+static HRESULT d3d_compile_cached_file(const char* src, size_t len, const char* name,
+                                       const char* target, UINT flags,
+                                       ID3DBlob** out, ID3DBlob** err, u64 h)
+{
+    if (dxbc_mem_get(h, out)) { if (err) *err = NULL; return S_OK; }
+    static const char* dir = (const char*)1;
+    if (dir == (const char*)1) {
+        dir = getenv("RSX_SHADER_CACHE");
+        if (!dir) dir = "shadercache";
+        if (dir[0] == '0' && !dir[1]) dir = NULL;
+        if (dir) CreateDirectoryA(dir, NULL);
+    }
+    char path[512] = {0};
+    if (dir) {
+        snprintf(path, sizeof path, "%s/%016llx.dxbc", dir, (unsigned long long)h);
+        FILE* f = fopen(path, "rb");
+        if (f) {
+            fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+            if (n > 0 && SUCCEEDED(D3DCreateBlob((SIZE_T)n, out)) &&
+                fread((*out)->lpVtbl->GetBufferPointer(*out), 1, (size_t)n, f) == (size_t)n) {
+                fclose(f);
+                if (err) *err = NULL;
+                dxbc_mem_put(h, *out);
+                return S_OK;
+            }
+            if (*out) { (*out)->lpVtbl->Release(*out); *out = NULL; }
+            fclose(f);
+        }
+    }
+    InterlockedIncrement(&g_rsx_shader_busy);
+    HRESULT hr = D3DCompile(src, len, name, NULL, NULL, "main", target, flags, 0, out, err);
+    InterlockedIncrement(&g_rsx_shaders_compiled);
+    InterlockedDecrement(&g_rsx_shader_busy);
+    if (SUCCEEDED(hr) && *out && path[0]) {
+        char tmp[520]; snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+        FILE* f = fopen(tmp, "wb");
+        if (f) {
+            size_t n = (*out)->lpVtbl->GetBufferSize(*out);
+            int ok = fwrite((*out)->lpVtbl->GetBufferPointer(*out), 1, n, f) == n;
+            fclose(f);
+            if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileA(tmp);
+        }
+    }
+    if (SUCCEEDED(hr) && *out) dxbc_mem_put(h, *out);
+    return hr;
+}
+
+/* Background shader compiles (RSX_SHADER_ASYNC=1; GT5P's "Precompile
+ * shaders" setting). A shader the disk cache does not have was compiled on
+ * the thread that replays frames, one at a time: GT5 Prologue's first visit
+ * to a page with an empty cache compiled 161 of them, 0.1-0.5 s each, and the
+ * page did not appear for over a minute (Phase 65). Now the frame's
+ * pre-pass, which looks every draw's pipeline up before recording, hands each
+ * missing shader to a pool of worker threads and moves on; the draw is left
+ * out until its shader is on disk, and the frame is presented meanwhile. A
+ * worker writes the DXBC where d3d_compile_cached reads it, so finishing is
+ * just the file appearing. A shader that fails to compile in a worker is
+ * compiled again on the frame thread, which reports the error as before.
+ * Needs the disk cache (RSX_SHADER_CACHE not "0"). RSX_SHADER_WORKERS=<n>
+ * sets the pool (default: half the logical CPUs, at least 2). */
+volatile LONG g_rsx_shaders_pending;    /* queued or compiling in the pool */
+typedef struct ShcJob { struct ShcJob* next; u64 h; char* src; size_t len; char target[16]; UINT flags; char path[512]; } ShcJob;
+static SRWLOCK s_shc_lk = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_shc_cv = CONDITION_VARIABLE_INIT;
+static ShcJob* s_shc_head; static ShcJob* s_shc_tail;
+enum { SHC_TAB = 131072 };
+static u64 s_shc_key[SHC_TAB];        /* shader hash, 0 = empty */
+static u8  s_shc_st[SHC_TAB];         /* 1 queued/compiling, 2 failed, 3 done */
+/* Large offline catalogs exceed the old 16K job table. Keep its memory bounded
+ * and configurable; a full table deliberately falls back to serial compiling. */
+static u32 shc_capacity(void)
+{
+    static u32 capacity;
+    if (!capacity) {
+        const char* e = getenv("RSX_SHADER_JOB_SLOTS");
+        int requested = e ? atoi(e) : 65536;
+        if (requested < 1024) requested = 1024;
+        if (requested > SHC_TAB) requested = SHC_TAB;
+        capacity = 1024;
+        while (capacity * 2 <= (u32)requested) capacity *= 2;
+    }
+    return capacity;
+}
+static int shc_async_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_SHADER_ASYNC"); on = (e && *e == '1') ? 1 : 0; }
+    return on;
+}
+static u8* shc_slot(u64 h, int insert)    /* under s_shc_lk */
+{
+    if (!h) h = 1;
+    u32 capacity = shc_capacity();
+    for (u32 i = (u32)(h ^ (h >> 29)) & (capacity - 1), n = 0; n < capacity; n++, i = (i + 1) & (capacity - 1)) {
+        if (s_shc_key[i] == h) return &s_shc_st[i];
+        if (!s_shc_key[i]) {
+            if (!insert) return NULL;
+            s_shc_key[i] = h; s_shc_st[i] = 0;
+            return &s_shc_st[i];
+        }
+    }
+    return NULL;
+}
+static DWORD WINAPI shc_worker(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    ps3_name_thread(L"shader-compile");
+    for (;;) {
+        AcquireSRWLockExclusive(&s_shc_lk);
+        while (!s_shc_head) SleepConditionVariableSRW(&s_shc_cv, &s_shc_lk, INFINITE, 0);
+        ShcJob* j = s_shc_head; s_shc_head = j->next; if (!s_shc_head) s_shc_tail = NULL;
+        ReleaseSRWLockExclusive(&s_shc_lk);
+        ID3DBlob* out = NULL; ID3DBlob* err = NULL;
+        InterlockedIncrement(&g_rsx_shader_busy);
+        HRESULT hr = D3DCompile(j->src, j->len, "guest_async", NULL, NULL, "main", j->target, j->flags, 0, &out, &err);
+        InterlockedIncrement(&g_rsx_shaders_compiled);
+        InterlockedDecrement(&g_rsx_shader_busy);
+        int ok = 0;
+        if (FAILED(hr)) {
+            static LONG errors;
+            const char* quiet = getenv("RSX_SHADER_ERRORS");
+            if ((!quiet || strcmp(quiet, "0")) && InterlockedIncrement(&errors) <= 16)
+                fprintf(stderr, "[shader-async] compile failed hash=%016llx: %.2048s\n",
+                        (unsigned long long)j->h, err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "no compiler diagnostic");
+        }
+        if (SUCCEEDED(hr) && out) {
+            char tmp[540]; snprintf(tmp, sizeof tmp, "%s.%lu.tmp", j->path, (unsigned long)GetCurrentThreadId());
+            FILE* f = fopen(tmp, "wb");
+            if (f) {
+                size_t n = out->lpVtbl->GetBufferSize(out);
+                ok = fwrite(out->lpVtbl->GetBufferPointer(out), 1, n, f) == n;
+                fclose(f);
+                if (!ok || !MoveFileExA(tmp, j->path, MOVEFILE_REPLACE_EXISTING)) { DeleteFileA(tmp); ok = 0; }
+            }
+        }
+        if (out) out->lpVtbl->Release(out);
+        if (err) err->lpVtbl->Release(err);
+        AcquireSRWLockExclusive(&s_shc_lk);
+        { u8* st = shc_slot(j->h, 1); if (st) *st = ok ? 3 : 2; }
+        ReleaseSRWLockExclusive(&s_shc_lk);
+        InterlockedDecrement(&g_rsx_shaders_pending);
+        free(j->src); free(j);
+    }
+    return 0;
+}
+/* d3d_compile_cached, but a shader not on disk is queued for the pool and
+ * E_PENDING returned. Falls back to d3d_compile_cached when async is off,
+ * the cache is off, or the pool already failed this shader. */
+static HRESULT d3d_compile_async_h(const char* src, size_t len, const char* name,
+                                   const char* target, UINT flags, ID3DBlob** out, ID3DBlob** err,
+                                   u64* hout);
+static HRESULT d3d_compile_async(const char* src, size_t len, const char* name,
+                                 const char* target, UINT flags, ID3DBlob** out, ID3DBlob** err)
+{
+    return d3d_compile_async_h(src, len, name, target, flags, out, err, NULL);
+}
+/* Whether the pool still has shader h queued or compiling. */
+static int shc_pending(u64 h)
+{
+    AcquireSRWLockExclusive(&s_shc_lk);
+    u8* st = shc_slot(h, 0);
+    const int p = st && *st == 1;
+    ReleaseSRWLockExclusive(&s_shc_lk);
+    return p;
+}
+static HRESULT d3d_compile_async_h(const char* src, size_t len, const char* name,
+                                   const char* target, UINT flags, ID3DBlob** out, ID3DBlob** err,
+                                   u64* hout)
+{
+    const char* dir = getenv("RSX_SHADER_CACHE");
+    if (!dir) dir = "shadercache";
+    if (!shc_async_on() || (dir[0] == '0' && !dir[1]))
+        return d3d_compile_cached(src, len, name, target, flags, out, err);
+    u64 h = shader_source_key(src, len, target, flags);
+    if (hout) *hout = h;
+    AcquireSRWLockExclusive(&s_shc_lk);
+    u8* st = shc_slot(h, 0);
+    const u8 state = st ? *st : 0;
+    ReleaseSRWLockExclusive(&s_shc_lk);
+    if (state == 1) return E_PENDING;
+    if (state >= 2)            /* on disk now, or failed: the synchronous path either way */
+        return d3d_compile_cached(src, len, name, target, flags, out, err);
+    char path[512];
+    snprintf(path, sizeof path, "%s/%016llx.dxbc", dir, (unsigned long long)h);
+    if (GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES)
+        return d3d_compile_cached(src, len, name, target, flags, out, err);
+    /* Not on disk: queue it, once. */
+    static LONG started = 0;
+    if (InterlockedCompareExchange(&started, 1, 0) == 0) {
+        CreateDirectoryA(dir, NULL);
+        const char* e = getenv("RSX_SHADER_WORKERS");
+        int n = e ? atoi(e) : (int)GetActiveProcessorCount(ALL_PROCESSOR_GROUPS) / 2;
+        if (n < 2) n = 2; if (n > 32) n = 32;
+        for (int i = 0; i < n; i++) { HANDLE t = CreateThread(NULL, 0, shc_worker, NULL, 0, NULL); if (t) CloseHandle(t); }
+        fprintf(stderr, "[shader-async] %d compile workers%c", n, 10);
+    }
+    ShcJob* j = (ShcJob*)calloc(1, sizeof *j);
+    char* copy = j ? (char*)malloc(len) : NULL;
+    if (!j || !copy) { free(j); return d3d_compile_cached(src, len, name, target, flags, out, err); }
+    memcpy(copy, src, len);
+    j->h = h; j->src = copy; j->len = len; j->flags = flags;
+    snprintf(j->target, sizeof j->target, "%s", target);
+    memcpy(j->path, path, sizeof path);
+    AcquireSRWLockExclusive(&s_shc_lk);
+    st = shc_slot(h, 1);
+    if (st && *st == 0) {
+        *st = 1;
+        if (s_shc_tail) s_shc_tail->next = j; else s_shc_head = j;
+        s_shc_tail = j;
+        InterlockedIncrement(&g_rsx_shaders_pending);
+        WakeConditionVariable(&s_shc_cv);
+        j = NULL;
+    }
+    ReleaseSRWLockExclusive(&s_shc_lk);
+    if (j) { free(j->src); free(j); }   /* someone queued it first, or the table is full */
+    if (!st) return d3d_compile_cached(src, len, name, target, flags, out, err);
+    (void)err; (void)out;
+    return E_PENDING;
+}
+
+static u64 pso_hash_bytes(u64 h, const void* bytes, size_t size)
+{
+    const u8* p = (const u8*)bytes;
+    for (size_t i = 0; i < size; i++) { h ^= p[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+/* Cached driver blobs still require a driver call and can stall. Include both
+ * paths in exports; the old busy counter covered only uncached construction.
+ * RSX_PSO_HITCH_MS=0 disables bounded slow-call logging (default threshold 50). */
+static HRESULT create_guest_pso_driver(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                                       ID3D12PipelineState** out)
+{
+    LARGE_INTEGER begin, end, frequency;
+    QueryPerformanceCounter(&begin);
+    InterlockedIncrement(&g_rsx_shader_busy);
+    HRESULT hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+        s_d3d.device, pd, &IID_ID3D12PipelineState, (void**)out);
+    InterlockedDecrement(&g_rsx_shader_busy);
+    InterlockedIncrement(&g_rsx_pipelines_built);
+    QueryPerformanceCounter(&end); QueryPerformanceFrequency(&frequency);
+    LONG64 us = (LONG64)((double)(end.QuadPart - begin.QuadPart) * 1000000.0 / frequency.QuadPart);
+    InterlockedIncrement64(&s_driver_pso_calls);
+    if (pd->CachedPSO.CachedBlobSizeInBytes) InterlockedIncrement64(&s_driver_pso_cached);
+    InterlockedAdd64(&s_driver_pso_us, us);
+    LONG64 previous = InterlockedCompareExchange64(&s_driver_pso_max_us, 0, 0);
+    while (us > previous) {
+        LONG64 found = InterlockedCompareExchange64(&s_driver_pso_max_us, us, previous);
+        if (found == previous) break;
+        previous = found;
+    }
+    static int threshold = -1; static unsigned logged;
+    if (threshold < 0) { const char* e = getenv("RSX_PSO_HITCH_MS"); threshold = e ? atoi(e) : 50; }
+    if (threshold > 0 && us >= (LONG64)threshold * 1000 && logged++ < 64)
+        fprintf(stderr, "[pso-hitch] frame=%llu driver_ms=%.3f cached_blob=%d result=%08lX hosttid=%lu\n",
+                (unsigned long long)s_d3d.frame_count, (double)us / 1000.0,
+                pd->CachedPSO.CachedBlobSizeInBytes != 0, (unsigned long)hr, (unsigned long)GetCurrentThreadId());
+    return hr;
+}
+static HRESULT create_guest_pso_uncached(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                                         ID3D12PipelineState** out)
+{
+    return create_guest_pso_driver(pd, out);
+}
+
+/* DXBC is portable shader bytecode; the driver still compiles a native PSO.
+ * Keep that result locally as well. Blobs are machine/driver specific: any
+ * rejection retries the full descriptor and replaces the stale cache entry.
+ * RSX_PSO_DISK=0 disables this; RSX_SHADER_CACHE=0 disables both disk caches. */
+static u64 guest_pso_hash_ex(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, int with_rs)
+{
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC key = *pd;
+    key.pRootSignature = NULL;
+    key.VS.pShaderBytecode = key.PS.pShaderBytecode = NULL;
+    key.InputLayout.pInputElementDescs = NULL;
+    key.CachedPSO.pCachedBlob = NULL; key.CachedPSO.CachedBlobSizeInBytes = 0;
+    u64 hash = pso_hash_bytes(1469598103934665603ull, "gt5p-pso-v1", 11);
+    hash = pso_hash_bytes(hash, &key, sizeof key);
+    /* RSX_PSO_KEY_RS=0: leave the root signature out (the old key). */
+    { static int rs = -1; if (rs < 0) { const char* e = getenv("RSX_PSO_KEY_RS"); rs = !(e && e[0] == '0'); }
+      if (rs && with_rs) {
+          u64 rh = pd->pRootSignature == s_d3d.vp_root_sig ? s_vp_rs_hash :
+                   pd->pRootSignature == s_d3d.root_signature ? s_rs_hash : 0;
+          hash = pso_hash_bytes(hash, "rs", 2);
+          hash = pso_hash_bytes(hash, &rh, sizeof rh);
+      } }
+    hash = pso_hash_bytes(hash, pd->VS.pShaderBytecode, pd->VS.BytecodeLength);
+    hash = pso_hash_bytes(hash, pd->PS.pShaderBytecode, pd->PS.BytecodeLength);
+    for (UINT i = 0; i < pd->InputLayout.NumElements; i++) {
+        D3D12_INPUT_ELEMENT_DESC il = pd->InputLayout.pInputElementDescs[i];
+        const char* name = il.SemanticName; il.SemanticName = NULL;
+        hash = pso_hash_bytes(hash, &il, sizeof il);
+        hash = pso_hash_bytes(hash, name, strlen(name) + 1);
+    }
+    return hash;
+}
+static u64 guest_pso_hash(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd) { return guest_pso_hash_ex(pd, 1); }
+/* A recipe recorded before the root signature joined the key still describes
+ * a valid pipeline; only its hash predates the change (Phase 113). */
+static int guest_pso_recipe_hash_ok(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, u64 h)
+{ return guest_pso_hash_ex(pd, 1) == h || guest_pso_hash_ex(pd, 0) == h; }
+
+
+/* Startup warmup recipes contain local derived bytecode and state, never guest
+ * pointers. Existing native PSO blobs alone cannot reconstruct a descriptor.
+ * Record recipes as pipelines are seen; RSX_PSO_RECIPES=0 disables recording.
+ * RSX_SHADER_WARMUP=1 prepares known recipes; normally on the background worker.
+ * The resident cap was 4096 until Phase 105; the learned menu and race sets
+ * outgrew it together (1567 + 4028), so race preparation turned 1207-1342 race
+ * recipes away. A resident pipeline's driver memory is GPU-side and its
+ * page-file backing is never resident (Phase 104). RSX_PSO_RESIDENT_MAX lowers it. */
+#define PSO_WARM_MAX 8192
+#define PSO_WARM_INPUTS 32
+#define PSO_WARM_CODE_MAX (4u * 1024u * 1024u)
+typedef struct { D3D12_INPUT_ELEMENT_DESC desc; char name[32]; } PsoWarmInput;
+typedef struct {
+    u64 magic; u32 version, size;
+    u64 hash, vs_hash, ps_hash;
+    u32 vs_bytes, ps_bytes;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC desc;
+    PsoWarmInput input[PSO_WARM_INPUTS];
+    u64 checksum;
+} PsoWarmRecipe;
+static struct { u64 hash; ID3D12PipelineState* pso; } s_pso_warm[PSO_WARM_MAX * 2];
+static u32 s_pso_warm_n, s_pso_warm_loaded, s_pso_warm_rejected, s_pso_warm_learned;
+static u64 s_pso_warm_hits;
+static SRWLOCK s_pso_warm_lock = SRWLOCK_INIT;
+static int pso_async_on(void);
+static void pso_queue_debug(FILE* out);
+static int pso_warm_on(void) {
+    const char* e = getenv("RSX_SHADER_WARMUP"); return (e && !strcmp(e, "1")) || pso_async_on();
+}
+static int pso_warm_dir(char* path, size_t n) {
+    const char* e = getenv("RSX_PSO_RECIPES");
+    const char* dir = getenv("RSX_SHADER_CACHE"); if (!dir) dir = "shadercache";
+    if ((e && !strcmp(e, "0")) || !strcmp(dir, "0")) return 0;
+    return snprintf(path, n, "%s/warmup-v1", dir) > 0 && strlen(dir) + 12 < n;
+}
+static int pso_warm_get(u64 hash, ID3D12PipelineState** out) {
+    if (!pso_warm_on()) return 0;
+    int found = 0;
+    AcquireSRWLockExclusive(&s_pso_warm_lock);
+    for (u32 k = (u32)hash & (PSO_WARM_MAX * 2 - 1), i = 0; i < PSO_WARM_MAX * 2; i++, k = (k + 1) & (PSO_WARM_MAX * 2 - 1)) {
+        if (!s_pso_warm[k].pso) break;
+        if (s_pso_warm[k].hash == hash) {
+            *out = s_pso_warm[k].pso; (*out)->lpVtbl->AddRef(*out); s_pso_warm_hits++;
+            found = 1; break;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_pso_warm_lock);
+    return found;
+}
+/* Prepared pipelines held for the whole run, on top of the renderer's own
+ * cache. RSX_PSO_RESIDENT_MAX lowers the cap (64..4096) to save memory. */
+static u32 pso_resident_max(void) {
+    static u32 cap;
+    if (!cap) {
+        const char* e = getenv("RSX_PSO_RESIDENT_MAX");
+        long v = e ? atol(e) : PSO_WARM_MAX;
+        cap = (u32)(v < 64 ? 64 : v > PSO_WARM_MAX ? PSO_WARM_MAX : v);
+    }
+    return cap;
+}
+static void pso_warm_put(u64 hash, ID3D12PipelineState* pso) {
+    if (!pso_warm_on()) return;
+    AcquireSRWLockExclusive(&s_pso_warm_lock);
+    if (s_pso_warm_n < pso_resident_max())
+    for (u32 k = (u32)hash & (PSO_WARM_MAX * 2 - 1), i = 0; i < PSO_WARM_MAX * 2; i++, k = (k + 1) & (PSO_WARM_MAX * 2 - 1)) {
+        if (s_pso_warm[k].pso) { if (s_pso_warm[k].hash == hash) break; continue; }
+        pso->lpVtbl->AddRef(pso); s_pso_warm[k].hash = hash; s_pso_warm[k].pso = pso; s_pso_warm_n++; break;
+    }
+    ReleaseSRWLockExclusive(&s_pso_warm_lock);
+}
+/* RSX_PSO_RACE_EVICT=1 (off by default): when race loading begins, release
+ * the resident pipelines that are not in the learned race set, so the whole
+ * set fits. Startup prepares the menu set first and the race set after it;
+ * the two outgrew the cap together (1449 + 3922 against 4096), and 1207 race
+ * recipes were turned away and built on the worker during the race. Making
+ * room worked (4020 ready, 0 rejected) but the extra recipes cost 12.6 s of
+ * loading in cold file reads, and the race's stalls were the replay thread's
+ * shader reads, not these pipelines (Phase 103; see RSX_SHADER_PACK). Only this table's
+ * references are dropped: a pipeline the renderer still uses keeps its own,
+ * and dropped ones rebuild from the driver's blob cache if needed again.
+ * The table is linear-probed, so survivors are reinserted, not punched out. */
+static int u64_cmp(const void* a, const void* b) {
+    const u64 x = *(const u64*)a, y = *(const u64*)b; return x < y ? -1 : x > y;
+}
+static u32 pso_warm_keep_only(const char* index) {
+    const char* e = getenv("RSX_PSO_RACE_EVICT");
+    if (!(e && e[0] == '1') || !pso_warm_on()) return 0;
+    FILE* f = fopen(index, "r");
+    if (!f) return 0;
+    u32 n = 0, cap = 4096; u64* keep = (u64*)malloc(cap * sizeof(u64)); char line[64];
+    while (keep && fgets(line, sizeof line, f)) {
+        unsigned long long h;
+        if (sscanf(line, "%llx", &h) != 1 || !h) continue;
+        if (n == cap) { u64* k2 = (u64*)realloc(keep, (cap *= 2) * sizeof(u64)); if (!k2) break; keep = k2; }
+        keep[n++] = (u64)h;
+    }
+    fclose(f);
+    if (!keep || !n) { free(keep); return 0; }
+    qsort(keep, n, sizeof(u64), u64_cmp);
+    static struct { u64 hash; ID3D12PipelineState* pso; } kept[PSO_WARM_MAX];
+    static ID3D12PipelineState* drop[PSO_WARM_MAX]; u32 nk = 0, nd = 0;   /* worker thread only */
+    AcquireSRWLockExclusive(&s_pso_warm_lock);
+    for (u32 k = 0; k < PSO_WARM_MAX * 2; k++) {
+        if (!s_pso_warm[k].pso) continue;
+        if (bsearch(&s_pso_warm[k].hash, keep, n, sizeof(u64), u64_cmp) && nk < PSO_WARM_MAX) {
+            kept[nk].hash = s_pso_warm[k].hash; kept[nk].pso = s_pso_warm[k].pso; nk++;
+        } else if (nd < PSO_WARM_MAX) drop[nd++] = s_pso_warm[k].pso;
+        s_pso_warm[k].pso = NULL; s_pso_warm[k].hash = 0;
+    }
+    for (u32 i = 0; i < nk; i++)
+        for (u32 k = (u32)kept[i].hash & (PSO_WARM_MAX * 2 - 1);; k = (k + 1) & (PSO_WARM_MAX * 2 - 1))
+            if (!s_pso_warm[k].pso) { s_pso_warm[k].hash = kept[i].hash; s_pso_warm[k].pso = kept[i].pso; break; }
+    s_pso_warm_n = nk;
+    ReleaseSRWLockExclusive(&s_pso_warm_lock);
+    for (u32 i = 0; i < nd; i++) drop[i]->lpVtbl->Release(drop[i]);
+    free(keep);
+    fprintf(stderr, "[race-prewarm] released %u resident pipelines outside the race set; %u kept%c", nd, nk, 10);
+    return nd;
+}
+static void pso_warm_debug(FILE* out) {
+    fprintf(out, "Shader warmup: enabled=%d loaded=%u rejected=%u memory_hits=%llu learned=%u resident=%u/%u\n",
+            pso_warm_on(), s_pso_warm_loaded, s_pso_warm_rejected, (unsigned long long)s_pso_warm_hits, s_pso_warm_learned,
+            s_pso_warm_n, pso_resident_max());
+}
+static void pso_warm_clear(void) {
+    AcquireSRWLockExclusive(&s_pso_warm_lock);
+    for (u32 k = 0; k < PSO_WARM_MAX * 2; k++) {
+        if (s_pso_warm[k].pso) s_pso_warm[k].pso->lpVtbl->Release(s_pso_warm[k].pso);
+        s_pso_warm[k].pso = NULL;
+    }
+    s_pso_warm_n = 0;
+    ReleaseSRWLockExclusive(&s_pso_warm_lock);
+}
+static int pso_warm_write(const char* path, const void* data, size_t bytes) {
+    char tmp[640]; if (snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, GetCurrentThreadId()) >= (int)sizeof tmp) return 0;
+    FILE* f = fopen(tmp, "wb"); if (!f) return 0;
+    int ok = fwrite(data, 1, bytes, f) == bytes; if (fclose(f)) ok = 0;
+    if (ok && MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) return 1;
+    DeleteFileA(tmp); return 0;
+}
+/* Mark a recipe file as used now: pruning keeps what was used recently. */
+static void pso_touch_file(const char* path) {
+    HANDLE h = CreateFileA(path, FILE_WRITE_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) return;
+    FILETIME now; GetSystemTimeAsFileTime(&now);
+    SetFileTime(h, NULL, NULL, &now);
+    CloseHandle(h);
+}
+static int pso_warm_code(const char* dir, u64 hash, const void* data, size_t bytes) {
+    char path[640]; snprintf(path, sizeof path, "%s/code_%016llx.dxbc", dir, (unsigned long long)hash);
+    WIN32_FILE_ATTRIBUTE_DATA a;
+    if (GetFileAttributesExA(path, GetFileExInfoStandard, &a) && !a.nFileSizeHigh && a.nFileSizeLow == bytes) {
+        pso_touch_file(path);   /* shared by a new recipe: keep it as long as that */
+        return 1;
+    }
+    return pso_warm_write(path, data, bytes);
+}
+static void pso_warm_record(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, u64 hash) {
+    char dir[512], path[640]; if (!pso_warm_dir(dir, sizeof dir)) return;
+    if (pd->pRootSignature != s_d3d.vp_root_sig || pd->InputLayout.NumElements > PSO_WARM_INPUTS ||
+        pd->StreamOutput.NumEntries || pd->StreamOutput.NumStrides || pd->GS.BytecodeLength || pd->HS.BytecodeLength || pd->DS.BytecodeLength ||
+        !pd->VS.BytecodeLength || !pd->PS.BytecodeLength || pd->VS.BytecodeLength > PSO_WARM_CODE_MAX || pd->PS.BytecodeLength > PSO_WARM_CODE_MAX) return;
+    snprintf(path, sizeof path, "%s/pso_%016llx.recipe", dir, (unsigned long long)hash);
+    if (GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES) return;
+    PsoWarmRecipe r = {0};
+    r.magic = 0x31574D5241503547ull; r.version = 1; r.size = sizeof r; r.hash = hash;
+    r.vs_bytes = (u32)pd->VS.BytecodeLength; r.ps_bytes = (u32)pd->PS.BytecodeLength;
+    r.vs_hash = pso_hash_bytes(1469598103934665603ull, pd->VS.pShaderBytecode, r.vs_bytes);
+    r.ps_hash = pso_hash_bytes(1469598103934665603ull, pd->PS.pShaderBytecode, r.ps_bytes);
+    r.desc = *pd; r.desc.pRootSignature = NULL;
+    r.desc.VS.pShaderBytecode = r.desc.PS.pShaderBytecode = NULL;
+    r.desc.GS.pShaderBytecode = r.desc.HS.pShaderBytecode = r.desc.DS.pShaderBytecode = NULL;
+    memset(&r.desc.StreamOutput, 0, sizeof r.desc.StreamOutput);
+    memset(&r.desc.CachedPSO, 0, sizeof r.desc.CachedPSO);
+    r.desc.InputLayout.pInputElementDescs = NULL;
+    for (u32 i = 0; i < pd->InputLayout.NumElements; i++) {
+        const char* name = pd->InputLayout.pInputElementDescs[i].SemanticName;
+        if (!name || strlen(name) >= sizeof r.input[i].name) return;
+        r.input[i].desc = pd->InputLayout.pInputElementDescs[i]; r.input[i].desc.SemanticName = NULL;
+        strcpy(r.input[i].name, name);
+    }
+    r.checksum = pso_hash_bytes(1469598103934665603ull, &r, offsetof(PsoWarmRecipe, checksum));
+    const char* base = getenv("RSX_SHADER_CACHE"); if (!base) base = "shadercache";
+    CreateDirectoryA(base, NULL); CreateDirectoryA(dir, NULL);
+    if (pso_warm_code(dir, r.vs_hash, pd->VS.pShaderBytecode, r.vs_bytes) &&
+        pso_warm_code(dir, r.ps_hash, pd->PS.pShaderBytecode, r.ps_bytes) && pso_warm_write(path, &r, sizeof r)) s_pso_warm_learned++;
+}
+static int pso_warm_read_recipe(const char* path, PsoWarmRecipe* r) {
+    FILE* f = fopen(path, "rb"); if (!f) return 0;
+    int ok = fread(r, 1, sizeof *r, f) == sizeof *r && fgetc(f) == EOF; fclose(f);
+    if (!ok || r->magic != 0x31574D5241503547ull || r->version != 1 || r->size != sizeof *r ||
+        r->checksum != pso_hash_bytes(1469598103934665603ull, r, offsetof(PsoWarmRecipe, checksum))) return 0;
+    const D3D12_GRAPHICS_PIPELINE_STATE_DESC* d = &r->desc;
+    if (d->pRootSignature || d->VS.pShaderBytecode || d->PS.pShaderBytecode || d->DS.pShaderBytecode || d->HS.pShaderBytecode || d->GS.pShaderBytecode ||
+        d->GS.BytecodeLength || d->HS.BytecodeLength || d->DS.BytecodeLength || d->InputLayout.pInputElementDescs ||
+        d->StreamOutput.pSODeclaration || d->StreamOutput.pBufferStrides || d->StreamOutput.NumEntries || d->StreamOutput.NumStrides ||
+        d->CachedPSO.pCachedBlob || d->CachedPSO.CachedBlobSizeInBytes || d->InputLayout.NumElements > PSO_WARM_INPUTS ||
+        d->NumRenderTargets > 8 || !r->vs_bytes || !r->ps_bytes || r->vs_bytes > PSO_WARM_CODE_MAX || r->ps_bytes > PSO_WARM_CODE_MAX ||
+        d->VS.BytecodeLength != r->vs_bytes || d->PS.BytecodeLength != r->ps_bytes) return 0;
+    for (u32 i = 0; i < d->InputLayout.NumElements; i++)
+        if (r->input[i].desc.SemanticName || !memchr(r->input[i].name, 0, sizeof r->input[i].name)) return 0;
+    return 1;
+}
+static void* pso_warm_read_code(const char* dir, u64 hash, u32 bytes) {
+    char path[640]; snprintf(path, sizeof path, "%s/code_%016llx.dxbc", dir, (unsigned long long)hash);
+    FILE* f = fopen(path, "rb"); if (!f) return NULL;
+    void* data = malloc(bytes); int ok = data && fread(data, 1, bytes, f) == bytes && fgetc(f) == EOF;
+    fclose(f);
+    if (ok && pso_hash_bytes(1469598103934665603ull, data, bytes) == hash) return data;
+    free(data); return NULL;
+}
+
+/* `retain`: keep the result in the resident prepared set. Only recipe
+ * preparation does: a demand pipeline is already held by the renderer's own
+ * cache, and retaining those too filled the resident set during long play,
+ * leaving no room for the learned race set (and doubling what stays live). */
+static HRESULT create_guest_pso_cached_ex(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                                          ID3D12PipelineState** out, int retain)
+{
+    const char* e = getenv("RSX_PSO_DISK");
+    const char* dir = getenv("RSX_SHADER_CACHE");
+    if (!dir) dir = "shadercache";
+    if ((e && !strcmp(e, "0")) || !strcmp(dir, "0"))
+        return create_guest_pso_uncached(pd, out);
+    u64 hash = guest_pso_hash(pd);
+    if (pso_warm_get(hash, out)) return S_OK;
+    char path[512]; snprintf(path, sizeof path, "%s/pso_%016llx.bin", dir, (unsigned long long)hash);
+    void* cached = NULL; size_t bytes = 0;
+    static unsigned hits, misses, rejects, saves;
+    static ULONGLONG last;
+    const u64 magic = 0x31534F5035505447ull;
+    FILE* f = fopen(path, "rb");
+    if (f) {
+        fseek(f, 0, SEEK_END); long size = ftell(f); rewind(f);
+        u64 header[3] = {0};
+        if (size > (long)sizeof header && size <= 32 * 1024 * 1024 &&
+            fread(header, 1, sizeof header, f) == sizeof header && header[0] == magic &&
+            header[1] == (u64)size - sizeof header) {
+            cached = malloc((size_t)header[1]);
+            if (cached && fread(cached, 1, (size_t)header[1], f) == (size_t)header[1] &&
+                pso_hash_bytes(1469598103934665603ull, cached, (size_t)header[1]) == header[2])
+                bytes = (size_t)header[1];
+        }
+        if (!bytes) rejects++;
+        fclose(f);
+    }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC desc = *pd;
+    HRESULT hr = E_FAIL;
+    if (bytes) {
+        desc.CachedPSO.pCachedBlob = cached; desc.CachedPSO.CachedBlobSizeInBytes = bytes;
+        hr = create_guest_pso_driver(&desc, out);
+        if (SUCCEEDED(hr)) hits++;
+        else { rejects++; if (*out) { (*out)->lpVtbl->Release(*out); *out = NULL; } }
+    }
+    free(cached);
+    if (FAILED(hr)) {
+        misses++;
+        hr = create_guest_pso_uncached(pd, out);
+        ID3DBlob* blob = NULL;
+        if (SUCCEEDED(hr) && SUCCEEDED((*out)->lpVtbl->GetCachedBlob(*out, &blob)) && blob) {
+            CreateDirectoryA(dir, NULL);
+            char tmp[540]; snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+            f = fopen(tmp, "wb");
+            if (f) {
+                size_t n = blob->lpVtbl->GetBufferSize(blob);
+                const void* data = blob->lpVtbl->GetBufferPointer(blob);
+                const u64 header[3] = { magic, (u64)n, pso_hash_bytes(1469598103934665603ull, data, n) };
+                int ok = n && fwrite(header, 1, sizeof header, f) == sizeof header && fwrite(data, 1, n, f) == n;
+                fclose(f);
+                if (ok && MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) saves++;
+                else DeleteFileA(tmp);
+            }
+            blob->lpVtbl->Release(blob);
+        }
+    }
+    ULONGLONG now = GetTickCount64();
+    if (!last) last = now;
+    if (getenv("RSX_PSO_TIMING") && now - last >= 5000) {
+        fprintf(stderr, "[pso-disk] hits=%u misses=%u rejected=%u saved=%u\n", hits, misses, rejects, saves);
+        last = now;
+    }
+    if (SUCCEEDED(hr) && *out) { pso_warm_record(pd, hash); if (retain) pso_warm_put(hash, *out); }
+    return hr;
+}
+/* Recipe preparation: the result stays resident. */
+static HRESULT create_guest_pso_cached(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                                       ID3D12PipelineState** out)
+{
+    return create_guest_pso_cached_ex(pd, out, 1);
+}
+/* A draw's miss. RSX_PSO_RETAIN_DEMAND=1 keeps these resident as before. */
+static HRESULT create_guest_pso_job(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                                    ID3D12PipelineState** out)
+{
+    const char* e = getenv("RSX_PSO_RETAIN_DEMAND");
+    return create_guest_pso_cached_ex(pd, out, e && !strcmp(e, "1"));
+}
+
+
+/* PSO_ASYNC_BEGIN: ownership/queue helpers are also compiled by the WARP test. */
+#define PSO_ASYNC_MAX 256
+#define PSO_ASYNC_SOURCE_MAX (64ull * 1024ull * 1024ull)
+#define PSO_RACE_SEEN 32768
+#define PSO_RACE_RING 1024
+static int pso_async_on(void) {
+    const char* e = getenv("RSX_PSO_ASYNC");
+    return e ? strcmp(e, "0") != 0 : shc_async_on();
+}
+static int pso_race_on(void) {
+    const char* e = getenv("RSX_RACE_PREWARM");
+    const char* cache = getenv("RSX_SHADER_CACHE");
+    const char* recipes = getenv("RSX_PSO_RECIPES");
+    return pso_async_on() && (!e || strcmp(e, "0")) &&
+           (!cache || strcmp(cache, "0")) && (!recipes || strcmp(recipes, "0"));
+}
+typedef struct {
+    u64 hash, serial, owned_bytes; int state; HRESULT result;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC desc;
+    D3D12_INPUT_ELEMENT_DESC input[PSO_WARM_INPUTS];
+    char names[PSO_WARM_INPUTS][32];
+    void *vs, *ps;
+    ID3D12PipelineState* pso;
+} PsoAsyncJob;
+static PsoAsyncJob s_pso_jobs[PSO_ASYNC_MAX];
+static SRWLOCK s_pso_queue_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_pso_queue_cv = CONDITION_VARIABLE_INIT;
+static HANDLE s_pso_worker, s_race_ready;
+static int s_pso_stopping;
+static u64 s_pso_serial;
+static volatile LONG64 s_pso_source_bytes;
+static volatile LONG s_pso_race_active, s_pso_race_request, s_race_waiters;
+static volatile LONG s_menu_active = 1, s_startup_request, s_startup_active, s_menu_recorded;
+static u64 s_menu_seen[PSO_RACE_SEEN];
+static u64 s_used_seen[PSO_RACE_SEEN];   /* recipes marked used this run */
+static volatile LONG s_recipe_touched;
+/* Ring entry kinds: membership of the menu or race set, or a used mark. */
+enum { PSO_LEARN_MENU = 0, PSO_LEARN_RACE = 1, PSO_LEARN_USED = 2 };
+static unsigned char s_race_scope[PSO_RACE_RING];
+static u64 s_race_seen[PSO_RACE_SEEN], s_race_ring[PSO_RACE_RING];
+static u32 s_race_head, s_race_tail;
+static volatile LONG s_pso_queued, s_pso_done, s_pso_failed, s_pso_full;
+static volatile LONG s_race_loaded, s_race_rejected, s_race_recorded, s_race_dropped;
+static DWORD WINAPI pso_worker_main(LPVOID unused);
+
+static void pso_job_release_source(PsoAsyncJob* j) {
+    free(j->vs); free(j->ps); j->vs = j->ps = NULL;
+    if(j->owned_bytes) {InterlockedAdd64(&s_pso_source_bytes,-(LONG64)j->owned_bytes);j->owned_bytes=0;}
+    if (j->desc.pRootSignature) j->desc.pRootSignature->lpVtbl->Release(j->desc.pRootSignature);
+    j->desc.pRootSignature = NULL;
+}
+static int pso_job_copy(PsoAsyncJob* j, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd) {
+    if (!pd || !pd->pRootSignature || !pd->VS.pShaderBytecode || !pd->PS.pShaderBytecode ||
+        !pd->VS.BytecodeLength || !pd->PS.BytecodeLength ||
+        pd->VS.BytecodeLength > PSO_WARM_CODE_MAX || pd->PS.BytecodeLength > PSO_WARM_CODE_MAX ||
+        pd->InputLayout.NumElements > PSO_WARM_INPUTS || pd->StreamOutput.NumEntries ||
+        pd->StreamOutput.NumStrides || pd->GS.BytecodeLength || pd->HS.BytecodeLength || pd->DS.BytecodeLength)
+        return 0;
+    for (u32 i = 0; i < pd->InputLayout.NumElements; ++i)
+        if (!pd->InputLayout.pInputElementDescs || !pd->InputLayout.pInputElementDescs[i].SemanticName ||
+            strlen(pd->InputLayout.pInputElementDescs[i].SemanticName) >= sizeof j->names[i]) return 0;
+    j->vs = malloc(pd->VS.BytecodeLength); j->ps = malloc(pd->PS.BytecodeLength);
+    if (!j->vs || !j->ps) { free(j->vs); free(j->ps); j->vs = j->ps = NULL; return -1; }
+    memcpy(j->vs, pd->VS.pShaderBytecode, pd->VS.BytecodeLength);
+    memcpy(j->ps, pd->PS.pShaderBytecode, pd->PS.BytecodeLength);
+    j->desc = *pd; j->desc.VS.pShaderBytecode = j->vs; j->desc.PS.pShaderBytecode = j->ps;
+    j->desc.CachedPSO.pCachedBlob = NULL; j->desc.CachedPSO.CachedBlobSizeInBytes = 0;
+    j->desc.InputLayout.pInputElementDescs = j->input;
+    for (u32 i = 0; i < pd->InputLayout.NumElements; ++i) {
+        j->input[i] = pd->InputLayout.pInputElementDescs[i];
+        strcpy(j->names[i], j->input[i].SemanticName); j->input[i].SemanticName = j->names[i];
+    }
+    pd->pRootSignature->lpVtbl->AddRef(pd->pRootSignature);
+    j->owned_bytes=(u64)pd->VS.BytecodeLength+pd->PS.BytecodeLength;
+    InterlockedAdd64(&s_pso_source_bytes,(LONG64)j->owned_bytes);
+    return 1;
+}
+static int pso_worker_start_locked(void) {
+    if (s_pso_stopping) return 0;
+    if (!s_pso_worker) {
+        if (!s_race_ready) s_race_ready = CreateEventA(NULL, TRUE, TRUE, NULL);
+        if (s_race_ready) s_pso_worker = CreateThread(NULL, 0, pso_worker_main, NULL, 0, NULL);
+    }
+    return s_pso_worker != NULL;
+}
+static int pso_queue_pending(u64 hash) {
+    int pending = 0;
+    AcquireSRWLockShared(&s_pso_queue_lock);
+    for (u32 i = 0; i < PSO_ASYNC_MAX; ++i)
+        if (s_pso_jobs[i].state && s_pso_jobs[i].hash == hash) {
+            pending = s_pso_jobs[i].state < 3; break;
+        }
+    ReleaseSRWLockShared(&s_pso_queue_lock);
+    return pending;
+}
+static HRESULT pso_queue_get(u64 hash, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                              ID3D12PipelineState** out) {
+    *out = NULL;
+    if (pso_warm_get(hash, out)) return S_OK;
+    HRESULT result = E_PENDING;
+    AcquireSRWLockExclusive(&s_pso_queue_lock);
+    int slot = -1; u64 oldest = ~0ull;
+    for (u32 i = 0; i < PSO_ASYNC_MAX; ++i) {
+        PsoAsyncJob* j = &s_pso_jobs[i];
+        if (j->state && j->hash == hash) {
+            j->serial = ++s_pso_serial;
+            if (j->state == 3) {
+                result = j->result;
+                if (SUCCEEDED(result) && j->pso) { *out = j->pso; (*out)->lpVtbl->AddRef(*out); }
+            }
+            goto done;
+        }
+        if (!j->state) { slot = (int)i; oldest = 0; }
+        else if (j->state == 3 && j->serial < oldest) { slot = (int)i; oldest = j->serial; }
+    }
+    if (slot < 0 || (pd && (u64)pd->VS.BytecodeLength+pd->PS.BytecodeLength+
+                    (u64)InterlockedCompareExchange64(&s_pso_source_bytes,0,0)>PSO_ASYNC_SOURCE_MAX)) {
+        InterlockedIncrement(&s_pso_full); goto done;
+    }
+    if (!pso_worker_start_locked()) { InterlockedIncrement(&s_pso_full); goto done; }
+    PsoAsyncJob* j = &s_pso_jobs[slot];
+    if (j->pso) j->pso->lpVtbl->Release(j->pso);
+    memset(j, 0, sizeof *j);
+    int copied = pso_job_copy(j, pd);
+    if (copied <= 0) { if(copied<0)InterlockedIncrement(&s_pso_full); result = copied ? E_PENDING : E_INVALIDARG; goto done; }
+    j->hash = hash; j->serial = ++s_pso_serial; j->state = 1;
+    InterlockedIncrement(&s_pso_queued); InterlockedIncrement(&g_rsx_shaders_pending);
+    WakeConditionVariable(&s_pso_queue_cv);
+done:
+    ReleaseSRWLockExclusive(&s_pso_queue_lock);
+    return result;
+}
+/* No filesystem work on the render thread: membership is deduplicated in a
+ * bounded table and flushed by the driver worker. Hashes identify local recipes. */
+/* Recipes unused for this many days of play are pruned (relative to the
+ * newest recipe, so a break from playing deletes nothing). 0 disables both
+ * pruning and the used marks. RSX_PSO_RECIPE_KEEP_DAYS, default 14. */
+static int pso_recipe_keep_days(void) {
+    static int days = -1;
+    if (days < 0) { const char* e = getenv("RSX_PSO_RECIPE_KEEP_DAYS"); days = e ? atoi(e) : 14; if (days < 0) days = 0; }
+    return days;
+}
+/* Under s_pso_queue_lock: queue `hash` once per run in `seen`. */
+static void pso_learn_queue_locked(u64* seen, u64 hash, int kind) {
+    for (u32 k = (u32)hash & (PSO_RACE_SEEN-1), n = 0; n < PSO_RACE_SEEN; ++n, k=(k+1)&(PSO_RACE_SEEN-1)) {
+        if (seen[k] == hash) return;
+        if (!seen[k]) {
+            if (s_race_tail-s_race_head >= PSO_RACE_RING || !pso_worker_start_locked()) {
+                InterlockedIncrement(&s_race_dropped); return;   /* retried on a later use */
+            }
+            seen[k] = hash;
+            u32 slot = s_race_tail++ & (PSO_RACE_RING-1);
+            s_race_ring[slot] = hash; s_race_scope[slot] = (unsigned char)kind;
+            WakeConditionVariable(&s_pso_queue_cv); return;
+        }
+    }
+}
+static void pso_race_learn(u64 hash) {
+    int race = InterlockedCompareExchange(&s_pso_race_active, 0, 0) != 0;
+    int menu = InterlockedCompareExchange(&s_menu_active, 0, 0) != 0;
+    const char* cache=getenv("RSX_SHADER_CACHE");
+    const char* recipes=getenv("RSX_PSO_RECIPES");
+    if (!hash || !pso_async_on() || (cache && !strcmp(cache,"0")) || (recipes && !strcmp(recipes,"0"))) return;
+    const int member = race ? pso_race_on() : menu, used = pso_recipe_keep_days() > 0;
+    if (!member && !used) return;
+    AcquireSRWLockExclusive(&s_pso_queue_lock);
+    if (used) pso_learn_queue_locked(s_used_seen, hash, PSO_LEARN_USED);
+    if (member) pso_learn_queue_locked(race ? s_race_seen : s_menu_seen, hash, race ? PSO_LEARN_RACE : PSO_LEARN_MENU);
+    ReleaseSRWLockExclusive(&s_pso_queue_lock);
+}
+/* Worker only: refresh the recipe's and its bytecode files' modified time. */
+static void pso_recipe_touch(const char* dir, u64 hash) {
+    char path[640]; PsoWarmRecipe r;
+    snprintf(path, sizeof path, "%s/pso_%016llx.recipe", dir, (unsigned long long)hash);
+    if (GetFileAttributesA(path) == INVALID_FILE_ATTRIBUTES || !pso_warm_read_recipe(path, &r)) return;
+    pso_touch_file(path);
+    snprintf(path, sizeof path, "%s/code_%016llx.dxbc", dir, (unsigned long long)r.vs_hash); pso_touch_file(path);
+    snprintf(path, sizeof path, "%s/code_%016llx.dxbc", dir, (unsigned long long)r.ps_hash); pso_touch_file(path);
+    InterlockedIncrement(&s_recipe_touched);
+}
+typedef struct { u64 hash; u64 time; } PsoRecipeAge;
+static int pso_age_by_hash(const void* a, const void* b) {
+    u64 x = ((const PsoRecipeAge*)a)->hash, y = ((const PsoRecipeAge*)b)->hash; return x < y ? -1 : x > y;
+}
+static int pso_age_newest_first(const void* a, const void* b) {
+    u64 x = ((const PsoRecipeAge*)a)->time, y = ((const PsoRecipeAge*)b)->time; return x > y ? -1 : x < y;
+}
+static u64 pso_filetime(FILETIME t) { return (u64)t.dwHighDateTime << 32 | t.dwLowDateTime; }
+/* Rewrite one index: entries with a surviving recipe, newest use first,
+ * no duplicates, at most PSO_WARM_MAX. Returns entries kept. */
+static u32 pso_index_compact(const char* index, const PsoRecipeAge* ages, u32 n, u32* before) {
+    *before = 0;
+    FILE* f = fopen(index, "r"); if (!f) return 0;
+    PsoRecipeAge* keep = (PsoRecipeAge*)malloc(sizeof *keep * (n ? n : 1)); u32 kept = 0;
+    char line[64]; unsigned long long h;
+    while (keep && fgets(line, sizeof line, f)) {
+        if (sscanf(line, "%llx", &h) != 1 || !h) continue;
+        ++*before;
+        PsoRecipeAge key = { (u64)h, 0 };
+        const PsoRecipeAge* a = n ? (const PsoRecipeAge*)bsearch(&key, ages, n, sizeof *ages, pso_age_by_hash) : NULL;
+        if (!a || !a->time) continue;
+        u32 i = 0; while (i < kept && keep[i].hash != a->hash) i++;
+        if (i == kept && kept < n) keep[kept++] = *a;
+    }
+    fclose(f);
+    if (!keep) return *before;
+    qsort(keep, kept, sizeof *keep, pso_age_newest_first);
+    if (kept > PSO_WARM_MAX) kept = PSO_WARM_MAX;
+    char tmp[700]; snprintf(tmp, sizeof tmp, "%s.%lu.tmp", index, (unsigned long)GetCurrentThreadId());
+    FILE* o = fopen(tmp, "w"); int ok = o != NULL;
+    for (u32 i = 0; ok && i < kept; i++) ok = fprintf(o, "%016llx\n", (unsigned long long)keep[i].hash) > 0;
+    if (o && fclose(o)) ok = 0;
+    if (!ok || !MoveFileExA(tmp, index, MOVEFILE_REPLACE_EXISTING)) { DeleteFileA(tmp); kept = *before; }
+    free(keep);
+    return kept;
+}
+/* Worker start, before membership is imported: prune recipes and bytecode
+ * not used within the keep window, then compact both indexes newest-first
+ * so startup and race preparation take the freshest states first. Every
+ * recipe ever seen used to stay forever, including ones from older shader
+ * generators that can never match again, and still counted toward the cap. */
+static void pso_recipe_maintain(const char* dir, const char* race_index, const char* menu_index) {
+    const int days = pso_recipe_keep_days();
+    if (!days || !dir[0]) return;
+    char pattern[640], path[700]; WIN32_FIND_DATAA fd;
+    u32 n = 0, cap = 4096, pruned = 0, code_pruned = 0; u64 newest = 0;
+    PsoRecipeAge* ages = (PsoRecipeAge*)malloc(sizeof *ages * cap);
+    if (!ages) return;
+    snprintf(pattern, sizeof pattern, "%s/pso_*.recipe", dir);
+    HANDLE f = FindFirstFileA(pattern, &fd);
+    if (f != INVALID_HANDLE_VALUE) {
+        do {
+            unsigned long long h;
+            if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || sscanf(fd.cFileName + 4, "%llx", &h) != 1) continue;
+            if (n == cap) { PsoRecipeAge* g = (PsoRecipeAge*)realloc(ages, sizeof *ages * cap * 2); if (!g) break; ages = g; cap *= 2; }
+            ages[n].hash = (u64)h; ages[n].time = pso_filetime(fd.ftLastWriteTime);
+            if (ages[n].time > newest) newest = ages[n].time;
+            n++;
+        } while (FindNextFileA(f, &fd));
+        FindClose(f);
+    }
+    const u64 window = (u64)days * 864000000000ull;   /* days in 100-ns units */
+    const u64 cutoff = newest > window ? newest - window : 0;
+    for (u32 i = 0; i < n; i++)
+        if (ages[i].time < cutoff) {
+            snprintf(path, sizeof path, "%s/pso_%016llx.recipe", dir, (unsigned long long)ages[i].hash);
+            if (DeleteFileA(path)) { ages[i].time = 0; pruned++; }
+        }
+    /* Bytecode is touched with each use of a recipe sharing it. */
+    snprintf(pattern, sizeof pattern, "%s/code_*.dxbc", dir);
+    f = cutoff ? FindFirstFileA(pattern, &fd) : INVALID_HANDLE_VALUE;
+    if (f != INVALID_HANDLE_VALUE) {
+        do {
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY || pso_filetime(fd.ftLastWriteTime) >= cutoff) continue;
+            snprintf(path, sizeof path, "%s/%s", dir, fd.cFileName);
+            if (DeleteFileA(path)) code_pruned++;
+        } while (FindNextFileA(f, &fd));
+        FindClose(f);
+    }
+    qsort(ages, n, sizeof *ages, pso_age_by_hash);
+    u32 menu_before = 0, race_before = 0;
+    u32 menu_kept = menu_index[0] ? pso_index_compact(menu_index, ages, n, &menu_before) : 0;
+    u32 race_kept = race_index[0] ? pso_index_compact(race_index, ages, n, &race_before) : 0;
+    fprintf(stderr, "[shader-warmup] recipes: %u kept, %u pruned (unused %d days), %u bytecode pruned; "
+                    "menu index %u->%u, race index %u->%u (newest first)\n",
+            n - pruned, pruned, days, code_pruned, menu_before, menu_kept, race_before, race_kept);
+    free(ages);
+}
+static int pso_startup_background(void) {
+    const char* e=getenv("RSX_SHADER_WARMUP_BACKGROUND");
+    const char* only=getenv("GT5P_SHADER_PRECOMPILE_ONLY");
+    return pso_async_on() && (!only || strcmp(only,"1")) && (!e || strcmp(e,"0"));
+}
+static void pso_startup_begin(void) {
+    AcquireSRWLockExclusive(&s_pso_queue_lock);
+    if (pso_worker_start_locked()) {
+        InterlockedExchange(&s_startup_request,1);
+        WakeConditionVariable(&s_pso_queue_cv);
+        fprintf(stderr,"[shader-warmup] queued background preparation; live draws > menu set > race set; guest may start\n");
+    } else fprintf(stderr,"[shader-warmup] background worker unavailable; using demand compilation\n");
+    ReleaseSRWLockExclusive(&s_pso_queue_lock);
+}
+static void pso_race_notify(const char* name) {
+    if (!name) return;
+    if (!s_spack_active && !s_pso_race_active) spack_begin(0);
+    if (!strcmp(name,"TopMenuTemplate.gpb")) InterlockedExchange(&s_menu_active,1);
+    else if (!strcmp(name,"LoadingRoot.gpb") || !strcmp(name,"CourseSelectRoot.gpb") ||
+             !strcmp(name,"PitSceneRoot.gpb") || !strcmp(name,"DrivingOptionRoot.gpb") ||
+             !strcmp(name,"DealerSelectRoot.gpb")) InterlockedExchange(&s_menu_active,0);
+    if (!pso_race_on()) return;
+    if (!strcmp(name, "LoadingRoot.gpb")) {
+        AcquireSRWLockExclusive(&s_pso_queue_lock);
+        int first = InterlockedExchange(&s_pso_race_active, 1) == 0;
+        int started = pso_worker_start_locked();
+        if (started) {
+            InterlockedIncrement(&s_race_waiters);
+            if(first) {ResetEvent(s_race_ready);InterlockedExchange(&s_pso_race_request,1);WakeConditionVariable(&s_pso_queue_cv);}
+        }
+        ReleaseSRWLockExclusive(&s_pso_queue_lock);
+        if (first) spack_race_begin();
+        /* Every loader of this script observes the same gate. Neither the
+         * render nor window thread calls this filesystem notification. */
+        if (started) {
+            const char* e = getenv("RSX_RACE_PREWARM_WAIT_MS");
+            int ms = e ? atoi(e) : 30000; if(ms<0)ms=0; if(ms>60000)ms=60000;
+            DWORD result=WaitForSingleObject(s_race_ready,(DWORD)ms);
+            if(first || result!=WAIT_OBJECT_0)
+                fprintf(stderr,"[race-prewarm] loading gate %s (budget %d ms)\n",result==WAIT_OBJECT_0?"ready":"timed out",ms);
+            InterlockedDecrement(&s_race_waiters);
+        }
+    } else if (!strcmp(name, "TopMenuTemplate.gpb") || !strcmp(name, "CourseSelectRoot.gpb") ||
+               !strcmp(name, "PitSceneRoot.gpb") || !strcmp(name, "DrivingOptionRoot.gpb")) {
+        if (InterlockedExchange(&s_pso_race_active, 0)) spack_race_end();
+    }
+}
+static int pso_prepare_recipe(const char* dir, const char* path, u64 expected) {
+    ID3D12PipelineState* pso=NULL;
+    if(expected && pso_warm_get(expected,&pso)) {pso->lpVtbl->Release(pso);return 1;}
+    PsoWarmRecipe r;
+    /* A damaged recipe, or one whose bytecode was pruned, is deleted so the
+     * next creation of that pipeline records it afresh (recording skips a
+     * recipe that already exists). A missing file deletes nothing. */
+    if (!pso_warm_read_recipe(path,&r) || (expected && r.hash!=expected)) {DeleteFileA(path);return 0;}
+    if (pso_warm_get(r.hash,&pso)) {pso->lpVtbl->Release(pso);return 1;}
+    AcquireSRWLockShared(&s_pso_warm_lock);
+    int room=s_pso_warm_n<pso_resident_max();
+    ReleaseSRWLockShared(&s_pso_warm_lock);
+    if (!room) return 0;
+    void* vs=pso_warm_read_code(dir,r.vs_hash,r.vs_bytes);
+    void* ps=pso_warm_read_code(dir,r.ps_hash,r.ps_bytes);
+    if (!vs || !ps) DeleteFileA(path);
+    int ok=0;
+    if(vs && ps) {
+        D3D12_INPUT_ELEMENT_DESC inputs[PSO_WARM_INPUTS];
+        for(u32 i=0;i<r.desc.InputLayout.NumElements;++i) {inputs[i]=r.input[i].desc;inputs[i].SemanticName=r.input[i].name;}
+        r.desc.pRootSignature=s_d3d.vp_root_sig;r.desc.VS.pShaderBytecode=vs;r.desc.PS.pShaderBytecode=ps;
+        r.desc.InputLayout.pInputElementDescs=inputs;
+        if(guest_pso_recipe_hash_ok(&r.desc, r.hash) && SUCCEEDED(create_guest_pso_cached(&r.desc,&pso)) && pso) {
+            pso->lpVtbl->Release(pso);ok=1;
+        }
+    }
+    free(vs);free(ps);return ok;
+}
+static int pso_race_recipe(u64 hash) {
+    char dir[512],path[640];if(!pso_warm_dir(dir,sizeof dir))return 0;
+    snprintf(path,sizeof path,"%s/pso_%016llx.recipe",dir,(unsigned long long)hash);
+    return pso_prepare_recipe(dir,path,hash);
+}
+/* One recipe per worker turn: demand jobs interrupt the startup pass between
+ * driver calls, and race loading cancels it (the loading gate prepares the
+ * race set itself). Startup covers the learned menu set, then the learned
+ * race set. It used to continue with every recipe on disk in directory
+ * (hash) order until the resident cap was full, which left no room for the
+ * race set and kept unrelated pipelines live. RSX_SHADER_WARMUP_SCAN=1 adds
+ * that directory scan back as a final phase. No window APIs on this worker. */
+typedef struct {
+    FILE* menu; HANDLE find; WIN32_FIND_DATAA entry;
+    u32 menu_read, visited, menu_ready, race_ready; int phase; ULONGLONG began;
+} PsoStartup;
+static void pso_startup_close(PsoStartup* s) {
+    if(s->menu)fclose(s->menu);
+    if(s->find && s->find!=INVALID_HANDLE_VALUE)FindClose(s->find);
+    memset(s,0,sizeof *s);
+    if(InterlockedExchange(&s_startup_active,0))InterlockedDecrement(&g_rsx_shader_busy);
+}
+static void pso_startup_open(PsoStartup* s,const char* dir) {
+    pso_startup_close(s);char path[640];
+    snprintf(path,sizeof path,"%s/menu-v1.txt",dir);s->menu=fopen(path,"r");
+    s->phase=1;s->began=GetTickCount64();
+    InterlockedExchange(&s_startup_active,1);InterlockedIncrement(&g_rsx_shader_busy);
+    fprintf(stderr,"[shader-warmup] background started; menu priority %s\n",s->menu?"learned":"not learned yet");
+}
+static void pso_startup_step(PsoStartup* s,const char* dir) {
+    char path[640],line[64];unsigned long long hash;
+    if(s->phase==1 || s->phase==2) {
+        /* Phase 1 reads the menu index, phase 2 the race index (both newest
+         * first after pso_recipe_maintain). */
+        if(s->menu && s->menu_read++<PSO_WARM_MAX && fgets(line,sizeof line,s->menu)) {
+            if(sscanf(line,"%llx",&hash)==1 && hash) {
+                if(pso_race_recipe((u64)hash)) {s_pso_warm_loaded++;if(s->phase==1)s->menu_ready++;else s->race_ready++;}
+                else s_pso_warm_rejected++;
+            }
+            return;
+        }
+        if(s->menu) {fclose(s->menu);s->menu=NULL;}
+        if(s->phase==1) {
+            fprintf(stderr,"[shader-warmup] menu priority finished: ready=%u\n",s->menu_ready);
+            if(pso_race_on()) {
+                snprintf(path,sizeof path,"%s/race-v1.txt",dir);s->menu=fopen(path,"r");
+                s->menu_read=0;s->phase=2;
+                if(s->menu) return;
+            }
+        }
+        const char* scan=getenv("RSX_SHADER_WARMUP_SCAN");
+        s->phase=3;s->find=INVALID_HANDLE_VALUE;
+        if(scan && !strcmp(scan,"1")) {
+            snprintf(path,sizeof path,"%s/*.recipe",dir);
+            s->find=FindFirstFileA(path,&s->entry);
+        }
+    }
+    if(s->find!=INVALID_HANDLE_VALUE && s->visited<PSO_WARM_MAX) {
+        if(!(s->entry.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY)) {
+            snprintf(path,sizeof path,"%s/%s",dir,s->entry.cFileName);
+            if(pso_prepare_recipe(dir,path,0))s_pso_warm_loaded++;else s_pso_warm_rejected++;
+            s->visited++;
+        }
+        if(FindNextFileA(s->find,&s->entry))return;
+    }
+    fprintf(stderr,"[shader-warmup] background finished: loaded=%u rejected=%u menu_ready=%u race_ready=%u elapsed_ms=%llu; unseen variants may still compile\n",
+        s_pso_warm_loaded,s_pso_warm_rejected,s->menu_ready,s->race_ready,(unsigned long long)(GetTickCount64()-s->began));
+    pso_startup_close(s);
+}
+static DWORD WINAPI pso_worker_main(LPVOID unused) {
+    (void)unused;
+    fprintf(stderr,"[pso-worker] hosttid=%lu\n",(unsigned long)GetCurrentThreadId());
+    ps3_name_thread(L"pso-worker");
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    char dir[512] = {0}, index[640] = {0}, menu_index[640] = {0};
+    if (pso_warm_dir(dir, sizeof dir)) {
+        snprintf(index,sizeof index,"%s/race-v1.txt",dir);
+        snprintf(menu_index,sizeof menu_index,"%s/menu-v1.txt",dir);
+    }
+    pso_recipe_maintain(dir, index, menu_index);
+    /* Import membership once; duplicate lines are harmless and never interpreted
+     * as paths. Only validated recipes supply descriptors and bytecode. */
+    char line[64];unsigned long long h;
+    for(int scope=0;scope<2;++scope) {
+    const char* member=scope?index:menu_index;
+    u64* seen=scope?s_race_seen:s_menu_seen;
+    FILE* f=member[0]?fopen(member,"r"):NULL;
+    if (f) {
+        for (u32 scanned=0;scanned<PSO_RACE_SEEN && fgets(line,sizeof line,f);++scanned) if (sscanf(line,"%llx",&h)==1 && h) {
+            AcquireSRWLockExclusive(&s_pso_queue_lock);
+            for(u32 k=(u32)h&(PSO_RACE_SEEN-1),n=0;n<PSO_RACE_SEEN;++n,k=(k+1)&(PSO_RACE_SEEN-1))
+                if(!seen[k] || seen[k]==h) {seen[k]=(u64)h;break;}
+            ReleaseSRWLockExclusive(&s_pso_queue_lock);
+        }
+        fclose(f);
+    }
+    }
+    PsoStartup startup={0};
+    FILE* preload = NULL; u32 loaded=0,rejected=0,visited=0; ULONGLONG began=0;
+    for (;;) {
+        AcquireSRWLockExclusive(&s_pso_queue_lock);
+        if (s_pso_stopping) { ReleaseSRWLockExclusive(&s_pso_queue_lock); break; }
+        int begin_race = InterlockedExchange(&s_pso_race_request,0);
+        int begin_startup = InterlockedExchange(&s_startup_request,0);
+        PsoAsyncJob* job=NULL; u64 serial=~0ull;
+        for(u32 i=0;i<PSO_ASYNC_MAX;++i) if(s_pso_jobs[i].state==1 && s_pso_jobs[i].serial<serial) {job=&s_pso_jobs[i];serial=job->serial;}
+        if(job)job->state=2;
+        u32 learn_slot=s_race_head&(PSO_RACE_RING-1);
+        u64 learn=s_race_head!=s_race_tail?s_race_ring[learn_slot]:0;
+        int learn_race=learn?s_race_scope[learn_slot]:0;if(learn)s_race_head++;
+        if(!job && !learn && !preload && !begin_race && !begin_startup && !startup.phase) {
+            SleepConditionVariableSRW(&s_pso_queue_cv,&s_pso_queue_lock,INFINITE,0);
+            ReleaseSRWLockExclusive(&s_pso_queue_lock); continue;
+        }
+        ReleaseSRWLockExclusive(&s_pso_queue_lock);
+        if(begin_startup)pso_startup_open(&startup,dir);
+        if (begin_race) {
+            if(startup.phase) {
+                fprintf(stderr,"[shader-warmup] race loading began; startup preparation cancelled (menu_ready=%u race_ready=%u)\n",
+                        startup.menu_ready,startup.race_ready);
+                pso_startup_close(&startup);
+            }
+            if(preload)fclose(preload);
+            if(index[0])pso_warm_keep_only(index);
+            preload=index[0]?fopen(index,"r"):NULL; loaded=rejected=visited=0; began=GetTickCount64();
+            fprintf(stderr,"[race-prewarm] loading known race pipeline set: %s\n",preload?index:"none learned yet");
+            if (!preload) SetEvent(s_race_ready);
+        }
+        if(learn && index[0] && learn_race==PSO_LEARN_USED) pso_recipe_touch(dir,learn);
+        else if(learn && index[0]) {
+            CreateDirectoryA(dir,NULL); FILE* append=fopen(learn_race?index:menu_index,"a");
+            if(append) {fprintf(append,"%016llx\n",(unsigned long long)learn);fclose(append);InterlockedIncrement(learn_race?&s_race_recorded:&s_menu_recorded);}
+        }
+        if(job) {
+            ID3D12PipelineState* pso=NULL;
+            HRESULT hr=create_guest_pso_job(&job->desc,&pso);
+            pso_job_release_source(job);
+            AcquireSRWLockExclusive(&s_pso_queue_lock);
+            job->pso=pso; job->result=hr; job->state=3;
+            InterlockedIncrement(SUCCEEDED(hr)?&s_pso_done:&s_pso_failed);
+            InterlockedDecrement(&g_rsx_shaders_pending);
+            ReleaseSRWLockExclusive(&s_pso_queue_lock);
+        } else if(preload) {
+            if(visited++<PSO_RACE_SEEN && fgets(line,sizeof line,preload)) {
+                if(sscanf(line,"%llx",&h)==1 && h) {
+                    if(pso_race_recipe((u64)h)) {loaded++;InterlockedIncrement(&s_race_loaded);}
+                    else {rejected++;InterlockedIncrement(&s_race_rejected);}
+                }
+            } else {
+                fclose(preload);preload=NULL;
+                SetEvent(s_race_ready);
+                fprintf(stderr,"[race-prewarm] finished: ready=%u rejected=%u elapsed_ms=%llu\n",loaded,rejected,(unsigned long long)(GetTickCount64()-began));
+            }
+        } else if(startup.phase) {pso_startup_step(&startup,dir);Sleep(1);}
+    }
+    pso_startup_close(&startup);
+    if(preload)fclose(preload);
+    /* Persist membership already accepted by the renderer even when shutdown
+     * cancels queued driver jobs. Only validated recipes can be replayed later. */
+    while(s_race_head!=s_race_tail) {
+        u32 slot=s_race_head++&(PSO_RACE_RING-1);
+        if(s_race_scope[slot]==PSO_LEARN_USED) continue;   /* use marks are not needed at exit */
+        const char* path=s_race_scope[slot]?index:menu_index;
+        FILE* append=path[0]?fopen(path,"a"):NULL;
+        if(append) {fprintf(append,"%016llx\n",(unsigned long long)s_race_ring[slot]);fclose(append);InterlockedIncrement(s_race_scope[slot]?&s_race_recorded:&s_menu_recorded);}
+    }
+    return 0;
+}
+static void pso_queue_stop(void) {
+    AcquireSRWLockExclusive(&s_pso_queue_lock);
+    s_pso_stopping=1; if(s_race_ready)SetEvent(s_race_ready); WakeAllConditionVariable(&s_pso_queue_cv);
+    HANDLE worker=s_pso_worker;
+    ReleaseSRWLockExclusive(&s_pso_queue_lock);
+    if(worker) {WaitForSingleObject(worker,INFINITE);CloseHandle(worker);}
+    while(InterlockedCompareExchange(&s_race_waiters,0,0))Sleep(1);
+    AcquireSRWLockExclusive(&s_pso_queue_lock);
+    for(u32 i=0;i<PSO_ASYNC_MAX;++i) {
+        PsoAsyncJob* j=&s_pso_jobs[i];
+        if(j->state==1)InterlockedDecrement(&g_rsx_shaders_pending);
+        pso_job_release_source(j);
+        if(j->pso)j->pso->lpVtbl->Release(j->pso);
+        memset(j,0,sizeof *j);
+    }
+    s_pso_worker=NULL;
+    if(s_race_ready) {CloseHandle(s_race_ready);s_race_ready=NULL;}
+    ReleaseSRWLockExclusive(&s_pso_queue_lock);
+}
+static void pso_queue_debug(FILE* out) {
+    fprintf(out,"Background startup: enabled=%d active=%ld menu_scope=%ld menu_learned=%ld; recipes keep_days=%d used_marked=%ld\n",
+            pso_startup_background(),s_startup_active,s_menu_active,s_menu_recorded,pso_recipe_keep_days(),s_recipe_touched);
+    fprintf(out,"Async pipelines: enabled=%d queued=%ld completed=%ld failed=%ld queue_full=%ld source_kib=%lld; race active=%ld warmed=%ld rejected=%ld learned=%ld dropped=%ld\n",
+            pso_async_on(),s_pso_queued,s_pso_done,s_pso_failed,s_pso_full,(long long)InterlockedCompareExchange64(&s_pso_source_bytes,0,0)/1024,s_pso_race_active,s_race_loaded,s_race_rejected,s_race_recorded,s_race_dropped);
+}
+/* PSO_ASYNC_END */
+
+/* The present owner queues background work before releasing guest startup.
+ * RSX_SHADER_WARMUP_BACKGROUND=0 retains the legacy blocking diagnostic path. */
+void rsx_d3d12_backend_prewarm(void) {
+    char dir[512], pattern[640];
+    { const char* e = getenv("RSX_SHADER_WARMUP"); if (!e || strcmp(e, "1")) return; }
+    if (!s_d3d.device || !s_d3d.vp_root_sig || !pso_warm_dir(dir, sizeof dir)) {
+        fprintf(stderr, "[shader-warmup] skipped: shader cache/recipes unavailable\n"); return;
+    }
+    if(pso_startup_background()) {pso_startup_begin();return;}
+    snprintf(pattern, sizeof pattern, "%s/*.recipe", dir);
+    WIN32_FIND_DATAA fd; HANDLE find = FindFirstFileA(pattern, &fd);
+    if (find == INVALID_HANDLE_VALUE) {
+        fprintf(stderr, "[shader-warmup] no known pipelines yet; this run will learn them\n"); return;
+    }
+    u32 total = 0;
+    do { if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) total++; } while (total < PSO_WARM_MAX && FindNextFileA(find, &fd));
+    FindClose(find);
+    find = FindFirstFileA(pattern, &fd); if (find == INVALID_HANDLE_VALUE) return;
+    ULONGLONG started = GetTickCount64(); u32 visited = 0;
+    fprintf(stderr, "[shader-warmup] preparing %u known pipelines before guest execution (limit %u)\n", total, PSO_WARM_MAX);
+    InterlockedIncrement(&g_rsx_shader_busy);
+    do {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        char path[640]; snprintf(path, sizeof path, "%s/%s", dir, fd.cFileName);
+        PsoWarmRecipe r; ID3D12PipelineState* pso = NULL;
+        int ok = pso_warm_read_recipe(path, &r);
+        void* vs = ok ? pso_warm_read_code(dir, r.vs_hash, r.vs_bytes) : NULL;
+        void* ps = ok ? pso_warm_read_code(dir, r.ps_hash, r.ps_bytes) : NULL;
+        if (vs && ps) {
+            D3D12_INPUT_ELEMENT_DESC inputs[PSO_WARM_INPUTS];
+            for (u32 i = 0; i < r.desc.InputLayout.NumElements; i++) { inputs[i] = r.input[i].desc; inputs[i].SemanticName = r.input[i].name; }
+            r.desc.pRootSignature = s_d3d.vp_root_sig;
+            r.desc.VS.pShaderBytecode = vs; r.desc.PS.pShaderBytecode = ps;
+            r.desc.InputLayout.pInputElementDescs = inputs;
+            if (guest_pso_recipe_hash_ok(&r.desc, r.hash) && SUCCEEDED(create_guest_pso_cached(&r.desc, &pso)) && pso) s_pso_warm_loaded++;
+            else s_pso_warm_rejected++;
+        } else s_pso_warm_rejected++;
+        if (pso) pso->lpVtbl->Release(pso); free(vs); free(ps);
+        visited++;
+        if ((visited % 16u) == 0 || visited == total) {
+            char title[160]; snprintf(title, sizeof title, "Gran Turismo 5 Prologue | Preparing shaders %u/%u", visited, total); win_set_title(title);
+        }
+    } while (visited < PSO_WARM_MAX && FindNextFileA(find, &fd));
+    FindClose(find); InterlockedDecrement(&g_rsx_shader_busy);
+    fprintf(stderr, "[shader-warmup] finished: loaded=%u rejected=%u elapsed_ms=%llu; unseen variants may still compile\n",
+            s_pso_warm_loaded, s_pso_warm_rejected, (unsigned long long)(GetTickCount64() - started));
+    win_set_title("Gran Turismo 5 Prologue (ps3recomp)");
+}
+
+static int pso_code_share(void)
+{
+    const char* e = getenv("RSX_PSO_CODE_SHARE");
+    const char* cb = getenv("FP_CONSTBUF");
+    return !(e && !strcmp(e, "0")) && !(cb && !strcmp(cb, "0"));
+}
+static u32 fp_key_hash(const VPFPEntry* k)
+{
+    const u32 w[] = { pso_code_share() ? 0u : k->fp_addr, (u32)k->vs_idx, k->vs_hash, (u32)k->gen, k->blend, (u32)k->nrt, k->rtfmt,
+                        (u32)k->exp32, (u32)k->ucode_hash, (u32)(k->ucode_hash >> 32), k->cmask, k->cull, k->stencil, k->unnorm, k->cube_mask,
+                        k->vmask, (u32)k->samp_key, (u32)(k->samp_key >> 32), k->ghi, k->shd, k->unhi };
+    u32 h = 2166136261u;
+    for (int i = 0; i < (int)(sizeof w / sizeof w[0]); i++) { h ^= w[i]; h *= 16777619u; h ^= h >> 15; }
+    return h;
+}
+static int fp_key_eq(const VPFPEntry* a, const VPFPEntry* b)
+{
+    return (pso_code_share() || a->fp_addr == b->fp_addr) && a->vs_idx == b->vs_idx && a->vs_hash == b->vs_hash && a->gen == b->gen &&
+           a->blend == b->blend && a->nrt == b->nrt && a->rtfmt == b->rtfmt && a->exp32 == b->exp32 &&
+           a->ucode_hash == b->ucode_hash && a->cmask == b->cmask && a->cull == b->cull &&
+           a->stencil == b->stencil && a->unnorm == b->unnorm && a->cube_mask == b->cube_mask &&
+           a->vmask == b->vmask && a->samp_key == b->samp_key && a->ghi == b->ghi &&
+           a->shd == b->shd && a->unhi == b->unhi;
+}
+/* RSX_PSO_TIMING=1: where a pipeline-cache miss spends its time, every 5 s:
+ * building the HLSL (decompile and patches), getting the DXBC (disk cache or
+ * compile) and the driver's pipeline build. */
+static LARGE_INTEGER s_pt_t0;
+static double s_pt_hlsl, s_pt_dxbc, s_pt_pso;
+static unsigned s_pt_n;
+static int pso_timing_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("RSX_PSO_TIMING") ? 1 : 0;
+    return on;
+}
+static double pt_ms_since(LARGE_INTEGER* t)
+{
+    LARGE_INTEGER n, f; QueryPerformanceCounter(&n); QueryPerformanceFrequency(&f);
+    double ms = (double)(n.QuadPart - t->QuadPart) * 1000.0 / (double)f.QuadPart;
+    *t = n;
+    return ms;
+}
+static void pso_timing_report(void)
+{
+    static ULONGLONG last;
+    ULONGLONG now = GetTickCount64();
+    if (!last) last = now;
+    if (now - last < 5000) return;
+    last = now;
+    if (s_pt_n)
+        fprintf(stderr, "[pso-time] 5 s: %u misses: hlsl %.0f ms, dxbc %.0f ms (%ld compiled so far), pipeline %.0f ms%c",
+                s_pt_n, s_pt_hlsl, s_pt_dxbc, (long)g_rsx_shaders_compiled, s_pt_pso, 10);
