+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(),
+                        &g_ppu_threads[0].host_thread, 0, FALSE, DUPLICATE_SAME_ACCESS);
+    host_apply_prio(g_ppu_threads[0].host_thread, prio);
