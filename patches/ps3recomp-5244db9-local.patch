+    if (low < 0) { const char* e = getenv("SPURS_WWS_LOW"); low = (e && *e == '1') ? 1 : 0; }
+    if (ea < 0x10000) return 0;
+    if (low) return ea < 0x40000000;
+    if (ea >= 0xC0000000u || ea + size < ea || ea + size > 0xC0000000u) return 0;
+#ifdef _WIN32
+    { extern uint8_t g_vm_page_bitmap[65536 / 8];
+      const u32 pg[2] = { ea >> 16, (ea + size - 1) >> 16 };
+      for (int i = 0; i < 2; i++) {
+          if ((g_vm_page_bitmap[pg[i] >> 3] >> (pg[i] & 7)) & 1) continue;
+          MEMORY_BASIC_INFORMATION mbi;
+          if (!VirtualQuery(vm_base + ((uintptr_t)pg[i] << 16), &mbi, sizeof mbi)) return 0;
+          if (mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD))) return 0;
+      } }
+#endif
