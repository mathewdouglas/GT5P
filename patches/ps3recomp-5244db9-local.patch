diff --git a/libs/codec/codec_ffmpeg.c b/libs/codec/codec_ffmpeg.c
new file mode 100644
index 00000000..e71dcbca
--- /dev/null
+++ b/libs/codec/codec_ffmpeg.c
@@ -0,0 +1,230 @@
+/*
+ * ps3recomp - host video and audio decoding through FFmpeg, loaded at run
+ * time. See codec_ffmpeg.h.
+ *
+ * The headers only give the struct layouts and prototypes; every function is
+ * looked up in the DLLs, so the executable starts and runs without them.
+ * Built against FFmpeg 7.1 (libavcodec 61, libavutil 59); the DLL names below
+ * must match the major versions of the headers used.
+ */
+#include "codec_ffmpeg.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef PS3RECOMP_HAVE_FFMPEG
+
+int codec_ff_available(void) { return 0; }
+codec_ff* codec_ff_open_h264(void) { return NULL; }
+codec_ff* codec_ff_open_mpeg2(void) { return NULL; }
+codec_ff* codec_ff_open_atrac3p(int c, int b, int r) { (void)c; (void)b; (void)r; return NULL; }
+void codec_ff_close(codec_ff* d) { (void)d; }
+void codec_ff_flush(codec_ff* d) { (void)d; }
+void codec_ff_skip_nonref(codec_ff* d, int on) { (void)d; (void)on; }
+int codec_ff_send(codec_ff* d, const uint8_t* p, int n, int64_t pts, uint64_t tag)
+{ (void)d; (void)p; (void)n; (void)pts; (void)tag; return -1; }
+int codec_ff_receive_picture(codec_ff* d, codec_ff_picture* o) { (void)d; (void)o; return -1; }
+void codec_ff_picture_free(codec_ff_picture* p) { (void)p; }
+int codec_ff_receive_audio(codec_ff* d, codec_ff_audio* o) { (void)d; (void)o; return -1; }
+void codec_ff_audio_free(codec_ff_audio* a) { (void)a; }
+
+#else
+
+#include <libavcodec/avcodec.h>
+#include <libavutil/frame.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/log.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#define FF_AVCODEC "avcodec-61.dll"
+#define FF_AVUTIL  "avutil-59.dll"
+typedef HMODULE ff_lib;
+static ff_lib ff_load(const char* n) { return LoadLibraryA(n); }
+static void* ff_sym(ff_lib l, const char* s) { return (void*)GetProcAddress(l, s); }
+#else
+#include <dlfcn.h>
+#define FF_AVCODEC "libavcodec.so.61"
+#define FF_AVUTIL  "libavutil.so.59"
+typedef void* ff_lib;
+static ff_lib ff_load(const char* n) { return dlopen(n, RTLD_NOW); }
+static void* ff_sym(ff_lib l, const char* s) { return dlsym(l, s); }
+#endif
+
+#define FF_FN(name) static __typeof__(name)* p_##name
+FF_FN(avcodec_find_decoder);
+FF_FN(avcodec_alloc_context3);
+FF_FN(avcodec_open2);
+FF_FN(avcodec_free_context);
+FF_FN(avcodec_send_packet);
+FF_FN(avcodec_receive_frame);
+FF_FN(avcodec_flush_buffers);
+FF_FN(av_packet_alloc);
+FF_FN(av_packet_free);
+FF_FN(av_frame_alloc);
+FF_FN(av_frame_free);
+FF_FN(av_frame_unref);
+FF_FN(av_channel_layout_default);
+FF_FN(av_log_set_level);
+
+static int s_state = -1;   /* -1 not tried, 0 unavailable, 1 loaded */
+
+int codec_ff_available(void)
+{
+    if (s_state >= 0) return s_state;
+    s_state = 0;
+    const char* e = getenv("CODEC_FFMPEG");
+    if (e && e[0] == '0') { printf("[codec] CODEC_FFMPEG=0: no decoding\n"); return 0; }
+    ff_lib u = ff_load(FF_AVUTIL), c = u ? ff_load(FF_AVCODEC) : 0;
+    if (!u || !c) {
+        printf("[codec] %s / %s not found: movies play black and silent\n", FF_AVCODEC, FF_AVUTIL);
+        return 0;
+    }
+#define LOAD(lib, name) if (!(p_##name = (__typeof__(name)*)ff_sym(lib, #name))) { \
+        printf("[codec] missing %s\n", #name); return 0; }
+    LOAD(c, avcodec_find_decoder) LOAD(c, avcodec_alloc_context3) LOAD(c, avcodec_open2)
+    LOAD(c, avcodec_free_context) LOAD(c, avcodec_send_packet) LOAD(c, avcodec_receive_frame)
+    LOAD(c, avcodec_flush_buffers) LOAD(c, av_packet_alloc) LOAD(c, av_packet_free)
+    LOAD(u, av_frame_alloc) LOAD(u, av_frame_free) LOAD(u, av_frame_unref)
+    LOAD(u, av_channel_layout_default) LOAD(u, av_log_set_level)
+#undef LOAD
+    p_av_log_set_level(getenv("CODEC_FFMPEG_LOG") ? AV_LOG_VERBOSE : AV_LOG_ERROR);
+    printf("[codec] FFmpeg loaded (%s)\n", FF_AVCODEC);
+    s_state = 1;
+    return 1;
+}
+
+struct codec_ff {
+    AVCodecContext* ctx;
+    AVPacket* pkt;
+    AVFrame* frame;
+    int audio;
+};
+
+static codec_ff* ff_open(enum AVCodecID id, int channels, int block_align, int rate)
+{
+    if (!codec_ff_available()) return NULL;
+    const AVCodec* c = p_avcodec_find_decoder(id);
+    if (!c) { printf("[codec] no decoder for codec id %d\n", (int)id); return NULL; }
+    codec_ff* d = (codec_ff*)calloc(1, sizeof(*d));
+    d->ctx = p_avcodec_alloc_context3(c);
+    d->ctx->flags |= AV_CODEC_FLAG_COPY_OPAQUE;
+    d->audio = channels > 0;
+    if (d->audio) {
+        p_av_channel_layout_default(&d->ctx->ch_layout, channels);
+        d->ctx->block_align = block_align;
+        d->ctx->sample_rate = rate;
+    } else {
+        d->ctx->thread_count = 4;
+    }
+    d->ctx->pkt_timebase = (AVRational){1, 90000};
+    if (p_avcodec_open2(d->ctx, c, NULL) < 0) {
+        printf("[codec] avcodec_open2 failed for codec id %d\n", (int)id);
+        p_avcodec_free_context(&d->ctx); free(d); return NULL;
+    }
+    d->pkt = p_av_packet_alloc();
+    d->frame = p_av_frame_alloc();
+    return d;
+}
+
+codec_ff* codec_ff_open_h264(void)  { return ff_open(AV_CODEC_ID_H264, 0, 0, 0); }
+codec_ff* codec_ff_open_mpeg2(void) { return ff_open(AV_CODEC_ID_MPEG2VIDEO, 0, 0, 0); }
+codec_ff* codec_ff_open_atrac3p(int channels, int block_align, int rate)
+{
+    return ff_open(AV_CODEC_ID_ATRAC3P, channels, block_align, rate);
+}
+
+void codec_ff_close(codec_ff* d)
+{
+    if (!d) return;
+    p_av_frame_free(&d->frame);
+    p_av_packet_free(&d->pkt);
+    p_avcodec_free_context(&d->ctx);
+    free(d);
+}
+
+void codec_ff_flush(codec_ff* d) { if (d) p_avcodec_flush_buffers(d->ctx); }
+
+void codec_ff_skip_nonref(codec_ff* d, int on)
+{
+    if (d) d->ctx->skip_frame = on ? AVDISCARD_NONREF : AVDISCARD_DEFAULT;
+}
+
+int codec_ff_send(codec_ff* d, const uint8_t* data, int size, int64_t pts, uint64_t tag)
+{
+    if (!d) return -1;
+    if (!data) return p_avcodec_send_packet(d->ctx, NULL);
+    d->pkt->data = (uint8_t*)data;   /* not refcounted: FFmpeg copies it */
+    d->pkt->size = size;
+    d->pkt->pts = pts;
+    d->pkt->dts = AV_NOPTS_VALUE;
+    d->pkt->opaque = (void*)(uintptr_t)tag;
+    int r = p_avcodec_send_packet(d->ctx, d->pkt);
+    d->pkt->data = NULL; d->pkt->size = 0; d->pkt->opaque = NULL;
+    return r;
+}
+
+int codec_ff_receive_picture(codec_ff* d, codec_ff_picture* out)
+{
+    if (!d) return -1;
+    int r = p_avcodec_receive_frame(d->ctx, d->frame);
+    if (r == AVERROR(EAGAIN)) return 0;
+    if (r < 0) return -1;
+    AVFrame* f = d->frame;
+    if (f->format != AV_PIX_FMT_YUV420P && f->format != AV_PIX_FMT_YUVJ420P) {
+        static int warned;
+        if (!warned++) printf("[codec] picture format %d is not 8-bit 4:2:0; dropped\n", f->format);
+        p_av_frame_unref(f);
+        return 0;
+    }
+    int w = f->width & ~1, h = f->height & ~1;
+    size_t ys = (size_t)w * h, cs = (size_t)(w / 2) * (h / 2);
+    uint8_t* buf = (uint8_t*)malloc(ys + 2 * cs);
+    for (int y = 0; y < h; y++)
+        memcpy(buf + (size_t)y * w, f->data[0] + (size_t)y * f->linesize[0], w);
+    for (int y = 0; y < h / 2; y++) {
+        memcpy(buf + ys + (size_t)y * (w / 2), f->data[1] + (size_t)y * f->linesize[1], w / 2);
+        memcpy(buf + ys + cs + (size_t)y * (w / 2), f->data[2] + (size_t)y * f->linesize[2], w / 2);
+    }
+    out->w = w; out->h = h;
+    out->y = buf; out->u = buf + ys; out->v = buf + ys + cs;
+    out->pict_type = (int)f->pict_type;
+    out->key = (f->flags & AV_FRAME_FLAG_KEY) != 0;
+    out->full_range = f->color_range == AVCOL_RANGE_JPEG || f->format == AV_PIX_FMT_YUVJ420P;
+    out->pts = f->pts;
+    out->tag = (uint64_t)(uintptr_t)f->opaque;
+    out->fr_num = d->ctx->framerate.num; out->fr_den = d->ctx->framerate.den;
+    p_av_frame_unref(f);
+    return 1;
+}
+
+void codec_ff_picture_free(codec_ff_picture* p) { if (p) { free(p->y); p->y = p->u = p->v = NULL; } }
+
+int codec_ff_receive_audio(codec_ff* d, codec_ff_audio* out)
+{
+    if (!d) return -1;
+    int r = p_avcodec_receive_frame(d->ctx, d->frame);
+    if (r == AVERROR(EAGAIN)) return 0;
+    if (r < 0) return -1;
+    AVFrame* f = d->frame;
+    int ch = f->ch_layout.nb_channels, n = f->nb_samples;
+    out->channels = ch; out->samples = n; out->rate = f->sample_rate;
+    out->tag = (uint64_t)(uintptr_t)f->opaque;
+    out->data = (float*)malloc(sizeof(float) * (size_t)(ch ? ch : 1) * (size_t)(n ? n : 1));
+    for (int c = 0; c < ch; c++) {
+        float* dst = out->data + (size_t)c * n;
+        if (f->format == AV_SAMPLE_FMT_FLTP) memcpy(dst, f->extended_data[c], sizeof(float) * n);
+        else if (f->format == AV_SAMPLE_FMT_FLT)
+            for (int i = 0; i < n; i++) dst[i] = ((const float*)f->extended_data[0])[i * ch + c];
+        else if (f->format == AV_SAMPLE_FMT_S16P)
+            for (int i = 0; i < n; i++) dst[i] = ((const int16_t*)f->extended_data[c])[i] / 32768.0f;
+        else memset(dst, 0, sizeof(float) * n);
+    }
+    p_av_frame_unref(f);
+    return 1;
+}
+
+void codec_ff_audio_free(codec_ff_audio* a) { if (a) { free(a->data); a->data = NULL; } }
+
+#endif
diff --git a/libs/codec/codec_ffmpeg.h b/libs/codec/codec_ffmpeg.h
new file mode 100644
index 00000000..c8a16985
--- /dev/null
+++ b/libs/codec/codec_ffmpeg.h
@@ -0,0 +1,73 @@
+/*
+ * ps3recomp - host video and audio decoding for cellVdec / cellAdec
+ *
+ * A thin wrapper over FFmpeg's libavcodec, loaded at run time
+ * (avcodec-61.dll, avutil-59.dll beside the executable). It is compiled in
+ * only when the build passes FFmpeg's headers (PS3RECOMP_FFMPEG_INCLUDE in
+ * CMake, which defines PS3RECOMP_HAVE_FFMPEG on this file). Without the
+ * headers, or without the DLLs at run time, codec_ff_available() is 0 and
+ * the decoders produce black pictures and silence.
+ *
+ * CODEC_FFMPEG=0 turns decoding off even when the DLLs are there.
+ */
+#ifndef PS3RECOMP_CODEC_FFMPEG_H
+#define PS3RECOMP_CODEC_FFMPEG_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct codec_ff codec_ff;
+
+/* 1 when the DLLs loaded and decoding is allowed. */
+int codec_ff_available(void);
+
+codec_ff* codec_ff_open_h264(void);
+codec_ff* codec_ff_open_mpeg2(void);
+/* ATRAC3plus: channels 1..8, block_align = bytes per frame (without the
+ * 8-byte ATS header), sample_rate in Hz. */
+codec_ff* codec_ff_open_atrac3p(int channels, int block_align, int sample_rate);
+void codec_ff_close(codec_ff* d);
+void codec_ff_flush(codec_ff* d);
+/* Skip non-reference frames (B pictures) from now on, or stop skipping. */
+void codec_ff_skip_nonref(codec_ff* d, int on);
+
+/* Feed one access unit; data == NULL starts draining. tag comes back with
+ * the frame it produced. Returns 0, or < 0 on an error the caller may ignore. */
+int codec_ff_send(codec_ff* d, const uint8_t* data, int size, int64_t pts, uint64_t tag);
+
+/* A decoded picture, 8-bit 4:2:0 planar, tightly packed:
+ * y = w*h bytes, u and v = (w/2)*(h/2) each. */
+typedef struct {
+    int w, h;
+    uint8_t* y; uint8_t* u; uint8_t* v;  /* one malloc'd block, starting at y */
+    int pict_type;                       /* 1 I, 2 P, 3 B (FFmpeg's AVPictureType) */
+    int key;
+    int full_range;
+    int64_t pts;
+    uint64_t tag;
+    int fr_num, fr_den;                  /* stream frame rate, 0 if unknown */
+} codec_ff_picture;
+
+/* 1 and *out filled (free with codec_ff_picture_free), 0 when the decoder
+ * needs more input, -1 when drained or on error. */
+int codec_ff_receive_picture(codec_ff* d, codec_ff_picture* out);
+void codec_ff_picture_free(codec_ff_picture* p);
+
+/* Decoded audio, planar float, channel order L R C LFE Ls Rs (Lb Rb). */
+typedef struct {
+    int channels, samples, rate;
+    float* data;          /* channels * samples, plane after plane; malloc'd */
+    uint64_t tag;
+} codec_ff_audio;
+
+int codec_ff_receive_audio(codec_ff* d, codec_ff_audio* out);
+void codec_ff_audio_free(codec_ff_audio* a);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/libs/codec/codec_host.h b/libs/codec/codec_host.h
new file mode 100644
index 00000000..e8aa9f7a
--- /dev/null
+++ b/libs/codec/codec_host.h
@@ -0,0 +1,129 @@
+/*
+ * ps3recomp - what the movie libraries (cellDmux, cellVdec, cellAdec) share:
+ * a host thread with its own guest callback stack, a lock and a condition
+ * variable, and big-endian guest stores.
+ *
+ * On the console each of these libraries runs a PPU thread of its own and
+ * calls the title's callbacks from it. Here each one gets a host thread; the
+ * callbacks go through g_ps3_guest_caller on a stack carved from the work
+ * memory the title gave the library, because ppu_guest_call otherwise starts
+ * every thread on the same scratch stack.
+ */
+#ifndef PS3RECOMP_CODEC_HOST_H
+#define PS3RECOMP_CODEC_HOST_H
+
+#include <stdint.h>
+#include <string.h>
+#include "ps3emu/guest_call.h"
+#include "../../runtime/ppu/ppu_memory.h"
+
+#ifdef _WIN32
+#include <windows.h>
+typedef CRITICAL_SECTION codec_lock;
+typedef CONDITION_VARIABLE codec_cond;
+typedef HANDLE codec_thread;
+static inline void codec_lock_init(codec_lock* l) { InitializeCriticalSection(l); }
+static inline void codec_lock_free(codec_lock* l) { DeleteCriticalSection(l); }
+static inline void codec_lock_take(codec_lock* l) { EnterCriticalSection(l); }
+static inline void codec_lock_give(codec_lock* l) { LeaveCriticalSection(l); }
+static inline void codec_cond_init(codec_cond* c) { InitializeConditionVariable(c); }
+static inline void codec_cond_wait(codec_cond* c, codec_lock* l) { SleepConditionVariableCS(c, l, 50); }
+static inline void codec_cond_wake(codec_cond* c) { WakeAllConditionVariable(c); }
+typedef DWORD (WINAPI* codec_thread_fn)(LPVOID);
+#define CODEC_THREAD_FN(name) static DWORD WINAPI name(LPVOID arg)
+static inline codec_thread codec_thread_start(codec_thread_fn fn, void* arg)
+{ return CreateThread(NULL, 1u << 20, fn, arg, 0, NULL); }
+static inline void codec_thread_join(codec_thread t)
+{ if (t) { WaitForSingleObject(t, INFINITE); CloseHandle(t); } }
+#else
+#include <pthread.h>
+typedef pthread_mutex_t codec_lock;
+typedef pthread_cond_t codec_cond;
+typedef pthread_t codec_thread;
+static inline void codec_lock_init(codec_lock* l) { pthread_mutex_init(l, NULL); }
+static inline void codec_lock_free(codec_lock* l) { pthread_mutex_destroy(l); }
+static inline void codec_lock_take(codec_lock* l) { pthread_mutex_lock(l); }
+static inline void codec_lock_give(codec_lock* l) { pthread_mutex_unlock(l); }
+static inline void codec_cond_init(codec_cond* c) { pthread_cond_init(c, NULL); }
+static inline void codec_cond_wait(codec_cond* c, codec_lock* l)
+{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_nsec += 50000000;
+  if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+  pthread_cond_timedwait(c, l, &ts); }
+static inline void codec_cond_wake(codec_cond* c) { pthread_cond_broadcast(c); }
+typedef void* (*codec_thread_fn)(void*);
+#define CODEC_THREAD_FN(name) static void* name(void* arg)
+static inline codec_thread codec_thread_start(codec_thread_fn fn, void* arg)
+{ pthread_t t; pthread_create(&t, NULL, fn, arg); return t; }
+static inline void codec_thread_join(codec_thread t) { pthread_join(t, NULL); }
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void ppu_guest_call_set_stack(uint32_t sp_top);   /* runtime/ppu/ppu_loader.cpp */
+extern uint8_t* vm_base;
+#ifdef __cplusplus
+}
+#endif
+
+/* Bytes of work memory each library keeps for its thread's callback stack. */
+#define CODEC_CB_STACK 0x10000u
+
+/* Call once at the top of a library thread: callbacks it makes run on the
+ * guest stack [base, base + CODEC_CB_STACK). The ABI lets a callee store into
+ * its caller's frame above the stack pointer, so leave room at the top. */
+static inline void codec_thread_stack(uint32_t base)
+{
+    ppu_guest_call_set_stack(base + CODEC_CB_STACK - 0x200u);
+}
+
+static inline void codec_call4(uint32_t opd, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+    if (opd && g_ps3_guest_caller) g_ps3_guest_caller(opd, a0, a1, a2, a3, 0, 0, 0, 0);
+}
+
+static inline uint8_t* codec_gptr(uint32_t ea) { return vm_base + ea; }
+
+static inline void codec_put32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = codec_gptr(ea);
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static inline void codec_put16(uint32_t ea, uint16_t v)
+{
+    uint8_t* p = codec_gptr(ea); p[0] = (uint8_t)(v >> 8); p[1] = (uint8_t)v;
+}
+static inline void codec_put64(uint32_t ea, uint64_t v)
+{
+    codec_put32(ea, (uint32_t)(v >> 32)); codec_put32(ea + 4, (uint32_t)v);
+}
+static inline uint32_t codec_get32(uint32_t ea)
+{
+    const uint8_t* p = codec_gptr(ea);
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+static inline uint64_t codec_get64(uint32_t ea)
+{
+    return ((uint64_t)codec_get32(ea) << 32) | codec_get32(ea + 4);
+}
