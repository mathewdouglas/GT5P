+/* Copy the six faces into cube i, once a frame. A face that is one of the
+ * targets bound right now is skipped (it cannot be a copy source mid-pass). */
+static void rtcube_refresh(int i, int cur_rt, const int* cur_m)
+{
+    RtCube* c = &s_rtcube[i];
+    if (!c->res || c->frame == (u64)s_d3d.frame_count) return;
