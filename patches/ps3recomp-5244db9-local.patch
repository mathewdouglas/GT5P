-                                    (uint32_t)g_active_ctx->gpr[r + 1],
-                                    (uint32_t)g_active_ctx->gpr[r + 2],
-                                    (uint32_t)g_active_ctx->gpr[r + 3],
-                                    (uint32_t)g_active_ctx->gpr[r + 4],
-                                    (uint32_t)g_active_ctx->gpr[r + 5],
-                                    (uint32_t)g_active_ctx->gpr[r + 6],
