+/* PCM for one AU into slot s; pcm is planar (ch planes of n), or NULL for
+ * silence. Returns the byte size. */
+static u32 atx_fill(Atx* a, u32 s, const float* pcm, int ch, int n)
+{
+    int out = a->nch_out > 0 ? a->nch_out : (ch > 0 ? ch : 2);
+    if (out > 8) out = 8;
+    int bps = bytes_per_sample(a->bw_pcm);
+    if (n <= 0 || (u32)n > ATX_SAMPLES) n = (int)ATX_SAMPLES;
+    u8* o = codec_gptr(atx_slot_ea(a, s) + 0x80);
+    for (int i = 0; i < n; i++)
+        for (int c = 0; c < out; c++) {
+            float v = 0.0f;
+            if (pcm) {
+                if (out == 2 && ch == 6) {   /* L R C LFE Ls Rs down to two */
+                    const float* L = pcm; const float* R = pcm + n; const float* C = pcm + 2 * n;
+                    const float* Ls = pcm + 4 * n; const float* Rs = pcm + 5 * n;
+                    v = c == 0 ? L[i] + 0.7071f * (C[i] + Ls[i]) : R[i] + 0.7071f * (C[i] + Rs[i]);
+                    v *= 0.5f;
+                } else if (c < ch) v = pcm[(size_t)c * n + i];
+            }
+            put_sample(o + ((size_t)i * out + c) * bps, v, a->bw_pcm);
+        }
+    return (u32)(n * out * bps);
+}
+
+/* PcmItem: +0 pcmHandle, +4 status, +8 startAddr, +0xC size, +0x10 bsiInfo,
+ * +0x18 auInfo { startAddr, size, pts{u,l}, u64 userData }. */
+static void atx_item(Atx* a, u32 s, u32 size, const AtxCmd* c)
+{
+    u32 it = atx_slot_ea(a, s), bsi = it + 0x40;
+    memset(codec_gptr(it), 0, 0x80);
+    codec_put32(it + 0x00, s);
+    codec_put32(it + 0x04, CELL_OK);
+    codec_put32(it + 0x08, it + 0x80);
+    codec_put32(it + 0x0C, size);
+    codec_put32(it + 0x10, bsi);
+    codec_put32(it + 0x18, c->addr);
+    codec_put32(it + 0x1C, c->size);
+    codec_put64(it + 0x20, c->pts);
+    codec_put64(it + 0x28, c->user);
+    /* CellAdecAtracXInfo { samplingFreq, channelConfigIndex, nbytes } */
+    codec_put32(bsi + 0, (u32)a->freq);
+    codec_put32(bsi + 4, (u32)a->ch_cfg);
+    codec_put32(bsi + 8, (u32)a->nbytes);
+}
+
+/* Lock held; dropped while waiting for a free PCM slot. */
+static void atx_decode(Atx* a, const AtxCmd* c)
+{
+    const u8* au = codec_gptr(c->addr);
+    u32 size = c->size;
+    if (a->ats && size >= 8 && au[0] == 0x0F && au[1] == 0xD0) {
+        a->freq = k_atx_rates[au[2] >> 5];
+        a->ch_cfg = (au[2] >> 2) & 7;
+        a->nbytes = (int)(((((u32)au[2] & 3) << 8) | au[3]) + 1) * 8;
+        au += 8; size -= 8;
+    }
+    int ch = k_atx_chans[a->ch_cfg & 7];
+    if (codec_ff_available() && ch && a->nbytes &&
+        (!a->ff || a->ff_ch != ch || a->ff_block != a->nbytes)) {
+        codec_ff_close(a->ff);
+        a->ff = codec_ff_open_atrac3p(ch, a->nbytes, a->freq);
+        a->ff_ch = ch; a->ff_block = a->nbytes;
+        printf("[cellAdec] ATRAC3plus 0x%X: %d channels, %d Hz, %d-byte frames, out %d ch, word 0x%X%s\n",
+               a->handle, ch, a->freq, a->nbytes, a->nch_out, a->bw_pcm, a->ff ? "" : " (no decoder)");
+    }
+    while (a->pcm_count >= ADEC_SLOTS && !a->quit) codec_cond_wait(&a->cond, &a->lock);
+    if (a->quit) return;
+    u32 s = (a->pcm_head + a->pcm_count) % ADEC_SLOTS;
+    codec_ff_audio pcm; memset(&pcm, 0, sizeof(pcm));
+    int got = 0;
+    if (a->ff && size >= (u32)a->nbytes) {
+        codec_ff_send(a->ff, au, a->nbytes, 0, 0);
+        got = codec_ff_receive_audio(a->ff, &pcm) > 0;
+    }
+    u32 bytes = atx_fill(a, s, got ? pcm.data : NULL, got ? pcm.channels : 0,
+                         got ? pcm.samples : (int)ATX_SAMPLES);
+    codec_ff_audio_free(&pcm);
+    atx_item(a, s, bytes, c);
+    a->pcm_count++;
+    a->nau++;
+    if (atx_trace())
+        printf("[cellAdec] %lu ms 0x%X AU %llu: %u bytes pts %llX -> %u PCM bytes%s (%u queued)\n", codec_ms(), a->handle,
+               (unsigned long long)a->nau, c->size, (unsigned long long)c->pts, bytes,
+               got ? "" : " silent", a->pcm_count);
+}
+
+CODEC_THREAD_FN(atx_thread)
+{
+    Atx* a = (Atx*)arg;
+    codec_thread_stack(a->mem);
+    codec_lock_take(&a->lock);
+    while (!a->quit) {
+        if (!a->cmd_count) { codec_cond_wait(&a->cond, &a->lock); continue; }
+        AtxCmd c = a->cmd[a->cmd_head];
+        if (!c.end) atx_decode(a, &c);
+        if (a->quit) break;
+        a->cmd_head = (a->cmd_head + 1) % ADEC_CMDS;
+        a->cmd_count--;
+        if (c.end) a->seq = 0;
+        codec_cond_wake(&a->cond);
+        codec_lock_give(&a->lock);
+        if (c.end) {
+            if (a->ff) codec_ff_flush(a->ff);
+            printf("[cellAdec] 0x%X sequence done: %llu AUs\n", a->handle, (unsigned long long)a->nau);
+            atx_notify(a, CELL_ADEC_MSG_TYPE_SEQDONE, CELL_OK);
+        } else {
+            atx_notify(a, CELL_ADEC_MSG_TYPE_AUDONE, c.info);
+            atx_notify(a, CELL_ADEC_MSG_TYPE_PCMOUT, CELL_OK);
+        }
+        codec_lock_take(&a->lock);
+    }
+    codec_lock_give(&a->lock);
+    return 0;
+}
+
+/* CellAdecType { audioCodecType }; CellAdecAttr { workMemSize, adecVerUpper,
+ * adecVerLower }. */
+s32 cellAdecQueryAttr(u32 type, u32 attr)
+{
+    if (type && attr && atx_type(codec_get32(type))) {
+        codec_put32(attr + 0, ATX_MEM);
+        codec_put32(attr + 4, 0x00010000);
+        codec_put32(attr + 8, 0);
+        return CELL_OK;
+    }
+    return legacy_queryattr((const CellAdecType*)(uintptr_t)type, (void*)(uintptr_t)attr);
+}
+
+/* CellAdecResource and CellAdecResourceEx begin { u32 totalMemSize;
+ * u32 startAddr; }; CellAdecCb { cbFunc; cbArg }. */
+s32 cellAdecOpen(u32 type, u32 res, u32 cb, u32 handle)
+{
+    if (!type || !atx_type(codec_get32(type)))
+        return legacy_open((const CellAdecType*)(uintptr_t)type, (const CellAdecResource*)(uintptr_t)res,
+                           (const CellAdecCb*)(uintptr_t)cb, (CellAdecHandle*)(uintptr_t)handle);
+    if (!res || !cb || !handle) return (s32)CELL_ADEC_ERROR_ARG;
+    u32 size = codec_get32(res), mem = codec_get32(res + 4);
+    if (!mem || size < ATX_MEM) {
+        printf("[cellAdec] Open: work memory %u bytes at 0x%X, needs %u\n", size, mem, ATX_MEM);
+        return (s32)CELL_ADEC_ERROR_ARG;
+    }
+    Atx* a = NULL;
+    for (int i = 0; i < ATX_MAX; i++) if (!s_atx[i].used) { a = &s_atx[i]; break; }
+    if (!a) return (s32)CELL_ADEC_ERROR_BUSY;
+    memset(a, 0, sizeof(*a));
+    a->used = 1;
+    a->handle = mem; a->mem = mem;
+    a->type = codec_get32(type);
+    a->cb_fn = codec_get32(cb); a->cb_arg = codec_get32(cb + 4);
+    a->nch_out = a->type == ADEC_SDK_ATRACX_2CH ? 2 : a->type == ADEC_SDK_ATRACX_8CH ? 8 : 6;
+    a->bw_pcm = 0x84; a->freq = 48000;
+    codec_lock_init(&a->lock);
+    codec_cond_init(&a->cond);
+    a->thread = codec_thread_start(atx_thread, a);
+    codec_put32(handle, a->handle);
+    printf("[cellAdec] Open(ATRAC3plus type %u) -> 0x%X\n", a->type, a->handle);
+    return CELL_OK;
+}
+
+s32 cellAdecOpenEx(u32 type, u32 res, u32 cb, u32 handle) { return cellAdecOpen(type, res, cb, handle); }
+
+s32 cellAdecClose(u32 handle)
+{
+    Atx* a = atx_find(handle);
+    if (!a) return legacy_close(handle);
+    codec_lock_take(&a->lock);
+    a->quit = 1;
+    codec_cond_wake(&a->cond);
+    codec_lock_give(&a->lock);
+    codec_thread_join(a->thread);
+    codec_ff_close(a->ff);
+    codec_lock_free(&a->lock);
+    a->used = 0;
+    return CELL_OK;
+}
+
+/* CellAdecParamAtracX: +0 sampling_freq, +4 ch_config_idx, +8 nch_out,
+ * +0xC nbytes, +0x10 extra_config_data[4], +0x14 bw_pcm, +0x18 u8 downmix_flag,
+ * +0x19 u8 au_includes_ats_hdr_flg. */
+s32 cellAdecStartSeq(u32 handle, u32 param)
+{
+    Atx* a = atx_find(handle);
+    if (!a) return legacy_startseq(handle, (void*)(uintptr_t)param);
+    codec_lock_take(&a->lock);
+    if (param) {
+        s32 f = (s32)codec_get32(param);
+        if (f > 0) a->freq = f;
+        a->ch_cfg = (int)codec_get32(param + 4);
+        a->nch_out = (int)codec_get32(param + 8);
+        a->nbytes = (int)codec_get32(param + 0xC);
+        a->bw_pcm = (int)codec_get32(param + 0x14);
+        a->downmix = codec_gptr(param + 0x18)[0];
+        a->ats = codec_gptr(param + 0x19)[0];
+    }
+    a->seq = 1;
+    a->nau = 0;
+    codec_lock_give(&a->lock);
+    printf("[cellAdec] StartSeq 0x%X: out %d ch, word 0x%X, ATS headers %d\n", handle, a->nch_out,
+           a->bw_pcm, a->ats);
+    return CELL_OK;
+}
+
+static s32 atx_queue(Atx* a, const AtxCmd* c)
+{
+    codec_lock_take(&a->lock);
+    if (!a->seq) { codec_lock_give(&a->lock); return (s32)CELL_ADEC_ERROR_SEQ; }
+    if (a->cmd_count >= ADEC_CMDS) { codec_lock_give(&a->lock); return (s32)CELL_ADEC_ERROR_BUSY; }
+    a->cmd[(a->cmd_head + a->cmd_count) % ADEC_CMDS] = *c;
+    a->cmd_count++;
+    codec_cond_wake(&a->cond);
+    codec_lock_give(&a->lock);
+    return CELL_OK;
+}
+
+s32 cellAdecEndSeq(u32 handle)
+{
+    Atx* a = atx_find(handle);
+    if (!a) return legacy_endseq(handle);
+    AtxCmd c; memset(&c, 0, sizeof(c)); c.end = 1;
+    return atx_queue(a, &c);
+}
+
+/* CellAdecAuInfo: +0 startAddr, +4 size, +8 pts{u,l}, +0x10 u64 userData. */
+s32 cellAdecDecodeAu(u32 handle, u32 auInfo)
+{
+    Atx* a = atx_find(handle);
+    if (!a) return legacy_decodeau(handle, (const CellAdecAuInfo*)(uintptr_t)auInfo);
+    if (!auInfo) return (s32)CELL_ADEC_ERROR_ARG;
+    AtxCmd c; memset(&c, 0, sizeof(c));
+    c.info = auInfo;
+    c.addr = codec_get32(auInfo); c.size = codec_get32(auInfo + 4);
+    c.pts = codec_get64(auInfo + 8); c.user = codec_get64(auInfo + 0x10);
+    return atx_queue(a, &c);
+}
+
+s32 cellAdecGetPcm(u32 handle, u32 outBuffer)
+{
+    Atx* a = atx_find(handle);
+    if (!a) return legacy_getpcm(handle, (void*)(uintptr_t)outBuffer);
+    codec_lock_take(&a->lock);
+    if (!a->pcm_count) { codec_lock_give(&a->lock); return (s32)CELL_ADEC_ERROR_EMPTY; }
+    u32 it = atx_slot_ea(a, a->pcm_head);
+    if (outBuffer) memcpy(codec_gptr(outBuffer), codec_gptr(it + 0x80), codec_get32(it + 0x0C));
+    if (atx_trace()) printf("[cellAdec] %lu ms 0x%X GetPcm -> 0x%X\n", codec_ms(), handle, outBuffer);
+    a->pcm_head = (a->pcm_head + 1) % ADEC_SLOTS;
+    a->pcm_count--;
+    codec_cond_wake(&a->cond);
+    codec_lock_give(&a->lock);
+    return CELL_OK;
+}
+
+s32 cellAdecGetPcmItem(u32 handle, u32 pcmItem)
+{
+    Atx* a = atx_find(handle);
+    if (!a) return legacy_getpcmitem(handle, (const CellAdecPcmItem**)(uintptr_t)pcmItem);
+    if (!pcmItem) return (s32)CELL_ADEC_ERROR_ARG;
+    codec_lock_take(&a->lock);
+    if (!a->pcm_count) { codec_lock_give(&a->lock); return (s32)CELL_ADEC_ERROR_EMPTY; }
+    u32 it = atx_slot_ea(a, a->pcm_head);
+    codec_lock_give(&a->lock);
+    codec_put32(pcmItem, it);
+    return CELL_OK;
+}
