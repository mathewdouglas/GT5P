+/* Print what DRED recorded at a device removal (RSX_DRED=1): for each
+ * command list the GPU had not finished, the operations around the last one
+ * it completed, and the draw marker before it; then the page fault, if any. */
+static void dred_report(void)
+{
+    ID3D12DeviceRemovedExtendedData1* dred = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->QueryInterface(s_d3d.device, &IID_ID3D12DeviceRemovedExtendedData1,
+                                                    (void**)&dred)) || !dred) {
+        fprintf(stderr, "[DRED] no ID3D12DeviceRemovedExtendedData1\n"); return;
+    }
+    D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT1 bo = {0};
