+        /* Two passes: performance cores (highest class) skipping core 0, then any. */
+        for (int pass = 0; pass < 2 && PPU_TOPO_MORE(); pass++)
+            for (int i = 0; i < nc && PPU_TOPO_MORE(); i++) {
+                if (mask & c[i].first) continue;
+                if (pass == 0 && (c[i].cls != maxcls || (i == 0 && nc >= 3))) continue;
