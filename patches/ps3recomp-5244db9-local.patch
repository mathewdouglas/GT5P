+/* SPURS_KERN_STAT=1: every two seconds, which workload the kernel thread is
+ * inside and for how long, each workload's ready count and how often it has
+ * been dispatched. One job that never returns stops every other workload,
+ * because the modules are run one after another on this thread. */
+static volatile LONG s_kstat_cur = -1;
+static volatile ULONGLONG s_kstat_since;
+static volatile LONG s_kstat_runs[CELL_SPURS_MAX_WORKLOAD];
+static volatile u32 s_kstat_ea;
+static DWORD WINAPI spurs_kstat_thread(LPVOID unused)
+{
+    (void)unused;
+    for (;;) {
+        Sleep(2000);
+        u32 ea = s_kstat_ea; LONG cur = s_kstat_cur;
+        if (!ea) continue;
+        fprintf(stderr, "[spurs-stat] in wid=%ld for %llu ms; runs/ready:", (long)cur,
+                cur >= 0 ? (unsigned long long)(GetTickCount64() - s_kstat_since) : 0ull);
+        for (u32 w = 0; w < 6; w++)
+            fprintf(stderr, " %u:%ld/%u", w, (long)s_kstat_runs[w], *(vm_base + ea + SPURS_WKL_READY1 + w));
+        fprintf(stderr, " busy:");
+        for (u32 w = 0; w < 6; w++) fprintf(stderr, "%ld", (long)s_wkl_group[w].busy);
+        fprintf(stderr, "%c", 10);
+        /* SPURS_KERN_STAT=<hex ea>: also the 0xC0 bytes there (a job manager's
+         * header: list pointers at +0x30, per-SPU progress rows from +0x40). */
+        { static u32 dump_ea[4]; static int dump_n = -1;
+          if (dump_n < 0) { const char* e = getenv("SPURS_KERN_STAT"); dump_n = 0;
+              while (e && *e && dump_n < 4) { char* end; u32 v = (u32)strtoul(e, &end, 16);
+                  if (v > 0x10000) dump_ea[dump_n++] = v;
+                  if (*end != ',') break; e = end + 1; } }
+          for (int d = 0; d < dump_n; d++)
+              for (u32 o = 0x30; o < 0x80; o += 16) {      /* list pointers, then the four rows */
+                  const u8* q = vm_base + dump_ea[d] + o;
+                  fprintf(stderr, "  %08X:", dump_ea[d] + o);
+                  for (int k = 0; k < 16; k++) fprintf(stderr, "%s%02X", (k & 3) ? "" : " ", q[k]);
+                  fprintf(stderr, "%c", 10);
+              } }
+        fflush(stderr);
+    }
+}
