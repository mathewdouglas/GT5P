diff --git a/runtime/ppu/ppu_vm_inline.h b/runtime/ppu/ppu_vm_inline.h
new file mode 100644
index 00000000..96051f6e
--- /dev/null
+++ b/runtime/ppu/ppu_vm_inline.h
@@ -0,0 +1,170 @@
+/*
+ * ps3recomp - guest loads and stores, inline in the lifted code
+ *
+ * The lifted PPU code makes every scalar load and store through the extern
+ * vm_read8..64 / vm_write8..64 in ppu_loader.cpp (floats too: lfs/stfd go
+ * through vm_read32/64 and a memcpy). Even on their fast path each one is a
+ * call that tests the diagnostic mode, the bounds, the null page, the raw SPU
+ * register window and, on a store, calls spu_coh_is_reserved in another file.
+ * A store is one host instruction's worth of work behind all of that, and the
+ * call itself costs the lifted function its registers. On GT5 Prologue's
+ * dealership vm_write64 alone was 14% of the main thread.
+ *
+ * This header gives the lifted code inline forms that do the same thing in
+ * the common case and hand everything else to the out-of-line function,
+ * unchanged:
+ *
+ *   load:  one range test, then a byte-swapped load from vm_base + addr.
+ *   store: the same range test and the SPU lock-line bitmap test, then a
+ *          byte-swapped store.
+ *
+ * The range test is (addr - 0x10000) < g_vm_inline_span. Below 0x10000 is the
+ * null page, where loads are reported and stores dropped; 0xE0000000 and up
+ * holds the raw SPU problem-state registers, whose loads and stores have side
+ * effects. Both go out of line. vm_read32 also sends the GCM ref register
+ * (ppu_hle_inject_base + 0x2008) out of line, because a poll of it publishes a
+ * fence there (GCM_REFPOLL). A store to a line an SPU has reserved goes out of
+ * line, where it is committed under the lock-line lock and the reserving SPU
+ * is told (spu_coherency.c).
+ *
+ * g_vm_inline_span is 0 until the first out-of-line access has read the
+ * switches (vm_fast_init), and stays 0 -- every access out of line, exactly as
+ * before -- under VM_INLINE=0, VM_SLOW=1, any of the watch and spin switches
+ * the full path serves (PPU_WWATCH, PPU_RWATCH, PPU_HOTREAD, ...),
+ * PS3_NULL_SWEEP, SPU_ATOM_EA, or a bounded VM (ppu_vm_size set), where it is
+ * cut to the mapped size instead.
+ *
+ * How it reaches the lifted code: the generated ppu_recomp.h declares the
+ * accessors itself, so this header is force-included ahead of it (/FI, or
+ * -include) and renames the lifted code's calls with function-like macros.
+ * The declarations in ppu_recomp.h then become redeclarations of the static
+ * inline functions here, which C and C++ both allow (they keep internal
+ * linkage). Include it nowhere else: HLE code has its own inline family in
+ * ppu_memory.h with the same names.
+ */
+#ifndef PPU_VM_INLINE_H
+#define PPU_VM_INLINE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The out-of-line accessors (ppu_loader.cpp). Declared here, before the macros
+ * below, so these names stay the real functions the inline forms call. */
+uint8_t  vm_read8 (uint64_t addr);
+uint16_t vm_read16(uint64_t addr);
+uint32_t vm_read32(uint64_t addr);
+uint64_t vm_read64(uint64_t addr);
+void     vm_write8 (uint64_t addr, uint8_t  val);
+void     vm_write16(uint64_t addr, uint16_t val);
+void     vm_write32(uint64_t addr, uint32_t val);
+void     vm_write64(uint64_t addr, uint64_t val);
+
+extern uint8_t*      vm_base;
+extern uint32_t      ppu_hle_inject_base;   /* GCM control block (cellGcmSys.c) */
+extern uint32_t      g_vm_inline_span;      /* ppu_loader.cpp; 0 = all out of line */
+extern int           g_spu_coh_armed;       /* spu_coherency.c */
+extern unsigned char g_spu_coh_bitmap[];    /* spu_coherency.c, a bit per 128 B line */
+
+#define PPU_VM_INLINE_LO 0x10000u
+
+/* [0x10000, 0x10000 + span): plain memory, no special handling. */
+static inline int ppu_vm_inl_plain(uint32_t ea)
+{
+    return (uint32_t)(ea - PPU_VM_INLINE_LO) < g_vm_inline_span;
+}
+
+/* spu_coh_is_reserved, inline: the same two loads against the same state. */
+static inline int ppu_vm_inl_coh(uint32_t ea)
+{
+    if (!g_spu_coh_armed) return 0;
+    uint32_t line = ea >> 7;
+    return (g_spu_coh_bitmap[line >> 3] >> (line & 7)) & 1u;
+}
+
+/* Each access is volatile, as each one was a call before: a call into another
+ * file was a compiler barrier, so a guest spin on a flag re-read it every pass
+ * and a store was never moved past a later load of another address. Plain
+ * inline accesses would let the compiler hoist a polled load out of its loop
+ * (the lifted loop has no call left in it) or sink a store past one, and a
+ * guest waiting on another thread would never see the change. Volatile keeps
+ * every guest access, in program order, which is all the calls guaranteed.
+ * The types are unaligned because PPC loads and stores need not be aligned. */
+#if defined(__GNUC__) || defined(__clang__)
+typedef uint16_t __attribute__((aligned(1), may_alias)) ppu_vm_u16;
+typedef uint32_t __attribute__((aligned(1), may_alias)) ppu_vm_u32;
+typedef uint64_t __attribute__((aligned(1), may_alias)) ppu_vm_u64;
+#else
+typedef uint16_t ppu_vm_u16;   /* MSVC on x64: an unaligned mov is fine */
+typedef uint32_t ppu_vm_u32;
+typedef uint64_t ppu_vm_u64;
+#endif
+
+static inline uint8_t ppu_vm_ld8(uint64_t a)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea), 0)) return vm_read8(a);
+    return *(volatile const uint8_t*)(vm_base + ea);
+}
+static inline uint16_t ppu_vm_ld16(uint64_t a)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea), 0)) return vm_read16(a);
+    return __builtin_bswap16(*(volatile const ppu_vm_u16*)(vm_base + ea));
+}
+static inline uint32_t ppu_vm_ld32(uint64_t a)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea) || ea == ppu_hle_inject_base + 0x2008u, 0))
+        return vm_read32(a);
+    return __builtin_bswap32(*(volatile const ppu_vm_u32*)(vm_base + ea));
+}
+static inline uint64_t ppu_vm_ld64(uint64_t a)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea), 0)) return vm_read64(a);
+    return __builtin_bswap64(*(volatile const ppu_vm_u64*)(vm_base + ea));
+}
+
+static inline void ppu_vm_st8(uint64_t a, uint8_t v)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea) || ppu_vm_inl_coh(ea), 0)) { vm_write8(a, v); return; }
+    *(volatile uint8_t*)(vm_base + ea) = v;
+}
+static inline void ppu_vm_st16(uint64_t a, uint16_t v)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea) || ppu_vm_inl_coh(ea), 0)) { vm_write16(a, v); return; }
+    *(volatile ppu_vm_u16*)(vm_base + ea) = __builtin_bswap16(v);
+}
+static inline void ppu_vm_st32(uint64_t a, uint32_t v)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea) || ppu_vm_inl_coh(ea), 0)) { vm_write32(a, v); return; }
+    *(volatile ppu_vm_u32*)(vm_base + ea) = __builtin_bswap32(v);
+}
+static inline void ppu_vm_st64(uint64_t a, uint64_t v)
+{
+    uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(!ppu_vm_inl_plain(ea) || ppu_vm_inl_coh(ea), 0)) { vm_write64(a, v); return; }
+    *(volatile ppu_vm_u64*)(vm_base + ea) = __builtin_bswap64(v);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+/* After the definitions, so their bodies still call the real functions. */
+#define vm_read8(a)       ppu_vm_ld8(a)
+#define vm_read16(a)      ppu_vm_ld16(a)
+#define vm_read32(a)      ppu_vm_ld32(a)
+#define vm_read64(a)      ppu_vm_ld64(a)
+#define vm_write8(a, v)   ppu_vm_st8(a, v)
+#define vm_write16(a, v)  ppu_vm_st16(a, v)
+#define vm_write32(a, v)  ppu_vm_st32(a, v)
+#define vm_write64(a, v)  ppu_vm_st64(a, v)
+
+#endif /* PPU_VM_INLINE_H */
