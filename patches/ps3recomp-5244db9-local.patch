+static spurs_rt_ent g_rt[16][6][RT_N];
+static unsigned g_rt_n[16][6];
+static unsigned g_rt_seq;
+void spurs_ring_trace(const spu_context* c, uint32_t head, uint32_t want,
+                      uint32_t label, uint32_t lab_ea, int wait)
+{
+    for (int w = 0; w < 16; w++)
