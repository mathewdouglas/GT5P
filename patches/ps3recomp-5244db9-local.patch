+static volatile LONG s_ms_n = 0, s_ms_lock = 0;
+static ULONGLONG s_ms_base = 0;
+static volatile ULONGLONG s_pad_t0 = 0;   /* PAD_HOLD's clock, 0 until the first poll */
+
+void (*g_pad_milestone_hook)(const char*) = NULL;
+/* A second listener, for the port's own overlay (which screen the title is
