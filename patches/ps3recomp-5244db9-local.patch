+void ps3_tl_rec(char kind, uint32_t a, uint32_t b)
+{
+    LONG i = InterlockedIncrement(&s_tl_n) - 1;
+    if (i >= s_tl_cap) return;
+    TlEv* e = &s_tl[i];
+    e->us = ps3_tl_us(); e->tid = GetCurrentThreadId(); e->a = a; e->b = b; e->kind = kind;
+}
+static void tl_dump(void)
+{
+    const char* path = getenv("PS3_TIMELINE_OUT");
+    FILE* f = fopen(path && *path ? path : "timeline.csv", "w");
+    if (!f) return;
+    LONG n = s_tl_n < s_tl_cap ? s_tl_n : s_tl_cap;
+    DWORD tids[256]; int nt = 0;
+    for (LONG i = 0; i < n; i++) {
+        TlEv* e = &s_tl[i];
+        fprintf(f, "%llu,%lu,%c,%u,%u\n", (unsigned long long)(e->us - s_tl_start),
+                (unsigned long)e->tid, e->kind, e->a, e->b);
+        int k = 0; while (k < nt && tids[k] != e->tid) k++;
+        if (k == nt && nt < 256) tids[nt++] = e->tid;
+    }
+    typedef HRESULT (WINAPI *GTD)(HANDLE, PWSTR*);
+    GTD gtd = (GTD)(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetThreadDescription");
+    for (int k = 0; k < nt; k++) {
+        char name[128] = "?";
