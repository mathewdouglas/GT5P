+/* ===========================================================================
+ * Channel write
+ * ===========================================================================*/
+/* User events this host thread has delivered (send_event/throw_event on a
+ * port the application attached). cellSpurs.c compares it around each job a
+ * chain runs: a job that sent its own completion needs no stand-in. */
+#ifdef _WIN32
+__declspec(thread) unsigned g_spu_user_events_sent;
+#else
+__thread unsigned g_spu_user_events_sent;
+#endif
