+    if (!hlsl || strlen(hlsl) >= capacity) return -1;
+    int count = 0;
+    for (char* p = hlsl; (p = strstr(p, "rsx_samp")) != NULL;) {
+        char* end = p + 8;
+        int array = *end == '[';
+        if (array) end++;
+        char* digits = end;
+        u32 unit = 0;
+        while (*end >= '0' && *end <= '9') { unit = unit * 10 + (u32)(*end - '0'); end++; }
+        if (end == digits || unit >= 16 || (array ? *end != ']' : *end != ',')) {
+            p += 8;
+            continue;
+        }
+        if (array) end++;
+        char replacement[24];
+        int n = snprintf(replacement, sizeof replacement, array ? "rsx_samp[%u]" : "rsx_samp%u",
+                         (u32)(bank >> (4 * unit)) & 15u);
+        const size_t tail = strlen(end) + 1;
+        if ((size_t)(p - hlsl) + (size_t)n + tail > capacity) return -1;
+        memmove(p + n, end, tail);
+        memcpy(p, replacement, (size_t)n);
+        p += n; /* Never remap the sampler register we just wrote. */
+        count++;
+    }
