+/* Cube textures whose faces the title renders. GT5 Prologue keeps its car
+ * environment map as six linear 256x256 faces, each a separate surface with
+ * its mip chain stacked below level 0 at the same pitch (511 rows), and
+ * rebuilds the mips every frame with draws into those surfaces. The cube unit
+ * therefore resolves to a render target, and binding that one 2D face to the
+ * shader's TextureCube gave the car paint no usable reflection. Each such cube
+ * gets a real cube resource; the first draw of a frame that samples it copies
+ * every face and level into it (by then the frame's mip draws are done).
+ * RSX_CUBE_RT=0 binds the face target as before. */
+typedef struct { u32 raw, w, mips, dxgi; ID3D12Resource* res; u64 frame; } RtCube;
+#define RTCUBE_MAX 4
+static RtCube s_rtcube[RTCUBE_MAX];
