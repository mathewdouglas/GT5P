diff --git a/CMakeLists.txt b/CMakeLists.txt
index f843504e..d3b022b2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -80,6 +80,17 @@ file(GLOB AT3_SOURCES "third_party/at3_standalone/*.cpp")
 set_source_files_properties(${AT3_SOURCES} PROPERTIES COMPILE_OPTIONS "-w")  # upstream code
 list(APPEND HLE_SOURCES ${AT3_SOURCES})
 
+# cellVdec / cellAdec decode movies with FFmpeg (libavcodec), loaded at run
+# time. Only codec_ffmpeg.c sees its headers, and only when a port passes them:
+#   set(PS3RECOMP_FFMPEG_INCLUDE <dir with libavcodec/avcodec.h>)
+# Without it the movie libraries give black pictures and silence.
+if(PS3RECOMP_FFMPEG_INCLUDE AND EXISTS "${PS3RECOMP_FFMPEG_INCLUDE}/libavcodec/avcodec.h")
+    set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/libs/codec/codec_ffmpeg.c" PROPERTIES
+        INCLUDE_DIRECTORIES "${PS3RECOMP_FFMPEG_INCLUDE}"
+        COMPILE_DEFINITIONS PS3RECOMP_HAVE_FFMPEG)
+    message(STATUS "ps3recomp: movie decoding with FFmpeg headers from ${PS3RECOMP_FFMPEG_INCLUDE}")
+endif()
+
 # Runtime core (syscalls, PPU, SPU, memory)
 file(GLOB_RECURSE RUNTIME_SOURCES
     "runtime/*.c"
diff --git a/include/ps3emu/getenv_cache.h b/include/ps3emu/getenv_cache.h
new file mode 100644
index 00000000..36e18e04
--- /dev/null
+++ b/include/ps3emu/getenv_cache.h
@@ -0,0 +1,24 @@
+/* Per-call-site cache for getenv in hot paths.
+ *
+ * The D3D12 backend, the FIFO walker and the HLE dispatcher test dozens of
+ * debug switches per draw or per call with a bare getenv. On Windows each call
+ * takes the CRT environment lock and scans the whole environment block; at GT5
+ * Prologue's 4,300 draws a frame that was a third of the present thread's time
+ * on the showroom page (Phase 43).
+ *
+ * Including this after the system headers turns each `getenv("LITERAL")` into
+ * one real lookup per call site, the first time it runs. Only for files whose
+ * every getenv takes a string literal, and only for switches set before the
+ * process starts: a value changed with _putenv later is not seen. Define
+ * PS3EMU_GETENV_LIVE before including it to turn the cache off. */
+#ifndef PS3EMU_GETENV_CACHE_H
+#define PS3EMU_GETENV_CACHE_H
+#include <stdlib.h>
+#ifndef PS3EMU_GETENV_LIVE
+#define getenv(name) (__extension__ ({                                       \
+    static char* volatile ps3_ge_v_ = (char*)1;                            \
+    char* ps3_ge_r_ = ps3_ge_v_;                                           \
+    if (ps3_ge_r_ == (char*)1) { ps3_ge_r_ = getenv(name); ps3_ge_v_ = ps3_ge_r_; } \
+    ps3_ge_r_; }))
+#endif
+#endif
diff --git a/include/ps3emu/thread_name.h b/include/ps3emu/thread_name.h
new file mode 100644
index 00000000..25e3db33
--- /dev/null
+++ b/include/ps3emu/thread_name.h
@@ -0,0 +1,17 @@
+/* Name the calling host thread, for debuggers and profilers (GetThreadDescription).
+ * SetThreadDescription is Windows 10 1607 and later, so it is looked up rather
+ * than linked; elsewhere this does nothing. */
+#pragma once
+#ifdef _WIN32
+#include <windows.h>
+static inline void ps3_name_thread(const wchar_t* name)
+{
+    typedef HRESULT (WINAPI *SetDesc)(HANDLE, PCWSTR);
+    static SetDesc set = (SetDesc)-1;
+    if (set == (SetDesc)-1)
+        set = (SetDesc)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription");
+    if (set) set(GetCurrentThread(), name);
+}
+#else
+static inline void ps3_name_thread(const wchar_t* name) { (void)name; }
+#endif
diff --git a/include/ps3emu/timeline.h b/include/ps3emu/timeline.h
new file mode 100644
index 00000000..e3700ff5
--- /dev/null
+++ b/include/ps3emu/timeline.h
@@ -0,0 +1,35 @@
+/*
+ * ps3recomp - a timeline of one stretch of a run, for finding what a frame
+ * waits on.
+ *
+ * PS3_TIMELINE=<start_s>,<length_s>: from <start_s> seconds after launch,
+ * for <length_s> seconds, record events into memory, then write them to
+ * PS3_TIMELINE_OUT (default timeline.csv in the working directory) as
+ * "us,host_tid,kind,a,b" lines, followed by "#thread <tid> <name>" lines.
+ * Kinds, with a and b:
+ *   Y  lv2 syscall that blocked over 100 us   (number, us)
+ *   H  HLE call that blocked over 100 us      (NID, us)
+ *   K  SPURS ready-count store                 (wid, value)
+ *   D  kernel dispatches a workload            (wid, lanes)
+ *   E  the dispatch returns                    (wid, us)
+ *   L  one policy-module run on a lane         (wid << 8 | spu, us)
+ *   W  GetWorkloadInfo's answer changed        (wid, contention << 8 | ready)
+ *   F  the title asks for a flip               (buffer, 0)
+ *   P  the present thread presented            (0, us spent presenting)
+ * Off, each hook is one load of g_tl_on.
+ */
+#ifndef PS3EMU_TIMELINE_H
+#define PS3EMU_TIMELINE_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern volatile int g_tl_on;
+void     ps3_tl_rec(char kind, uint32_t a, uint32_t b);
+uint64_t ps3_tl_us(void);      /* microseconds, for measuring a span */
+void     ps3_tl_tick(void);    /* starts and ends the window; call often */
+static inline void ps3_tl(char kind, uint32_t a, uint32_t b) { if (g_tl_on) ps3_tl_rec(kind, a, b); }
+#ifdef __cplusplus
+}
+#endif
+#endif
