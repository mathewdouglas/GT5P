+static int pad_sdl_dyn_init(void)
+{
+    static int tried = 0;
+    if (tried) return s_sdl_ok;
+    tried = 1;
+    if (getenv("PAD_NO_SDL")) return 0;
+    HMODULE m = LoadLibraryA("SDL2.dll");
+    if (!m) {
+        printf("[cellPad] SDL2.dll not found: XInput controllers and the keyboard only%c", 10);
+        return 0;
+    }
+    s_sdl.dll = m;
+#define PAD_SDL_FN(field, name) \
+    *(FARPROC*)&s_sdl.field = GetProcAddress(m, name); \
+    if (!s_sdl.field) { printf("[cellPad] SDL2.dll has no %s; not using it%c", name, 10); return 0; }
+    PAD_SDL_FN(Init, "SDL_Init")
+    PAD_SDL_FN(SetMainReady, "SDL_SetMainReady")
+    PAD_SDL_FN(SetHint, "SDL_SetHint")
+    PAD_SDL_FN(NumJoysticks, "SDL_NumJoysticks")
+    PAD_SDL_FN(IsGameController, "SDL_IsGameController")
+    PAD_SDL_FN(GameControllerOpen, "SDL_GameControllerOpen")
+    PAD_SDL_FN(GameControllerClose, "SDL_GameControllerClose")
+    PAD_SDL_FN(GameControllerGetAttached, "SDL_GameControllerGetAttached")
+    PAD_SDL_FN(GameControllerUpdate, "SDL_GameControllerUpdate")
+    PAD_SDL_FN(PumpEvents, "SDL_PumpEvents")
+    PAD_SDL_FN(FlushEvents, "SDL_FlushEvents")
+    PAD_SDL_FN(GameControllerGetButton, "SDL_GameControllerGetButton")
+    PAD_SDL_FN(GameControllerGetAxis, "SDL_GameControllerGetAxis")
+    PAD_SDL_FN(GameControllerName, "SDL_GameControllerName")
+    PAD_SDL_FN(JoystickGetDeviceInstanceID, "SDL_JoystickGetDeviceInstanceID")
+    PAD_SDL_FN(GameControllerGetJoystick, "SDL_GameControllerGetJoystick")
+    PAD_SDL_FN(JoystickInstanceID, "SDL_JoystickInstanceID")
+    PAD_SDL_FN(GetError, "SDL_GetError")
+#undef PAD_SDL_FN
+    *(FARPROC*)&s_sdl.GameControllerGetType = GetProcAddress(m, "SDL_GameControllerGetType");
+    /* Watch OS device notifications in SDL's joystick thread; the owner below
+     * pumps SDL events and reads input for our native (non-SDL) window. */
+    s_sdl.SetHint("SDL_JOYSTICK_THREAD", "1");
+    s_sdl.SetHint("SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS", "1");
+    s_sdl.SetHint("SDL_JOYSTICK_HIDAPI_PS5", "1");
+    s_sdl.SetHint("SDL_JOYSTICK_HIDAPI_PS4", "1");
+    s_sdl.SetMainReady();
+    if (s_sdl.Init(0x00002000u /* SDL_INIT_GAMECONTROLLER */) != 0) {
+        printf("[cellPad] SDL_Init failed: %s%c", s_sdl.GetError(), 10);
+        return 0;
+    }
+    printf("[cellPad] SDL2 loaded: controllers are read through SDL%c", 10);
+    fflush(stdout);
+    s_sdl_ok = 1;
+    return 1;
+}
