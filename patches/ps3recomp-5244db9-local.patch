+    f->ext_set = 0;
+    if (FAILED(s_copy_alloc->lpVtbl->Reset(s_copy_alloc)) ||
+        FAILED(s_copy_list->lpVtbl->Reset(s_copy_list, s_copy_alloc, NULL))) {
