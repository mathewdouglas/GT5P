-
-s32 cellAdecDecodeAu(CellAdecHandle handle, const CellAdecAuInfo* auInfo);
-
-s32 cellAdecGetPcm(CellAdecHandle handle, void* outBuffer);
-s32 cellAdecGetPcmItem(CellAdecHandle handle, const CellAdecPcmItem** pcmItem);
+/* All pointer arguments are guest addresses. ATRAC3plus (audioCodecType
+ * ATRACX, ATRACX_2CH/6CH/8CH) decodes on a thread of its own with FFmpeg;
+ * every other type keeps the synchronous, silent decoder above. */
+#define ADEC_SDK_ATRACX      3    /* the SDK numbering titles pass */
+#define ADEC_SDK_ATRACX_2CH  13
+#define ADEC_SDK_ATRACX_6CH  14
+#define ADEC_SDK_ATRACX_8CH  15
+
+s32 cellAdecQueryAttr(u32 type, u32 attr);
+s32 cellAdecOpen(u32 type, u32 res, u32 cb, u32 handle);
+s32 cellAdecOpenEx(u32 type, u32 res, u32 cb, u32 handle);
