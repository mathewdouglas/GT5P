+    case 85:  /* sys_event_flag_wait */        case 92:  /* sys_semaphore_wait */
+    case 97:  /* sys_lwmutex_lock */           case 102: /* sys_mutex_lock */
+    case 107: /* sys_cond_wait */              case 113: /* sys_lwcond_queue_wait */
+    case 122: /* sys_rwlock_rlock */           case 125: /* sys_rwlock_wlock */
+    case 130: /* sys_event_queue_receive */    case 141: /* sys_timer_usleep */
