+/* Resources of an old size, released once the GPU is surely done with them. */
+static void overlay_retire(void)
+{
+    for (int i = 0; i < 4; i++) {
+        ID3D12Resource* r = i == 0 ? s_ov_tex : s_ov_up[i - 1];
+        if (r) { if (s_ov_dead[i]) s_ov_dead[i]->lpVtbl->Release(s_ov_dead[i]); s_ov_dead[i] = r; }
+    }
+    s_ov_tex = s_ov_up[0] = s_ov_up[1] = s_ov_up[2] = NULL;
+    s_ov_dead_age = 0;
+}
