--- a/libs/misc/cellMusicDecode2.c
+++ b/libs/misc/cellMusicDecode2.c
@@ -74,3 +74,96 @@ s32 cellMusicDecode2SetSelectionContext(const void* ctx)
     if (!s_initialized2) return (s32)CELL_MUSIC_DECODE2_ERROR_NOT_INITIALIZED;
     return (s32)CELL_MUSIC_DECODE2_ERROR_NOT_SUPPORTED;
 }
+
+/* ---------------------------------------------------------------------------
+ * cellMusicDecodeUtility's "2" API, as titles import it (cellMusicDecode*2).
+ * The functions above use names no title imports, so Gran Turismo 5's
+ * cellMusicDecodeInitialize2 went unresolved: it returned "success", the
+ * title waited for the initialise result on its callback and never got it
+ * (a black screen after the first-boot save). This is a console with no
+ * custom soundtrack: initialise and finalise succeed, and selecting,
+ * decoding and reading report that no content is active. Results reach the
+ * title's callback at its next cellSysutilCheckCallback, as on the console.
+ * CELL_MUSIC_DECODE2_CB=0: return without calling back (the old hang).
+ * ------------------------------------------------------------------------*/
+#include "../system/cellSysutil.h"
+#include <stdlib.h>
+
+enum {
+    MUSIC2_EVENT_INITIALIZE_RESULT = 1,
+    MUSIC2_EVENT_FINALIZE_RESULT = 2,
+    MUSIC2_EVENT_SELECT_CONTENTS_RESULT = 3,
+    MUSIC2_EVENT_SET_DECODE_COMMAND_RESULT = 4,
+    MUSIC2_EVENT_SET_SELECTION_CONTEXT_RESULT = 5,
+};
+#define MUSIC2_ERROR_NO_ACTIVE_CONTENT 0x8002C103u
+
+static u32 s_music2_cb, s_music2_user;
+static int s_music2_init;
+
+static void music2_post(u32 event, u32 result)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("CELL_MUSIC_DECODE2_CB"); on = !(e && *e == '0'); }
+    printf("[cellMusicDecode2] event %u result 0x%08X%s\n", event, result, on ? "" : " (not delivered)");
+    if (!on || !s_music2_cb) return;
+    const u64 args[8] = { event, result, s_music2_user, 0, 0, 0, 0, 0 };
+    cellSysutilQueueGuestCallbackArgs(s_music2_cb, args);
+}
+
+s32 cellMusicDecodeInitialize2(u32 mode, u32 container, u32 spuPriority, u32 func,
+                               u32 userData, u32 speed, u32 bufSize)
+{
+    printf("[cellMusicDecode2] Initialize2(mode=%u container=0x%X prio=%u func=0x%08X user=0x%08X speed=%u buf=0x%X)\n",
+           mode, container, spuPriority, func, userData, speed, bufSize);
+    if (!func) return (s32)0x8002C101u;   /* PARAM */
+    s_music2_cb = func; s_music2_user = userData; s_music2_init = 1;
+    /* Test-script milestone (cellPad.c): Gran Turismo 5 does this as its
+     * main menu loads, on every boot. */
+    { extern void pad_milestone_mark(const char*); pad_milestone_mark("MusicDecode"); }
+    music2_post(MUSIC2_EVENT_INITIALIZE_RESULT, CELL_OK);
+    return CELL_OK;
+}
+
+s32 cellMusicDecodeFinalize2(void)
+{
+    printf("[cellMusicDecode2] Finalize2()\n");
+    music2_post(MUSIC2_EVENT_FINALIZE_RESULT, CELL_OK);
+    s_music2_init = 0;
+    return CELL_OK;
+}
+
+s32 cellMusicDecodeSelectContents2(void)
+{
+    music2_post(MUSIC2_EVENT_SELECT_CONTENTS_RESULT, MUSIC2_ERROR_NO_ACTIVE_CONTENT);
+    return CELL_OK;
+}
+
+s32 cellMusicDecodeSetDecodeCommand2(s32 command)
+{
+    printf("[cellMusicDecode2] SetDecodeCommand2(%d)\n", command);
+    music2_post(MUSIC2_EVENT_SET_DECODE_COMMAND_RESULT, MUSIC2_ERROR_NO_ACTIVE_CONTENT);
+    return CELL_OK;
+}
+
+s32 cellMusicDecodeGetSelectionContext2(u32 context)
+{
+    (void)context;
+    return (s32)MUSIC2_ERROR_NO_ACTIVE_CONTENT;
+}
+
+s32 cellMusicDecodeSetSelectionContext2(u32 context)
+{
+    (void)context;
+    music2_post(MUSIC2_EVENT_SET_SELECTION_CONTEXT_RESULT, MUSIC2_ERROR_NO_ACTIVE_CONTENT);
+    return CELL_OK;
+}
+
+s32 cellMusicDecodeRead2(u32 buf, u32 startTime, u64 reqSize, u32 readSize, u32 speed, u32 position)
+{
+    (void)buf; (void)reqSize; (void)speed;
+    if (startTime) vm_write32(startTime, 0);
+    if (readSize) vm_write32(readSize, 0);
+    if (position) vm_write32(position, 0);
+    return (s32)MUSIC2_ERROR_NO_ACTIVE_CONTENT;
+}
