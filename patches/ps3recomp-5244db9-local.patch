+/* Host overlay (the port's own settings page, gt5p_settings_ui.cpp): a BGRA
+ * image with premultiplied alpha that another thread hands over with
+ * rsx_d3d12_overlay_set, blended over the backbuffer at a pixel position
+ * just before present, so it is part of the game's picture (fullscreen,
+ * captures) instead of a window over it. While one is shown the window's
+ * Escape does not close the game (the page uses it to close itself).
+ * RSX_OVERLAY=0 ignores it (the page then falls back to its own window). */
+static SRWLOCK s_ov_lk = SRWLOCK_INIT;
+static u8* s_ov_px;                  /* the latest image, top-down BGRA rows */
+static int s_ov_w, s_ov_h, s_ov_x, s_ov_y, s_ov_cap;
+static u32 s_ov_seq, s_ov_done_seq;
+static ID3D12Resource *s_ov_tex, *s_ov_up[3], *s_ov_dead[4];
+static int s_ov_tw, s_ov_th, s_ov_ui, s_ov_dead_age;
+static u32 s_ov_pitch;
+static ID3D12PipelineState* s_ov_pso;
+
+int rsx_d3d12_overlay_available(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_OVERLAY"); on = !(e && e[0] == '0'); }
+    return on && s_d3d.device && s_d3d.vp_root_sig;
+}
+
+void rsx_d3d12_backbuffer_size(int* w, int* h) { *w = (int)s_d3d.width; *h = (int)s_d3d.height; }
+
+/* px NULL (or w/h 0) hides it. The pixels are copied. */
+void rsx_d3d12_overlay_set(const void* px, int w, int h, int x, int y)
+{
+    AcquireSRWLockExclusive(&s_ov_lk);
+    if (!px || w <= 0 || h <= 0) { if (s_ov_shown) s_ov_hidden_at = GetTickCount64(); s_ov_shown = 0; }
+    else {
+        size_t n = (size_t)w * h * 4;
+        if ((size_t)s_ov_cap < n) { free(s_ov_px); s_ov_px = (u8*)malloc(n); s_ov_cap = s_ov_px ? (int)n : 0; }
+        if (s_ov_px) {
+            memcpy(s_ov_px, px, n);
+            s_ov_w = w; s_ov_h = h; s_ov_x = x; s_ov_y = y; s_ov_shown = 1;
+        }
+    }
+    s_ov_seq++;
+    ReleaseSRWLockExclusive(&s_ov_lk);
+}
