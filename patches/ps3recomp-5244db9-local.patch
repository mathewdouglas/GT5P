+/* Explicit offline catalog pass. Caller holds the startup barrier; no guest
+ * thread may be running. It only writes the normal DXBC cache, never draws. */
+void rsx_d3d12_backend_prepare_library(void)
+{
+    const char* dir = getenv("RSX_SHADER_LIBRARY");
+    const char* cache = getenv("RSX_SHADER_CACHE"); if (!cache) cache = "shadercache";
+    if (!dir || !*dir || !strcmp(dir, "0")) return;
+    if (!strcmp(cache, "0") || !s_d3d.device || !shc_async_on()) {
+        fprintf(stderr, "[shader-library] skipped: D3D12, shader cache and background compiler required\n"); return;
+    }
