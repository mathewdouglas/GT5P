+/* PAD_FILE_LOG=1: print "[file] <path> at <ms>" the first time each guest
+ * path is stat'ed or opened, on the milestone clock. For finding which file
+ * marks a screen in a title whose paths are hashed (Gran Turismo 5). */
+static void pad_file_log(const char* path)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PAD_FILE_LOG"); on = (e && *e == '1'); }
+    if (!on) return;
+    static unsigned long long seen[8192]; static volatile LONG lk = 0;
+    unsigned long long h = 1469598103934665603ULL;
+    for (const char* q = path; *q; q++) { h ^= (unsigned char)*q; h *= 1099511628211ULL; }
+    if (!h) h = 1;
+    while (InterlockedCompareExchange(&lk, 1, 0)) Sleep(0);
+    unsigned i = (unsigned)(h & 8191), fresh = 0;
+    for (unsigned k = 0; k < 8192; k++, i = (i + 1) & 8191) {
+        if (seen[i] == h) break;
+        if (!seen[i]) { seen[i] = h; fresh = 1; break; }
+    }
+    ULONGLONG now = GetTickCount64();
+    if (!s_ms_base) s_ms_base = now;
+    InterlockedExchange(&lk, 0);
+    if (fresh) { printf("[file] %s at %llu ms%c", path, (unsigned long long)(now - s_ms_base), 10); fflush(stdout); }
+}
