+    s_out_on = (s_out_w != w || s_out_h != h) && !(pp && pp[0] == '0');
+    float vw = (float)s_out_w, vh = vw / disp;
+    if (vh > (float)s_out_h) { vh = (float)s_out_h; vw = vh * disp; }
+    s_out_vp.TopLeftX = floorf(((float)s_out_w - vw) * 0.5f + 0.5f);
+    s_out_vp.TopLeftY = floorf(((float)s_out_h - vh) * 0.5f + 0.5f);
+    s_out_vp.Width = floorf(vw + 0.5f); s_out_vp.Height = floorf(vh + 0.5f);
+    s_out_vp.MinDepth = 0.0f; s_out_vp.MaxDepth = 1.0f;
+    fprintf(stderr, "[D3D12] output %ux%u%s: picture %ux%u at %d,%d, rendered %ux%u%s%c",
+            s_out_w, s_out_h, s_borderless ? " borderless" : "",
+            (unsigned)s_out_vp.Width, (unsigned)s_out_vp.Height, (int)s_out_vp.TopLeftX, (int)s_out_vp.TopLeftY,
+            w, h, s_out_on ? ", scaled by the output pass" : "", 10);
+}
