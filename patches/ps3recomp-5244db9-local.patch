+/* SDL's device/event handling has one owner, including initialization. Guest
+ * threads only copy a snapshot; none can close a handle another is reading.
+ * Pump and drain events even with no SDL window (the game uses a Win32 one).
+ * This worker, like the dynamically loaded SDL subsystem, lives until exit. */
+static SRWLOCK s_sdl_snapshot_lock = SRWLOCK_INIT;
+static unsigned s_sdl_snapshot_guide;
+static PadHostState s_sdl_snapshot[PAD_MAX_HOST_PORTS];
+static int s_sdl_snapshot_family[PAD_MAX_HOST_PORTS];
+static int s_sdl_snapshot_type[PAD_MAX_HOST_PORTS];
+static int s_host_family[PAD_MAX_HOST_PORTS];   /* family of each host port's pad */
+static int s_host_type[PAD_MAX_HOST_PORTS];     /* and its SDL type */
+static DWORD WINAPI pad_sdl_worker(void* ready)
+{
+    int ok = pad_sdl_dyn_init();
+    if (!ok) { SetEvent((HANDLE)ready); return 0; }
+    for (;;) {
+        s_sdl.PumpEvents();
+        /* Input is read directly, so discard queued SDL events after pumping. */
+        s_sdl.FlushEvents(0, 0xFFFFu);
+        pad_poll_sdl_dyn();
+        AcquireSRWLockExclusive(&s_sdl_snapshot_lock);
+        memcpy(s_sdl_snapshot, s_sdl_state, sizeof(s_sdl_snapshot));
+        memcpy(s_sdl_snapshot_family, s_sdl_family, sizeof(s_sdl_snapshot_family));
+        memcpy(s_sdl_snapshot_type, s_sdl_type, sizeof(s_sdl_snapshot_type));
+        s_sdl_snapshot_guide = s_sdl_guide;
+        ReleaseSRWLockExclusive(&s_sdl_snapshot_lock);
+        if (ready) { SetEvent((HANDLE)ready); ready = NULL; }
+        Sleep(PAD_POLL_INTERVAL_MS);
+    }
+}
+
+static int pad_sdl_dyn_read(void)
+{
+    static int started;
+    static int hotplug = -1;
+    if (hotplug < 0) {
+        const char* e = getenv("PAD_HOTPLUG");
+        hotplug = !e || strcmp(e, "0");
+    }
+    if (!hotplug) {
+        if (!pad_sdl_dyn_init()) return 0;
+        pad_poll_sdl_dyn();
+        memcpy(s_host_state, s_sdl_state, sizeof(s_host_state));
+        memcpy(s_host_family, s_sdl_family, sizeof(s_host_family));
+        memcpy(s_host_type, s_sdl_type, sizeof(s_host_type));
+        s_guide = s_sdl_guide;
+        return 1;
+    }
+    if (!started) {
+        started = 1;
+        HANDLE ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+        HANDLE thread = ready ? CreateThread(NULL, 0, pad_sdl_worker, ready, 0, NULL) : NULL;
+        if (thread) { WaitForSingleObject(ready, INFINITE); CloseHandle(thread); }
+        if (ready) CloseHandle(ready);
+        if (!thread) return 0;
+    }
+    if (!s_sdl_ok) return 0;
+    AcquireSRWLockShared(&s_sdl_snapshot_lock);
+    memcpy(s_host_state, s_sdl_snapshot, sizeof(s_host_state));
+    memcpy(s_host_family, s_sdl_snapshot_family, sizeof(s_host_family));
+    memcpy(s_host_type, s_sdl_snapshot_type, sizeof(s_host_type));
+    s_guide = s_sdl_snapshot_guide;
+    ReleaseSRWLockShared(&s_sdl_snapshot_lock);
+    return 1;
+}
