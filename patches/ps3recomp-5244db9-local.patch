+    { static int df = -2; static FILE* fo = NULL; static double t0 = 0, wait = 0;
+      if (df == -2) { const char* e = getenv("RSX_XFSTAT_DUMP"); df = e ? -3 : -1; wait = e ? atof(e) : 0; }
