+    HRESULT hr = D3DCompile(src, sizeof(src) - 1, "overlay", NULL, NULL, "vs", "vs_5_0", 0, 0, &vs, &err);
+    if (err) { err->lpVtbl->Release(err); err = NULL; }
+    if (SUCCEEDED(hr)) hr = D3DCompile(src, sizeof(src) - 1, "overlay", NULL, NULL, "ps", "ps_5_0", 0, 0, &ps, &err);
+    if (SUCCEEDED(hr)) {
