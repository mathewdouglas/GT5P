+/* Record a milestone by name (first sighting only) and print it. */
+void pad_milestone_mark(const char* name)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PAD_MILESTONES"); on = (e && *e == '0') ? 0 : 1; }
+    if (!on || !name) return;
+    size_t len = strlen(name);
+    if (!len || len >= sizeof s_ms[0].name) return;
+    while (InterlockedCompareExchange(&s_ms_lock, 1, 0)) Sleep(0);
+    ULONGLONG now = GetTickCount64();
+    if (!s_ms_base) s_ms_base = now;
+    int found = 0;
+    for (LONG i = 0; i < s_ms_n; i++)
+        if (!strcmp(s_ms[i].name, name)) { found = 1; break; }
+    if (!found && s_ms_n < PAD_MS_MAX) {
+        memcpy(s_ms[s_ms_n].name, name, len); s_ms[s_ms_n].name[len] = 0;
+        s_ms[s_ms_n].at = now;
+        InterlockedIncrement(&s_ms_n);
+        ULONGLONG p0 = s_pad_t0;
+        printf("[milestone] %s at %llu ms (pad clock %lld ms)%c", name,
+               (unsigned long long)(now - s_ms_base), p0 ? (long long)(now - p0) : -1LL, 10);
+        fflush(stdout);
+    }
+    InterlockedExchange(&s_ms_lock, 0);
