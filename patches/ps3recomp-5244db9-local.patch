+}
+
+/* Open controllers that have appeared; a device already open is recognised
+ * by its instance id, since device indices shift as things are plugged in. */
+static void pad_sdl_dyn_scan(void)
+{
+    int n = s_sdl.NumJoysticks();
+    for (int d = 0; d < n; d++) {
+        if (!s_sdl.IsGameController(d)) continue;
+        int id = s_sdl.JoystickGetDeviceInstanceID(d), open = 0, slot = -1;
+        for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+            if (!s_sdl_pad[i]) { if (slot < 0) slot = i; continue; }
+            if (s_sdl.JoystickInstanceID(s_sdl.GameControllerGetJoystick(s_sdl_pad[i])) == id) open = 1;
+        }
+        if (open || slot < 0) continue;
+        s_sdl_pad[slot] = s_sdl.GameControllerOpen(d);
+        if (s_sdl_pad[slot]) {
+            const char* nm = s_sdl.GameControllerName(s_sdl_pad[slot]);
+            s_sdl_family[slot] = pad_sdl_family(s_sdl_pad[slot]);
+            s_sdl_type[slot] = s_sdl.GameControllerGetType ? s_sdl.GameControllerGetType(s_sdl_pad[slot]) : 0;
+            printf("[cellPad] port %d: %s (type %d, family %d)%c", slot, nm ? nm : "controller",
+                   s_sdl.GameControllerGetType ? s_sdl.GameControllerGetType(s_sdl_pad[slot]) : -1,
+                   s_sdl_family[slot], 10);
+            fflush(stdout);
+        }
+    }
+}
+
+static u8 pad_sdl_dyn_axis(int raw)
+{
+    /* the same dead zone the XInput path uses */
+    return pad_xinput_stick_to_u8((short)raw, PAD_STICK_DEADZONE);
+}
+
+static unsigned s_guide;   /* ports whose PS/guide button is down this poll */
+static unsigned s_sdl_guide;
+static PadHostState s_sdl_state[PAD_MAX_HOST_PORTS];
+
+static void pad_poll_sdl_dyn(void)
+{
+    s_sdl_guide = 0;
+    static unsigned long long last_scan = 0;
+    unsigned long long now = GetTickCount64();
+    s_sdl.GameControllerUpdate();
+    /* Retire removed handles BEFORE assigning new devices to ports. A rapid
+     * unplug/replug must not move player one into the next empty port. */
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+        if (s_sdl_pad[i] && !s_sdl.GameControllerGetAttached(s_sdl_pad[i])) {
+            s_sdl.GameControllerClose(s_sdl_pad[i]);
+            s_sdl_pad[i] = NULL;
+            last_scan = 0;
+            printf("[cellPad] port %d: controller removed\n", i);
+            fflush(stdout);
+        }
+    }
+    if (!last_scan || now - last_scan >= 1000) { last_scan = now; pad_sdl_dyn_scan(); }
+
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+        void* gc = s_sdl_pad[i];
+        PadHostState* hs = &s_sdl_state[i];
+        memset(hs, 0, sizeof(*hs));
+        hs->analog_lx = hs->analog_ly = hs->analog_rx = hs->analog_ry = 128;
+        if (!gc || !s_sdl.GameControllerGetAttached(gc)) {
+            if (gc) { s_sdl.GameControllerClose(gc); s_sdl_pad[i] = NULL;
+                      printf("[cellPad] port %d: controller removed%c", i, 10); fflush(stdout); }
+            hs->connected = 0;
+            continue;
+        }
+        static const struct { int sdl; u16 btn; } map[] = {
+            { 0, CELL_PAD_CTRL_CROSS },    { 1, CELL_PAD_CTRL_CIRCLE },
+            { 2, CELL_PAD_CTRL_SQUARE },   { 3, CELL_PAD_CTRL_TRIANGLE },
+            { 4, CELL_PAD_CTRL_SELECT },   { 6, CELL_PAD_CTRL_START },
+            { 7, CELL_PAD_CTRL_L3 },       { 8, CELL_PAD_CTRL_R3 },
+            { 9, CELL_PAD_CTRL_L1 },       { 10, CELL_PAD_CTRL_R1 },
+            { 11, CELL_PAD_CTRL_UP },      { 12, CELL_PAD_CTRL_DOWN },
+            { 13, CELL_PAD_CTRL_LEFT },    { 14, CELL_PAD_CTRL_RIGHT },
+        };
+        u16 btns = 0;
+        for (unsigned k = 0; k < sizeof map / sizeof map[0]; k++)
+            if (s_sdl.GameControllerGetButton(gc, map[k].sdl)) btns |= map[k].btn;
+        int lt = s_sdl.GameControllerGetAxis(gc, 4), rt = s_sdl.GameControllerGetAxis(gc, 5);
+        if (lt > 3000) btns |= CELL_PAD_CTRL_L2;
+        if (rt > 3000) btns |= CELL_PAD_CTRL_R2;
+        /* SDL_CONTROLLER_BUTTON_GUIDE (the PS button): not a game button, for
+         * the port's own overlay (g_pad_menu_buttons). */
+        if (s_sdl.GameControllerGetButton(gc, 5)) s_sdl_guide |= 1u << i;
+
+        hs->connected = 1;
+        hs->buttons = btns;
+        hs->analog_lx = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 0));
+        hs->analog_ly = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 1));
+        hs->analog_rx = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 2));
+        hs->analog_ry = pad_sdl_dyn_axis(s_sdl.GameControllerGetAxis(gc, 3));
+        hs->trigger_l2 = (u8)(lt < 0 ? 0 : lt * 255 / 32767);
+        hs->trigger_r2 = (u8)(rt < 0 ? 0 : rt * 255 / 32767);
+        hs->press_up       = (btns & CELL_PAD_CTRL_UP)       ? 255 : 0;
+        hs->press_down     = (btns & CELL_PAD_CTRL_DOWN)     ? 255 : 0;
+        hs->press_left     = (btns & CELL_PAD_CTRL_LEFT)     ? 255 : 0;
+        hs->press_right    = (btns & CELL_PAD_CTRL_RIGHT)    ? 255 : 0;
+        hs->press_triangle = (btns & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+        hs->press_circle   = (btns & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+        hs->press_cross    = (btns & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+        hs->press_square   = (btns & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+        hs->press_l1       = (btns & CELL_PAD_CTRL_L1)       ? 255 : 0;
+        hs->press_r1       = (btns & CELL_PAD_CTRL_R1)       ? 255 : 0;
+    }
+}
+
+/* SDL's device/event handling has one owner, including initialization. Guest
+ * threads only copy a snapshot; none can close a handle another is reading.
+ * Pump and drain events even with no SDL window (the game uses a Win32 one).
+ * This worker, like the dynamically loaded SDL subsystem, lives until exit. */
+static SRWLOCK s_sdl_snapshot_lock = SRWLOCK_INIT;
+static unsigned s_sdl_snapshot_guide;
+static PadHostState s_sdl_snapshot[PAD_MAX_HOST_PORTS];
+static int s_sdl_snapshot_family[PAD_MAX_HOST_PORTS];
+static int s_sdl_snapshot_type[PAD_MAX_HOST_PORTS];
+static int s_host_family[PAD_MAX_HOST_PORTS];   /* family of each host port's pad */
+static int s_host_type[PAD_MAX_HOST_PORTS];     /* and its SDL type */
+static DWORD WINAPI pad_sdl_worker(void* ready)
+{
+    int ok = pad_sdl_dyn_init();
+    if (!ok) { SetEvent((HANDLE)ready); return 0; }
+    for (;;) {
+        s_sdl.PumpEvents();
+        /* Input is read directly, so discard queued SDL events after pumping. */
+        s_sdl.FlushEvents(0, 0xFFFFu);
+        pad_poll_sdl_dyn();
+        AcquireSRWLockExclusive(&s_sdl_snapshot_lock);
+        memcpy(s_sdl_snapshot, s_sdl_state, sizeof(s_sdl_snapshot));
+        memcpy(s_sdl_snapshot_family, s_sdl_family, sizeof(s_sdl_snapshot_family));
+        memcpy(s_sdl_snapshot_type, s_sdl_type, sizeof(s_sdl_snapshot_type));
+        s_sdl_snapshot_guide = s_sdl_guide;
+        ReleaseSRWLockExclusive(&s_sdl_snapshot_lock);
+        if (ready) { SetEvent((HANDLE)ready); ready = NULL; }
+        Sleep(PAD_POLL_INTERVAL_MS);
+    }
+}
+
+static int pad_sdl_dyn_read(void)
+{
+    static int started;
+    static int hotplug = -1;
+    if (hotplug < 0) {
+        const char* e = getenv("PAD_HOTPLUG");
+        hotplug = !e || strcmp(e, "0");
+    }
+    if (!hotplug) {
+        if (!pad_sdl_dyn_init()) return 0;
+        pad_poll_sdl_dyn();
+        memcpy(s_host_state, s_sdl_state, sizeof(s_host_state));
+        memcpy(s_host_family, s_sdl_family, sizeof(s_host_family));
+        memcpy(s_host_type, s_sdl_type, sizeof(s_host_type));
+        s_guide = s_sdl_guide;
+        return 1;
+    }
+    if (!started) {
+        started = 1;
+        HANDLE ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+        HANDLE thread = ready ? CreateThread(NULL, 0, pad_sdl_worker, ready, 0, NULL) : NULL;
+        if (thread) { WaitForSingleObject(ready, INFINITE); CloseHandle(thread); }
+        if (ready) CloseHandle(ready);
+        if (!thread) return 0;
+    }
+    if (!s_sdl_ok) return 0;
+    AcquireSRWLockShared(&s_sdl_snapshot_lock);
+    memcpy(s_host_state, s_sdl_snapshot, sizeof(s_host_state));
+    memcpy(s_host_family, s_sdl_snapshot_family, sizeof(s_host_family));
+    memcpy(s_host_type, s_sdl_snapshot_type, sizeof(s_host_type));
+    s_guide = s_sdl_snapshot_guide;
+    ReleaseSRWLockShared(&s_sdl_snapshot_lock);
+    return 1;
+}
