+/* SDL_GameControllerType, else the name, to a g_pad_device_family code. */
+static int pad_sdl_family(void* gc)
+{
+    int t = s_sdl.GameControllerGetType ? s_sdl.GameControllerGetType(gc) : 0;
+    switch (t) {
+    case 1: case 2: return 2;                    /* Xbox 360, Xbox One/Series */
+    case 3: case 4: case 7: return 3;            /* PS3, PS4, PS5 */
+    case 5: case 11: case 12: case 13: return 4; /* Switch Pro, Joy-Cons */
+    default: break;
+    }
+    const char* nm = s_sdl.GameControllerName(gc);
+    if (nm) {
+        if (strstr(nm, "Xbox") || strstr(nm, "XInput") || strstr(nm, "X-Box")) return 2;
+        if (strstr(nm, "PS3") || strstr(nm, "PS4") || strstr(nm, "PS5") ||
+            strstr(nm, "DualShock") || strstr(nm, "DualSense") || strstr(nm, "PlayStation")) return 3;
+        if (strstr(nm, "Nintendo") || strstr(nm, "Switch") || strstr(nm, "Joy-Con")) return 4;
