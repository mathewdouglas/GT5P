+void pad_milestone_seen(const char* path)
+{
+    if (!path) return;
+    pad_file_log(path);
+    const char* b = strrchr(path, '/'); b = b ? b + 1 : path;
+    if (g_pad_milestone_hook) g_pad_milestone_hook(b);
+    if (g_pad_screen_hook) g_pad_screen_hook(b);
+    size_t len = strlen(b);
+    if (len >= 5 && !strcmp(b + len - 4, ".gpb")) {
+        char name[sizeof s_ms[0].name];
+        if (len - 4 >= sizeof name) return;
+        memcpy(name, b, len - 4); name[len - 4] = 0;
+        pad_milestone_mark(name);
+    } else {
+        char lab[48];
+        const char* m = pad_milestone_file_listed(path, b, lab, sizeof lab);
+        if (m) pad_milestone_mark(m);
+    }
+}
