+            100.0 * s_xf_kiv / (s_xf_calls ? s_xf_calls : 1), s_xf_vbsame / f / 1e6,
+            100.0 * s_xf_cont / (s_xf_calls ? s_xf_calls : 1), 10);
+    fprintf(stderr, "[xfstat]   same vertex source (index array anywhere) %.1f%%; same index bytes anywhere %.1f%%%c",
