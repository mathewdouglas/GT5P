+/* Filter and wrap mode of texture units 0 to 3 as the title set them, 7 bits
+ * a unit: bit 6 "set", and in the low bits filter * 4 + wrap pair, with filter
+ * 0 point, 1 linear, 2 linear with linear mip, and wrap pair 0 repeat/repeat,
+ * 1 clamp/clamp, 2 repeat/clamp, 3 clamp/repeat (mirror counts as repeat).
+ * That is twelve samplers, which is what is free: a pixel shader has sixteen
+ * sampler registers and the backend binds four texture units, so the bank
+ * sits in s4 to s15. Until this the
+ * four samplers were fixed -- unit 0 point and clamped, the rest linear and
+ * repeating -- whatever the title asked for, so GT5 Prologue's scenery, whose
+ * main texture is on unit 0, was drawn unfiltered. A unit the title never
+ * programmed keeps its fixed sampler. RSX_SAMP_FIXED=1 for the old way;
+ * RSX_SAMPDBG=1 prints each distinct setting once. */
+static u32 rsx_samp_key(const rsx_state* st)
+{
+    static int fixed = -1, dbg = -1;
+    if (fixed < 0) fixed = getenv("RSX_SAMP_FIXED") ? 1 : 0;
+    if (dbg < 0) dbg = getenv("RSX_SAMPDBG") ? 1 : 0;
+    if (fixed) return 0;
+    u32 key = 0;
+    for (int u = 0; u < 4; u++) {
+        u32 ad = st->textures[u].address, fl = st->textures[u].filter;
+        u32 mn = (fl >> 16) & 7u, mg = (fl >> 24) & 7u;
+        if (!mn && !mg && !(ad & 0xF0Fu)) continue;          /* never programmed */
+        u32 f = (mg == 1u && (mn == 1u || mn == 3u || mn == 5u)) ? 0u
