+s32 cellPamfEpIteratorMove(u32 pIt, s32 steps, u32 pEp)
+{
+    if (!pIt) return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+    s64 index = codec_get32(pIt + 4), num = codec_get32(pIt + 8);
+    s64 to = index + steps;
