+    if (!s_ov_shown || !rsx_d3d12_overlay_available() || !overlay_pso_ensure()) return;
+    ID3D12GraphicsCommandList* cl = s_d3d.cmd_list;
+    int x, y, w, h;
+    AcquireSRWLockShared(&s_ov_lk);
+    x = s_ov_x; y = s_ov_y; w = s_ov_w; h = s_ov_h;
+    const int fresh = s_ov_seq != s_ov_done_seq;
+    if (fresh && (w != s_ov_tw || h != s_ov_th || !s_ov_tex)) {
+        overlay_retire();
