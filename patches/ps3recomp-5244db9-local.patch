+        vm_write8(addr + 1, 2);   /* AF_INET */
+    }
+    if (lenp) vm_write32(lenp, 16);
+    ctx->gpr[3] = 0;
+}
+/* inet_pton(af, src, dst): AF_INET dotted quads; 1 converted, 0 not an
+ * address, -1 other families. Unresolved, it returned af (2) untouched. */
+static void hle_net_inet_pton(ppu_context* ctx)
+{
+    uint32_t af = (uint32_t)ctx->gpr[3], src = (uint32_t)ctx->gpr[4], dst = (uint32_t)ctx->gpr[5];
+    if (af != 2) { ctx->gpr[3] = (uint64_t)(int64_t)-1; return; }
+    uint32_t part[4] = {0, 0, 0, 0}; int n = 0, digits = 0, ok = src != 0;
+    for (uint32_t i = 0; ok && i < 16; i++) {
+        uint8_t c = vm_read8(src + i);
+        if (c >= '0' && c <= '9') { part[n] = part[n] * 10 + (c - '0'); if (++digits > 3 || part[n] > 255) ok = 0; }
+        else if (c == '.' && digits && n < 3) { n++; digits = 0; }
+        else if (c == 0) break;
+        else ok = 0;
+    }
+    if (!ok || n != 3 || !digits) { ctx->gpr[3] = 0; return; }
+    if (dst) for (int k = 0; k < 4; k++) vm_write8(dst + k, (uint8_t)part[k]);
+    ctx->gpr[3] = 1;
+}
 
