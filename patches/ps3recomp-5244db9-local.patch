+/* sceNpManagerGetNetworkTime(CellRtcTick*): the PSN server's clock. It was
+ * not implemented, so it answered CELL_OK without writing the tick and the
+ * caller took whatever its buffer held (Gran Turismo 5's clock, wrong at boot
+ * and on each page load). Signed in (psnr): the host's UTC time. Offline:
+ * SCE_NP_ERROR_OFFLINE, as a console that is not signed in answers.
+ * NP_NETWORK_TIME=1 answers with the host time offline too. */
+s32 sceNpManagerGetNetworkTime(void* pTick)
+{
+    if (!s_np_initialized)
+        return SCE_NP_ERROR_NOT_INITIALIZED;
+    if (!pTick)
+        return SCE_NP_ERROR_INVALID_ARGUMENT;
+    static int always = -1;
+    if (always < 0) { const char* e = getenv("NP_NETWORK_TIME"); always = e && e[0] == '1'; }
+    if (!np_psnr_enabled() && !always)
+        return SCE_NP_ERROR_OFFLINE;
+    extern s32 cellRtcGetCurrentTick(void* pTick);
+    return cellRtcGetCurrentTick(pTick);
+}
