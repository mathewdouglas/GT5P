+/* Interleave the available axis bits in X,Y,Z order. Wider texels are
+ * addressed as adjacent 32-bit words, the RSX swizzler's largest unit. */
+static u32 volume_morton(u32 x, u32 y, u32 z, u32 w, u32 h, u32 d)
+{
+    u32 out = 0, pos = 0;
+    for (u32 bit = 1; bit < w || bit < h || bit < d; bit <<= 1) {
+        if (bit < w) { if (x & bit) out |= 1u << pos; pos++; }
+        if (bit < h) { if (y & bit) out |= 1u << pos; pos++; }
+        if (bit < d) { if (z & bit) out |= 1u << pos; pos++; }
+    }
