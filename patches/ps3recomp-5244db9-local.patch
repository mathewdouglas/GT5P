diff --git a/libs/filesystem/cellFs.c b/libs/filesystem/cellFs.c
index 5166a47..0d4e779 100644
--- a/libs/filesystem/cellFs.c
+++ b/libs/filesystem/cellFs.c
@@ -322,27 +322,53 @@ typedef struct {
 static FsFileSlot s_files[MAX_OPEN_FILES];
 static FsDirSlot  s_dirs[MAX_OPEN_DIRS];
 
+/* Claiming a slot has to be atomic. A title that loads from several threads
+ * opens files concurrently, and two unlocked scans both found the same free
+ * slot: both callers were handed one descriptor, the second open replaced the
+ * first's FILE*, and from then on each thread read, seeked and closed the
+ * other's file. GT5P's three loader threads hit this in about one boot in
+ * six, and what they loaded was garbage. */
+#ifdef _WIN32
+static SRWLOCK s_fd_lock = SRWLOCK_INIT;
+#  define FD_LOCK()   AcquireSRWLockExclusive(&s_fd_lock)
+#  define FD_UNLOCK() ReleaseSRWLockExclusive(&s_fd_lock)
+#else
+#  include <pthread.h>
+static pthread_mutex_t s_fd_lock = PTHREAD_MUTEX_INITIALIZER;
+#  define FD_LOCK()   pthread_mutex_lock(&s_fd_lock)
+#  define FD_UNLOCK() pthread_mutex_unlock(&s_fd_lock)
+#endif
+
 static CellFsFd alloc_fd(void)
 {
+    CellFsFd fd = -1;
+    FD_LOCK();
     for (int i = 3; i < MAX_OPEN_FILES; i++) {  /* skip 0,1,2 = stdin/out/err */
         if (!s_files[i].in_use) {
+            s_files[i].host_fp = NULL;
             s_files[i].in_use = 1;
-            return i;
+            fd = i;
+            break;
         }
     }
-    return -1;
+    FD_UNLOCK();
+    return fd;
 }
 
 static CellFsDir alloc_dir(void)
 {
+    CellFsDir fd = -1;
+    FD_LOCK();
     for (int i = 0; i < MAX_OPEN_DIRS; i++) {
         if (!s_dirs[i].in_use) {
             memset(&s_dirs[i], 0, sizeof(FsDirSlot));
             s_dirs[i].in_use = 1;
-            return i;
+            fd = i;
+            break;
         }
     }
-    return -1;
+    FD_UNLOCK();
+    return fd;
 }
 
