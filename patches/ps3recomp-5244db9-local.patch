+/* The real lv2 syscall table (runtime/syscalls/lv2_register.c). */
+extern "C" int lv2_try_syscall(ppu_context* ctx);
+
+/* lv2 syscall dispatch: r11 = syscall number, args in r3.. (PPC ABI).
+ * A few syscalls the CRT needs at boot are handled inline (boot-tuned); the
+ * rest are dispatched to the real lv2 table, and only genuinely-unregistered
+ * numbers fall through to the return-CELL_OK stub. */
+extern "C" void ppu_prof_stamp(void* ctx, unsigned lr); extern "C" void ppu_prof_stamp_ra(void* ctx, void* ra);
+/* In-flight lv2 syscall per guest thread; 0 = not in a syscall. See the guard
+ * in lv2_syscall() below. */
+#define PS3_SC_INFLIGHT_MAX 64
+extern "C" uint32_t g_sc_inflight[PS3_SC_INFLIGHT_MAX] = { 0 };
+/* PS3_SC_CONTEXT=1: retain the actual syscall context for live diagnostics.
+ * A callback inherits a thread id but uses its own scratch context, so the
+ * thread table alone can show an unrelated condition id/argument while blocked. */
+extern "C" ppu_context* g_sc_context[PS3_SC_INFLIGHT_MAX] = { nullptr };
+
+/* Guest page faults (lv2 327 sys_mmapper_enable_page_fault_notification, lv2 57
+ * sys_ppu_thread_recover_page_fault). A title that pages its own memory (GT5's
+ * MpAnk) reserves an area, asks for notification, and serves each first touch:
+ * the faulting thread stops, the kernel queues (0xFFFE000000000000, address,
+ * (type << 32) | thread id, cause 2 = not mapped), the pager maps a block there,
+ * fills it and recovers the thread, which then retries the access. Without
+ * this the port's fault handler committed the page as zeros behind the pager's
+ * back, and the pager's later map of that page wiped what had been written.
+ *
+ * The port's access-violation handler calls ps3_pager_fault; 1 means served
+ * (retry the access), 0 means not a pager fault here (commit as before).
+ * PS3_PAGE_FAULT=1 enables it, and it needs real blocks (PS3_MMAPPER_SHM=1):
+ * with no-op maps the pager's own fill would fault again. PS3_PAGE_FAULT_MS
+ * bounds the wait (10000). PPU threads only; SPU access still commits. */
+static uint32_t s_pf_lo[8], s_pf_hi[8], s_pf_queue[8];   /* one per notified area */
+static volatile long s_pf_areas = 0;
+static SRWLOCK s_pf_lock = SRWLOCK_INIT;
+static HANDLE s_pf_wait[PS3_SC_INFLIGHT_MAX * 16];          /* by guest thread id */
+static PPU_THREAD_LOCAL int s_pf_in = 0;
+static volatile long s_pf_count = 0;
+
+static int pf_enabled(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        /* PS3_PAGE_FAULT=2: notify the pager with legacy (flat) mmapper
+         * blocks too. Nothing moves then, so the pager's page-outs and
+         * page-ins leave the data in place, but its physical page budget
+         * sees faults and releases its reservations as on the console. */
+        const char* e = getenv("PS3_PAGE_FAULT"); const char* m = getenv("PS3_MMAPPER_SHM");
+        v = (e && *e == '2') || (e && *e == '1' && m && *m == '1');
+    }
+    return v;
+}
+
+extern "C" int ps3_pager_fault(uint32_t addr, int write)
+{
+    if (!pf_enabled() || s_pf_in) return 0;
+    uint32_t queue = 0;
+    for (long k = 0; k < s_pf_areas; k++)
+        if (addr >= s_pf_lo[k] && addr < s_pf_hi[k]) queue = s_pf_queue[k];
+    if (!queue) return 0;
+    if (ps3_mmapper_is_mapped(addr)) return 0;   /* a legacy block's first touch */
+    ppu_context* ctx = g_active_ctx;
+    if (!ctx || !ctx->thread_id || ctx->thread_id >= sizeof(s_pf_wait) / sizeof(s_pf_wait[0])) return 0;
+    uint32_t tid = (uint32_t)ctx->thread_id;
+    AcquireSRWLockExclusive(&s_pf_lock);
+    if (!s_pf_wait[tid]) s_pf_wait[tid] = CreateEventW(NULL, FALSE, FALSE, NULL);
+    HANDLE ev = s_pf_wait[tid];
+    ReleaseSRWLockExclusive(&s_pf_lock);
+    if (!ev) return 0;
+    extern int sys_event_queue_push_by_id(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t);
+    s_pf_in = 1;
+    int rc = sys_event_queue_push_by_id(queue, 0xFFFE000000000000ull, addr, (uint64_t)tid, 2);
+    long n = InterlockedIncrement(&s_pf_count);
+    /* PS3_PAGE_FAULT_LOG=<n>: how many faults to log (default 16). */
+    static long cap = -1;
+    if (cap < 0) { const char* e = getenv("PS3_PAGE_FAULT_LOG"); cap = e ? atol(e) : 16; }
+    if (n <= cap || (n % 500) == 0)
+        fprintf(stderr, "[pager] fault #%ld at 0x%08X (%s) by tid %u lr=0x%08X -> %s\n", n, addr,
+                write ? "write" : "read", tid, (uint32_t)ctx->lr, rc == 0 ? "queued" : "queue refused");
+    DWORD w = WAIT_FAILED;
+    if (rc == 0) {
+        static DWORD ms = 0;
+        if (!ms) { const char* e = getenv("PS3_PAGE_FAULT_MS"); ms = e ? (DWORD)atol(e) : 10000; }
+        w = WaitForSingleObject(ev, ms);
+        if (w != WAIT_OBJECT_0)
+            fprintf(stderr, "[pager] fault at 0x%08X by tid %u was not recovered in %lu ms; committing\n",
+                    addr, tid, (unsigned long)ms);
+    }
+    s_pf_in = 0;
+    return w == WAIT_OBJECT_0;
+}
