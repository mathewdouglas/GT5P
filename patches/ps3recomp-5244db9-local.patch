+/* ===========================================================================
+ * ATRAC3plus, decoded for real (GT5 Prologue's movies: 6 channels, float PCM)
+ *
+ * A host thread per decoder takes AUs in order, as libadec's PPU thread does.
+ * Each AU is one frame, with its 8-byte ATS header when the sequence says so
+ * (au_includes_ats_hdr_flg): 0F D0, then sampling-rate index (3 bits),
+ * channel configuration (3 bits) and frame size in 8-byte units minus one
+ * (10 bits). It sends AUDONE (msgData: the AU info address) and then PCMOUT.
+ * The PCM waits in a slot of the work memory until cellAdecGetPcm copies it.
+ *
+ * Work memory: the thread's callback stack, then ADEC_SLOTS x { PcmItem at
+ * +0, CellAdecAtracXInfo at +0x40, PCM at +0x80 }. Without FFmpeg the PCM is
+ * silence of the right length. ADEC_TRACE=1 logs AUs.
+ * ======================================================================== */
+#include "codec_host.h"
+#include "codec_ffmpeg.h"
+
+#define ADEC_SLOTS     8
+#define ADEC_CMDS      16
+#define ATX_SAMPLES    2048u
+#define ATX_PCM_MAX    (ATX_SAMPLES * 8u * 4u)
+#define ATX_SLOT       (0x80u + ATX_PCM_MAX)
+#define ATX_MEM        (CODEC_CB_STACK + ADEC_SLOTS * ATX_SLOT)
+#define ATX_MAX        4
+
+typedef struct { int end; u32 info, addr, size; u64 pts, user; } AtxCmd;
+
+typedef struct {
+    int used;
+    u32 handle, mem, type;
+    u32 cb_fn, cb_arg;
+    codec_lock lock;
+    codec_cond cond;
+    codec_thread thread;
+    int quit, seq;
+    /* CellAdecParamAtracX */
+    int freq, ch_cfg, nch_out, nbytes, bw_pcm, downmix, ats;
+    AtxCmd cmd[ADEC_CMDS]; u32 cmd_head, cmd_count;
+    u32 pcm_head, pcm_count;
+    codec_ff* ff; int ff_ch, ff_block;
+    u64 nau;
+} Atx;
+
+static Atx s_atx[ATX_MAX];
+
+static int atx_type(u32 t)
+{
+    return t == ADEC_SDK_ATRACX || t == ADEC_SDK_ATRACX_2CH || t == ADEC_SDK_ATRACX_6CH ||
+           t == ADEC_SDK_ATRACX_8CH;
+}
+
+static Atx* atx_find(u32 h)
+{
+    if (h < 0x10000) return NULL;   /* the legacy decoder's handles are 0..3 */
+    for (int i = 0; i < ATX_MAX; i++) if (s_atx[i].used && s_atx[i].handle == h) return &s_atx[i];
+    return NULL;
+}
+
+static int atx_trace(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("ADEC_TRACE"); v = e && e[0] == '1'; }
+    return v;
+}
+
+static u32 atx_slot_ea(const Atx* a, u32 s) { return a->mem + CODEC_CB_STACK + s * ATX_SLOT; }
+
+static void atx_notify(Atx* a, u32 type, u32 data)
+{
+    codec_call4(a->cb_fn, a->handle, type, data, a->cb_arg);
+}
+
+static const int k_atx_rates[8] = { 32000, 44100, 48000, 88200, 96000, 48000, 48000, 48000 };
+static const int k_atx_chans[8] = { 0, 1, 2, 3, 4, 6, 7, 8 };
+
+static void put_sample(u8* o, float s, int bw)
+{
+    if (bw == 0x84) {
+        union { float f; u32 u; } c; c.f = s;
+        o[0] = (u8)(c.u >> 24); o[1] = (u8)(c.u >> 16); o[2] = (u8)(c.u >> 8); o[3] = (u8)c.u;
+        return;
+    }
+    if (s > 1.0f) s = 1.0f;
+    if (s < -1.0f) s = -1.0f;
+    if (bw == 0x02) { s16 v = (s16)(s * 32767.0f); o[0] = (u8)(v >> 8); o[1] = (u8)v; return; }
+    s32 v = (s32)(s * 2147483647.0f);
+    if (bw == 0x03) { o[0] = (u8)(v >> 24); o[1] = (u8)(v >> 16); o[2] = (u8)(v >> 8); return; }
+    o[0] = (u8)(v >> 24); o[1] = (u8)(v >> 16); o[2] = (u8)(v >> 8); o[3] = (u8)v;
+}
+
+static int bytes_per_sample(int bw) { return bw == 0x02 ? 2 : bw == 0x03 ? 3 : 4; }
