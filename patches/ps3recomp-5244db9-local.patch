+int rsx_texture_decode_volume(void* dst, u32 row_pitch, u32 slice_pitch,
+    const u8* src, u32 w, u32 h, u32 depth, const rsx_tex_layout* tl,
+    int argb_as_rgba)
+{
+    if (!dst || !src || !tl || !w || !h || !depth || w > 4096 || h > 4096 || depth > 2048) return 0;
+    const u32 f = tl->base_format;
+    const int bc = f >= 0x86 && f <= 0x88;
+    const u32 out_bytes = bc ? 4 : tl->dst_bytes_per_texel;
+    if (!out_bytes || row_pitch < w*out_bytes || (u64)slice_pitch < (u64)row_pitch*h) return 0;
+    const u32 bytes = tl->bytes_per_texel;
+    if (!bc && (!bytes || bytes > 16 || (u64)w*h*depth*bytes > 0xFFFFFFFFull)) return 0;
+    if (!bc && tl->swizzled && ((w & (w-1)) || (h & (h-1)) || (depth & (depth-1)))) return 0;
+    for (u32 z = 0; z < depth; z++) for (u32 y = 0; y < h; y++) for (u32 x = 0; x < w; x++) {
+        u8* out = (u8*)dst + (u64)z*slice_pitch + (u64)y*row_pitch + x*out_bytes;
+        if (bc) {
+            /* VTC groups up to four adjacent Z planes per 4x4 block.
+             * NV_texture_compression_vtc defines the short final group too. */
+            u32 start_z = z & ~3u, group = depth-start_z < 4 ? depth-start_z : 4;
+            u32 plane_blocks = ((w+3)/4)*((h+3)/4);
+            u32 block = start_z*plane_blocks + ((y/4)*((w+3)/4)+x/4)*group + (z-start_z);
+            volume_bc_pixel(src + (u64)block*(f == 0x86 ? 8 : 16), f, (y&3)*4+(x&3), out);
+        } else {
+            u8 texel[16]; const u8* in;
+            if (!tl->swizzled) in = src + ((u64)z*w*h + y*w+x)*bytes;
+            else if (bytes <= 4) in = src + (u64)volume_morton(x,y,z,w,h,depth)*bytes;
+            else {
+                for (u32 k = 0; k < bytes/4; k++)
+                    memcpy(texel+k*4, src+(u64)volume_morton(x*(bytes/4)+k,y,z,w*(bytes/4),h,depth)*4,4);
+                in = texel;
+            }
+            decode_texel(tl, in, out, argb_as_rgba);
+        }
+    }
+    return 1;
+}
