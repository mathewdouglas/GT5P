+/* Copy the call's indices into the frame's index buffer, adding bias (the
+ * number of vertices the record already holds when this call extends it). */
+static void ix_write(u32 bias)
+{
+    u32* d = s_vp_ib_mapped + (size_t)FR->parity * VP_IB_INDICES + s_vp_ib_off;
+    for (u32 i = 0; i < s_ix_n; i++) d[i] = s_ix_tmp[i] + bias;
+    s_vp_ib_off += s_ix_n;
+}
+/* Guest index array of the current draw, resolved once per call. */
+typedef struct { const u8* p; int u16; u32 bias; } IxSrc;
+static IxSrc ix_src(const rsx_state* st)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    IxSrc r;
+    r.p = vm_base + cellGcmResolveLocated((st->index_array_dma & 0xF) == 0, st->index_array_offset);
+    r.u16 = ((st->index_array_dma >> 4) & 0xF) == 1;
+    r.bias = st->vertex_base_index;
+    return r;
+}
+static inline u32 ix_read(const IxSrc* s, u32 k)
+{
+    const u8* p = s->p + (u64)k * (s->u16 ? 2u : 4u);
+    return (s->u16 ? (((u32)p[0] << 8) | p[1])
+                   : (((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3])) + s->bias;
+}
+
+/* RSX_XFSTAT=1 (measurement): how much of a frame's indexed uploads repeats
+ * the previous frame's. Each call is keyed by where it reads (index array,
+ * range, vertex layout and offsets) and by hashes of its index bytes and of
+ * the vertex bytes its index range spans; every 5 s it prints how many calls
+ * found last frame's key, with the same index bytes, and with the same vertex
+ * bytes too, and how many found the same contents at any address. */
+#define XF_N (1u << 16)
+typedef struct { u64 key, hi, hv; u32 gen; } XfEnt;
+static XfEnt* s_xf_tab[3];          /* [s_xf_cur] this frame, then the last two */
+static int    s_xf_cur;
+static u32    s_xf_gen = 1;
+static u64    s_xf_kv, s_xf_hi, s_xf_k2, s_xf_k2iv, s_xf_k12;
+static double s_xf_tnote;           /* xf_note's own time in the call being timed */
+static int    s_xf_lastrep = -1;    /* that call repeated last frame's (key, indices, vertices) */
+static double s_xf_t[2][2]; static u64 s_xf_n[2][2];   /* upload time, calls: [repeated][GPU fetch] */
+static u64    s_xf_calls, s_xf_key, s_xf_ki, s_xf_kiv, s_xf_cont, s_xf_ib, s_xf_vb, s_xf_vbsame, s_xf_frames;
+static double s_xf_last;
+static int xfstat_on(void)
+{
+    static int v = -1;
+    if (v < 0) { v = getenv("RSX_XFSTAT") ? 1 : 0;
+                 if (v) { s_xf_tab[0] = (XfEnt*)calloc(XF_N, sizeof(XfEnt)); s_xf_tab[1] = (XfEnt*)calloc(XF_N, sizeof(XfEnt));
