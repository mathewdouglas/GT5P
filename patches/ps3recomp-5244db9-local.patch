+    if (format == 0x87) out[3] = (u8)(((block[pixel / 2] >> (4 * (pixel & 1))) & 15) * 17);
+    if (format == 0x88) {
+        u8 alpha[8]; alpha[0] = block[0]; alpha[1] = block[1];
+        if (alpha[0] > alpha[1]) {
+            for (u32 i = 2; i < 8; i++) alpha[i] = (u8)(((8-i)*alpha[0] + (i-1)*alpha[1]) / 7);
+        } else {
+            for (u32 i = 2; i < 6; i++) alpha[i] = (u8)(((6-i)*alpha[0] + (i-1)*alpha[1]) / 5);
+            alpha[6] = 0; alpha[7] = 255;
+        }
+        u64 bits = 0; for (u32 i = 0; i < 6; i++) bits |= (u64)block[2+i] << (8*i);
+        out[3] = alpha[(bits >> (3*pixel)) & 7];
