+    const char* base = getenv("RSX_SHADER_CACHE"); if (!base) base = "shadercache";
+    CreateDirectoryA(base, NULL); CreateDirectoryA(dir, NULL);
+    if (pso_warm_code(dir, r.vs_hash, pd->VS.pShaderBytecode, r.vs_bytes) &&
+        pso_warm_code(dir, r.ps_hash, pd->PS.pShaderBytecode, r.ps_bytes) && pso_warm_write(path, &r, sizeof r)) s_pso_warm_learned++;
+}
+static int pso_warm_read_recipe(const char* path, PsoWarmRecipe* r) {
+    FILE* f = fopen(path, "rb"); if (!f) return 0;
+    int ok = fread(r, 1, sizeof *r, f) == sizeof *r && fgetc(f) == EOF; fclose(f);
+    if (!ok || r->magic != 0x31574D5241503547ull || r->version != 1 || r->size != sizeof *r ||
+        r->checksum != pso_hash_bytes(1469598103934665603ull, r, offsetof(PsoWarmRecipe, checksum))) return 0;
+    const D3D12_GRAPHICS_PIPELINE_STATE_DESC* d = &r->desc;
+    if (d->pRootSignature || d->VS.pShaderBytecode || d->PS.pShaderBytecode || d->DS.pShaderBytecode || d->HS.pShaderBytecode || d->GS.pShaderBytecode ||
+        d->GS.BytecodeLength || d->HS.BytecodeLength || d->DS.BytecodeLength || d->InputLayout.pInputElementDescs ||
+        d->StreamOutput.pSODeclaration || d->StreamOutput.pBufferStrides || d->StreamOutput.NumEntries || d->StreamOutput.NumStrides ||
+        d->CachedPSO.pCachedBlob || d->CachedPSO.CachedBlobSizeInBytes || d->InputLayout.NumElements > PSO_WARM_INPUTS ||
+        d->NumRenderTargets > 8 || !r->vs_bytes || !r->ps_bytes || r->vs_bytes > PSO_WARM_CODE_MAX || r->ps_bytes > PSO_WARM_CODE_MAX ||
+        d->VS.BytecodeLength != r->vs_bytes || d->PS.BytecodeLength != r->ps_bytes) return 0;
+    for (u32 i = 0; i < d->InputLayout.NumElements; i++)
+        if (r->input[i].desc.SemanticName || !memchr(r->input[i].name, 0, sizeof r->input[i].name)) return 0;
+    return 1;
+}
+static void* pso_warm_read_code(const char* dir, u64 hash, u32 bytes) {
+    char path[640]; snprintf(path, sizeof path, "%s/code_%016llx.dxbc", dir, (unsigned long long)hash);
+    FILE* f = fopen(path, "rb"); if (!f) return NULL;
+    void* data = malloc(bytes); int ok = data && fread(data, 1, bytes, f) == bytes && fgetc(f) == EOF;
+    fclose(f);
+    if (ok && pso_hash_bytes(1469598103934665603ull, data, bytes) == hash) return data;
+    free(data); return NULL;
+}
