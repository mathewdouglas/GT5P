+          w[channel & 127]++;
+          if ((++n % (unsigned long long)s_c) == 0) { fprintf(stderr, "[chw] %llu writes:%c", n, 10);
+              for (int i = 0; i < 128; i++) if (w[i])
+                  fprintf(stderr, "   wrch ch%-3d %llu%c", i, w[i], 10); } } }
