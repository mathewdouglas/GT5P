+static void ix_end_body(void)
+{
+    if (s_gf_call) {
+        const unsigned long long _dpf = DP_T0();
+        const int _gfok = vgpu_finish();
+        DP_ADD(DP_VGPUFIN, _dpf);
+        if (_gfok) { s_ix_last = 1; return; }
+        /* Could not copy the raw bytes: convert these vertices here after all
+         * (without the carried indices, which the CPU path's merge handles). */
+        s_gf_call = 0;
+        if (s_gf_pre) { memmove(s_ix_tmp, s_ix_tmp + s_gf_pre, (s_ix_n - s_gf_pre) * sizeof s_ix_tmp[0]);
+                        s_ix_n -= s_gf_pre; s_gf_pre = 0; }
+        u32 n = s_ix_n; s_ix_nv = 0;
+        for (u32 i = 0; i < n; i++) {
+            int l = ix_vertex(s_gf_st, s_ix_tmp[i]);
+            if (l < 0) { s_ix_n = i - i % 3u; break; }
+            s_ix_tmp[i] = (u32)l;
