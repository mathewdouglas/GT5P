+                s_ov_up[i] = NULL;
+        s_ov_tw = w; s_ov_th = h;
+        if (!s_ov_tex || !s_ov_up[0] || !s_ov_up[1] || !s_ov_up[2]) {
+            overlay_retire(); s_ov_tw = s_ov_th = 0;
+            ReleaseSRWLockShared(&s_ov_lk);
+            fprintf(stderr, "[overlay] %dx%d resources failed%c", w, h, 10);
