+/* The descriptors of the upload just made, into record slot `slot`. */
+static u32 vgpu_def_hash(void)
+{
+    u32 h = 2166136261u; const u8* b = (const u8*)s_gf_def;
+    for (size_t i = 0; i < sizeof s_gf_def; i++) h = (h ^ b[i]) * 16777619u;
