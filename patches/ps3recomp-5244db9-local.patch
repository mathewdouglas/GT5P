+            if (!ev[i].at) continue;
+            rel = (u32)(tnow - ev[i].at);
+        }
+        if (ev[i].unless[0] && pad_milestone_at(ev[i].unless)) continue;
+        if (rel >= ev[i].from && rel < ev[i].to) btns |= ev[i].btn;
