+typedef struct { uint64_t us; uint32_t tid, a, b; char kind; } TlEv;
+static TlEv* s_tl;
+static volatile LONG s_tl_n;
+static LONG s_tl_cap;
+static int s_tl_state = -1;            /* -1 unread, 0 off/done, 1 waiting, 2 recording */
