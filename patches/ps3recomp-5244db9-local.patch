+static void ix_end_body(void)
+{
+    if (s_gf_call) {
+        const unsigned long long _dpf = DP_T0();
+        const int _gfok = vgpu_finish();
+        DP_ADD(DP_VGPUFIN, _dpf);
+        if (_gfok) { s_ix_last = 1; return; }
