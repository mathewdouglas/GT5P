+        int shown = 0;
+        for (const D3D12_AUTO_BREADCRUMB_NODE1* n = bo.pHeadAutoBreadcrumbNode; n && shown < 8; n = n->pNext) {
+            UINT last = n->pLastBreadcrumbValue ? *n->pLastBreadcrumbValue : 0;
+            if (last >= n->BreadcrumbCount) continue;   /* finished */
+            shown++;
+            fprintf(stderr, "[DRED] list %ls queue %ls: completed %u of %u ops\n",
+                    n->pCommandListDebugNameW ? n->pCommandListDebugNameW : L"?",
+                    n->pCommandQueueDebugNameW ? n->pCommandQueueDebugNameW : L"?", last, n->BreadcrumbCount);
+            const wchar_t* ctx = NULL; UINT ci = 0;
+            for (UINT k = 0; k < n->BreadcrumbContextsCount; k++)
+                if (n->pBreadcrumbContexts[k].BreadcrumbIndex <= last &&
+                    (!ctx || n->pBreadcrumbContexts[k].BreadcrumbIndex >= ci)) {
+                    ctx = n->pBreadcrumbContexts[k].pContextString; ci = n->pBreadcrumbContexts[k].BreadcrumbIndex;
+                }
+            if (ctx) fprintf(stderr, "[DRED]   last marker (op %u): %ls\n", ci, ctx);
+            { int k = 0;
+              for (UINT j = 0; j <= last && j < n->BreadcrumbCount; j++)
+                  if (n->pCommandHistory[j] == D3D12_AUTO_BREADCRUMB_OP_COPYTEXTUREREGION ||
+                      n->pCommandHistory[j] == D3D12_AUTO_BREADCRUMB_OP_COPYBUFFERREGION) k++;
+              if (k) for (int f = 0; f < 4; f++) {
+                  int q = (s_dred_cur - f) & 3;
+                  fprintf(stderr, "[DRED]   copy #%d of the list %d back%s: line %d (%d copies logged)\n",
+                          k, f, f ? "" : " (recording)", k <= s_dred_n[q] && k <= 8192 ? s_dred_cl[q][k - 1] : -1,
+                          s_dred_n[q]);
+              } }
+            UINT lo = last > 6 ? last - 6 : 0, hi = last + 6 < n->BreadcrumbCount ? last + 6 : n->BreadcrumbCount;
+            for (UINT k = lo; k < hi; k++) {
+                const wchar_t* c = NULL;
+                for (UINT j = 0; j < n->BreadcrumbContextsCount; j++)
+                    if (n->pBreadcrumbContexts[j].BreadcrumbIndex == k) c = n->pBreadcrumbContexts[j].pContextString;
+                fprintf(stderr, "[DRED]   %s op %u %s%s%ls\n", k == last ? ">>" : "  ", k,
+                        dred_op_name(n->pCommandHistory[k]), c ? " " : "", c ? c : L"");
+            }
+        }
+        if (!shown) fprintf(stderr, "[DRED] every command list completed\n");
+    } else fprintf(stderr, "[DRED] no breadcrumbs\n");
+    D3D12_DRED_PAGE_FAULT_OUTPUT1 pf = {0};
+    if (SUCCEEDED(dred->lpVtbl->GetPageFaultAllocationOutput1(dred, &pf)) && pf.PageFaultVA) {
+        fprintf(stderr, "[DRED] page fault at GPU VA 0x%llX\n", (unsigned long long)pf.PageFaultVA);
+        for (const D3D12_DRED_ALLOCATION_NODE1* a = pf.pHeadExistingAllocationNode; a; a = a->pNext)
+            fprintf(stderr, "[DRED]   existing: %ls type %d\n", a->ObjectNameW ? a->ObjectNameW : L"?", (int)a->AllocationType);
+        for (const D3D12_DRED_ALLOCATION_NODE1* a = pf.pHeadRecentFreedAllocationNode; a; a = a->pNext)
+            fprintf(stderr, "[DRED]   freed: %ls type %d\n", a->ObjectNameW ? a->ObjectNameW : L"?", (int)a->AllocationType);
+    } else fprintf(stderr, "[DRED] no page fault\n");
+    dred->lpVtbl->Release(dred);
+    fflush(stderr);
+}
