+/* PAD_MILESTONE_FILES=<entry>[,<entry>...]: these files are milestones too.
+ * An entry "<name>" matches that exact base name (as opened or stat'ed) and
+ * is named as written. An entry "<label>=<path tail>" matches a path ending
+ * in "/<path tail>" and is named <label>: Gran Turismo 5 reads hashed PDIPFS
+ * paths whose base names are two characters, e.g. "CarList=9/9U/4I". For a
+ * title with no .gpb screen scripts; installed00.dat is the first named file
+ * of GT5's boot. Returns the milestone name, or NULL. */
+static const char* pad_milestone_file_listed(const char* path, const char* b, char* out, size_t outn)
+{
+    static char list[1024]; static int init = 0;
+    if (!init) { const char* e = getenv("PAD_MILESTONE_FILES");
+                 if (e) { strncpy(list, e, sizeof list - 1); list[sizeof list - 1] = 0; }
+                 init = 1; }
+    if (!list[0]) return NULL;
+    size_t bl = strlen(b), pl = strlen(path);
+    for (const char* p = list; *p; ) {
+        const char* c = strchr(p, ',');
+        size_t n = c ? (size_t)(c - p) : strlen(p);
+        const char* eq = memchr(p, '=', n);
+        if (eq) {
+            size_t ln = (size_t)(eq - p), tl = n - ln - 1;
+            const char* tail = eq + 1;
+            if (ln && ln < outn && tl && tl < pl && path[pl - tl - 1] == '/' &&
+                !strncmp(path + pl - tl, tail, tl)) {
+                memcpy(out, p, ln); out[ln] = 0; return out;
+            }
+        } else if (n == bl && !strncmp(p, b, n)) return b;
+        if (!c) break;
+        p = c + 1;
+    }
+    return NULL;
+}
