+/* Guest index array of the current draw, resolved once per call. */
+typedef struct { const u8* p; int u16; u32 bias; } IxSrc;
+static IxSrc ix_src(const rsx_state* st)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    IxSrc r;
+    r.p = vm_base + cellGcmResolveLocated((st->index_array_dma & 0xF) == 0, st->index_array_offset);
+    r.u16 = ((st->index_array_dma >> 4) & 0xF) == 1;
+    r.bias = st->vertex_base_index;
+    return r;
+}
+static inline u32 ix_read(const IxSrc* s, u32 k)
+{
+    const u8* p = s->p + (u64)k * (s->u16 ? 2u : 4u);
+    return (s->u16 ? (((u32)p[0] << 8) | p[1])
+                   : (((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3])) + s->bias;
