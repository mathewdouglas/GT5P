+                          if (!s_xf_tab[0] || !s_xf_tab[1] || !s_xf_tab[2]) v = 0; } }
+    return v;
+}
+static u64 xf_hash(const u8* p, u32 n, u64 h)
+{
+    while (n >= 8) { u64 w; memcpy(&w, p, 8); h = (h ^ w) * 0x100000001B3ull; h ^= h >> 29; p += 8; n -= 8; }
+    while (n--) h = (h ^ *p++) * 0x100000001B3ull;
+    return h;
+}
+static XfEnt* xf_find(XfEnt* t, u64 key, u32 gen, int add)
+{
+    u32 h = (u32)(key * 0x9E3779B97F4A7C15ull >> 48);
+    for (u32 i = 0; i < 64; i++, h = (h + 1) & (XF_N - 1)) {
+        XfEnt* e = &t[h];
+        if (e->gen != gen) return add ? e : NULL;
+        if (e->key == key) return e;
+    }
+    return NULL;
+}
+/* After ix_begin (the plan is built): one indexed call of `count` indices. */
+static void xf_note_impl(const rsx_state* st, u32 first, u32 count);
+static void xf_note(const rsx_state* st, u32 first, u32 count)
+{
+    double t = perf_now();
+    s_xf_lastrep = 0;
+    xf_note_impl(st, first, count);
+    s_xf_tnote += perf_now() - t;
+}
+static void xf_note_impl(const rsx_state* st, u32 first, u32 count)
