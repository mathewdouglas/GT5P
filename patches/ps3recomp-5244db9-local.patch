+extern "C" void ps3_gcm_pump_if_present(void);   /* ppu_hle.cpp */
+extern "C" void lv2_syscall(ppu_context* ctx)
+{
+    /* PPU_STACK_CHECK=1: report (first 16) syscalls made with r1 outside the
+     * calling thread's own stack -- one guest thread running on another's. */
+    { static int on = -1; static volatile long n = 0;
+      if (on < 0) on = getenv("PPU_STACK_CHECK") ? 1 : 0;
+      if (on) {
+          char nm[64]; uint32_t sp = (uint32_t)ctx->gpr[1];
+          int own = ppu_thread_stack_owner(sp, nm, sizeof nm);
+          /* And each new low of the thread's sp, in 2 KB steps, with lr:
+           * deep recursion sinks once, a leaked frame sinks a little at a
+           * time at the same call site. */
+          { static uint32_t lowest[512];
+            unsigned t = (unsigned)ctx->thread_id & 511u;
+            if (!lowest[t] || sp + 0x800 < lowest[t]) {
+                lowest[t] = sp;
+                char fr[1200]; int fl = 0; uint32_t s2 = sp;
+                for (int k = 0; k < 48 && fl < (int)sizeof fr - 24; k++) {
+                    uint32_t back = vm_read32(s2 + 4);
+                    if (back <= s2 || back - s2 > 0x10000u) break;
+                    fl += snprintf(fr + fl, sizeof fr - fl, " %X/%X", back - s2, vm_read32(back + 20));
+                    s2 = back;
+                }
+                fr[fl] = 0;
+                fprintf(stderr, "[stack-low] tid=%u sp=0x%08X lr=0x%08X syscall %llu frames(size/ret):%s\n",
+                        (unsigned)ctx->thread_id, sp, (uint32_t)ctx->lr,
+                        (unsigned long long)ctx->gpr[11], fr);
+            } }
+          if (own && (unsigned)own != (unsigned)ctx->thread_id && InterlockedIncrement(&n) <= 16) {
+              fprintf(stderr, "[stack-check] tid=%u syscall %llu with sp=0x%08X on tid %d \"%s\" lr=0x%08X host=%lu ctx=%p\n",
+                      (unsigned)ctx->thread_id, (unsigned long long)ctx->gpr[11], sp, own, nm,
+                      (uint32_t)ctx->lr, (unsigned long)GetCurrentThreadId(), (void*)ctx);
+              ppu_dump_guest_stack(ctx, "stack-check");
