+         * used its rows hold 0x1FFF here, which is not one. */
+        const u32 head = vm_read16(hd + 0x40 + 16 * q);
+        const u32 v = vm_read16(hd + 0x40 + 16 * q + 4 + 2 * spu);
+        if (v != 0xFFFF && v < head) return (int)v;
+    }
+    return -1;
