+/* Priority hand-off at thread creation (opt-in: ppu_thread_set_prio_handoff).
+ *
+ * lv2 schedules PPU threads by strict priority, lower number first. Creating a
+ * thread of HIGHER priority than the creator therefore preempts the creator on
+ * the spot: the new thread runs until it first blocks, and only then does
+ * sys_ppu_thread_create return. Titles lean on that. One that starts a
+ * high-priority service thread and then immediately uses what the thread sets
+ * up has no lock around it and needs none on a PS3.
+ *
+ * Host threads all run at once, so without this the creator races the thread
+ * it just made. Here the creator waits until the new thread is seen inside a
+ * blocking lv2 call, or has finished, bounded so that a thread which blocks
+ * some way this cannot see (inside an HLE import, or never) costs a pause and
+ * not a hang. It does not model preemption after creation. */
+static int s_prio_handoff = 0;
+void ppu_thread_set_prio_handoff(int on) { s_prio_handoff = on; }
+
+/* PS3_PPU_PRIO_SCHED=<cores>: let the HOST scheduler stand in for lv2's.
+ *
+ * Confine every guest PPU thread to <cores> host cores (the PPU has two
+ * hardware threads, so 2 is the faithful value and 1 the strict one) and map
+ * guest priority onto host thread priority with dynamic boosting off. Among
+ * threads sharing a core Windows then runs the highest-priority ready one and
+ * preempts for it at once, which is the property titles rely on: a thread
+ * never observes a higher-priority one half-way through its work.
+ *
+ * The mapping is lossy -- seven host levels for 3072 guest ones -- so threads
+ * whose priorities fall in one band still interleave. Off by default. */
+#ifdef _WIN32
+static int host_sched_cores(void)
+{
+    static int n = -1;
+    if (n < 0) { const char* e = getenv("PS3_PPU_PRIO_SCHED"); n = e ? atoi(e) : 0; }
+    return n;
+}
+static void host_apply_prio(HANDLE h, int32_t prio)
+{
+    int n = host_sched_cores();
+    if (n <= 0 || !h) return;
+    SetThreadAffinityMask(h, n >= 2 ? 3 : 1);
+    SetThreadPriorityBoost(h, TRUE);            /* TRUE disables boosting */
+    SetThreadPriority(h, prio <= 1    ? THREAD_PRIORITY_TIME_CRITICAL
+                       : prio < 200   ? THREAD_PRIORITY_HIGHEST
+                       : prio < 400   ? THREAD_PRIORITY_ABOVE_NORMAL
+                       : prio < 800   ? THREAD_PRIORITY_NORMAL
+                       : prio < 1000  ? THREAD_PRIORITY_BELOW_NORMAL
+                       : prio <= 1001 ? THREAD_PRIORITY_LOWEST
+                       :                THREAD_PRIORITY_IDLE);
+}
+#else
+static int  host_sched_cores(void) { return 0; }
+#endif
