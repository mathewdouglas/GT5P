 #ifdef __cplusplus
 }
diff --git a/libs/codec/cellDmux.c b/libs/codec/cellDmux.c
index b0553858..541a0526 100644
--- a/libs/codec/cellDmux.c
+++ b/libs/codec/cellDmux.c
@@ -1,290 +1,686 @@
 /*
  * ps3recomp - cellDmux HLE implementation
  *
- * Stub demuxer that accepts PAMF data and reports AU-found callbacks.
- * Without real MPEG-TS parsing, this provides the API surface games
- * expect while the video pipeline is built out.
+ * A PAMF program-stream demultiplexer, behaving as libdmux does from the
+ * title's side:
+ *
+ *  - cellDmuxSetStream hands over a chunk of the program stream. The demuxer
+ *    thread walks its packs and PES packets, and when it has used it all it
+ *    sends DEMUX_DONE; the title then sets the next chunk. A packet cut by the
+ *    end of a chunk is kept and finished from the next one.
+ *  - Each enabled ES collects its PES payloads and cuts them into access
+ *    units: AVC at each access unit delimiter, ATRAC3plus at each ATS header
+ *    (the AU keeps its 8-byte header), anything else per PES packet. A
+ *    finished AU is copied into the ES buffer the title supplied and announced
+ *    with AU_FOUND. The last AU of a stream stays open until FlushEs.
+ *  - GetAu/PeekAu hand out the oldest unclaimed AU; ReleaseAu frees the oldest
+ *    claimed one. When the ES buffer is full the demuxer waits for releases.
+ *
+ * The AU information records live at the end of the ES buffer (the size
+ * cellDmuxQueryEsAttr reports includes them); the callback messages and the
+ * demuxer thread's guest stack live in the demuxer's own work memory.
+ *
+ * DMUX_TRACE=1 logs AUs and messages. DMUX_DUMP=<dir> writes the first 64 MB
+ * of program stream it is given to <dir>/dmux_<handle>.ps (game data: keep it
+ * in scratch/).
  */
 
 #include "cellDmux.h"
+#include "cellPamf.h"
+#include "codec_host.h"
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
-#include "../guest_struct.h"   /* GUEST_EA, guest_struct_load/store */
+
+#define DMUX_MAX        4
+#define DMUX_MAX_ES     8
+#define AU_MAX          1024u
+#define AU_REC          0x40u          /* per AU: CellDmuxAuInfo(Ex) + specific info */
+#define ES_DATA_VIDEO   0x01000000u   /* 16 MB: the title keeps seconds of audio ahead (see QueryEsAttr) */
+#define ES_DATA_AUDIO   0x00100000u
+#define DMUX_MEM        (CODEC_CB_STACK + 0x100u)
+
+typedef struct { u32 off, size; u64 pts, dts, user; int rap; } DmuxAu;
+typedef struct { u32 at; u64 pts, dts; } DmuxTs;
+
+typedef struct DmuxEs {
+    int used;
+    u32 handle;                  /* what the title holds: the ES buffer address */
+    u32 major, minor;
+    int type;                    /* SDK stream type */
+    u32 cb_fn, cb_arg;
+    u32 mem, data_size;          /* data ring [mem, mem + data_size), records after */
+    DmuxAu au[AU_MAX];
+    u32 head, count, claimed;    /* FIFO of AUs in the ring; claimed = handed out */
+    u32 wr;                      /* ring write offset */
+    u8* asmb; u32 alen, acap;    /* AU being assembled, host side */
+    DmuxTs ts[64]; u32 nts;      /* PES timestamps and where they fell in asmb */
+    u32 scan;                    /* AVC: where the delimiter search resumes */
+    int flush_req;
+    u64 user;                    /* userData of the stream the AU came from */
+    u64 last_pts;                /* audio: the last AU's PTS, for those without */
+} DmuxEs;
+
+typedef struct Dmux {
+    int used;
+    u32 handle;                  /* the work memory address */
+    u32 mem, mem_size;
+    u32 cb_fn, cb_arg;
+    codec_lock lock;
+    codec_cond cond;
+    codec_thread thread;
+    int quit;
+    /* the stream being demultiplexed */
+    int busy, reset_req, done_pending;
+    u32 st_addr, st_size;
+    u64 st_user;
+    u8* carry; u32 clen, ccap;
+    DmuxEs es[DMUX_MAX_ES];
+    FILE* dump; u64 dumped;
+} Dmux;
+
+static Dmux s_dm[DMUX_MAX];
+static codec_lock s_glock;
+static int s_glock_ok;
+
+static int trace_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("DMUX_TRACE"); v = e && e[0] == '1'; }
+    return v;
+}
+
+static void glock(void)
+{
+    if (!s_glock_ok) { codec_lock_init(&s_glock); s_glock_ok = 1; }
+    codec_lock_take(&s_glock);
+}
+
+static Dmux* dm_find(u32 h)
+{
+    for (int i = 0; i < DMUX_MAX; i++) if (s_dm[i].used && s_dm[i].handle == h) return &s_dm[i];
+    return NULL;
+}
+
+static DmuxEs* es_find(u32 h, Dmux** out)
+{
+    for (int i = 0; i < DMUX_MAX; i++) {
