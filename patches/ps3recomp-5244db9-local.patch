+/* Back the system cache (/dev_hdd1) for cellSysCacheMount. As on the console,
+ * a mount with the cache id of the previous one keeps the contents (returns 1,
+ * CELL_SYSCACHE_RET_OK_RELAYED); any other id gets an empty cache (returns 0,
+ * CELL_SYSCACHE_RET_OK_CLEARED). The id is kept beside the folder, not in it,
+ * so the title never sees it. */
+int ps3_fs_syscache_prepare(const char* cache_id)
+{
+    char dir[CELL_FS_MAX_FS_PATH_LENGTH];
+    if (translate_path("/dev_hdd1", dir, sizeof(dir)) != 0)
+        return -1;
+    char probe[CELL_FS_MAX_FS_PATH_LENGTH + 2];
+    snprintf(probe, sizeof(probe), "%s/x", dir);
+    ensure_parent_dirs(probe);
+
+    char idfile[CELL_FS_MAX_FS_PATH_LENGTH + 8];
+    snprintf(idfile, sizeof(idfile), "%s.id", dir);
+    char prev[64] = {0};
+    FILE* f = fopen(idfile, "rb");
+    if (f) { size_t n = fread(prev, 1, sizeof(prev) - 1, f); prev[n] = 0; fclose(f); }
+    if (prev[0] && strcmp(prev, cache_id) == 0)
+        return 1;
+
+    host_clear_dir(dir);
+    f = fopen(idfile, "wb");
+    if (f) { fputs(cache_id, f); fclose(f); }
+    return 0;
+}
