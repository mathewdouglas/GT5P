+/* The CPU path's input layout points every attribute outside the input mask
+ * (SET_VERTEX_ATTRIB_INPUT_MASK) at offset 0 of the vertex, so a program that
+ * reads one gets attribute 0's data, not the constant register. Do the same.
+ * RSX_VTXGPU_MASKDUP=0: the constant register. */
+static void vgpu_mask_dup(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_VTXGPU_MASKDUP"); on = !(e && e[0] == '0'); }
+    if (!on) return;
+    for (int k = 1; k < 16; k++)
+        if (!(s_cur_vmask & (1u << k))) {
+            memcpy(s_gf_desc[k], s_gf_desc[0], sizeof s_gf_desc[0]);
+            memcpy(s_gf_def[k], s_gf_def[0], sizeof s_gf_def[0]);
+        }
+}
+static void vgpu_write_desc(u32 slot)
+{
+    vgpu_mask_dup();
+    if (!s_vfcb_mapped || slot >= s_draw_cap) return;
+    u8* d = s_vfcb_mapped + ((size_t)FR->parity * s_draw_cap + slot) * VFCB_STRIDE;
+    memcpy(d, s_gf_desc, sizeof s_gf_desc);
+    memcpy(d + sizeof s_gf_desc, s_gf_def, sizeof s_gf_def);
