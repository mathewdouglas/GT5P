+    u32 profile_limit = pe ? (u32)strtoul(pe, NULL, 10) : 64;
+    if (profile_limit > 256) profile_limit = 256;
+    profiles[1].exp32 = 1; profiles[0].textures = profiles[1].textures = 0xFFFFFFFFu;
+    char pattern[640], path[640]; WIN32_FIND_DATAA fd;
+    const char* mode = getenv("RSX_SHADER_LIBRARY_PROFILES");
+    if (!mode || strcmp(mode, "base")) {
+        snprintf(pattern, sizeof pattern, "%s/fp-profiles-v2/*.txt", cache);
+        HANDLE f = FindFirstFileA(pattern, &fd);
+        if (f != INVALID_HANDLE_VALUE) {
+            do {
+                snprintf(path, sizeof path, "%s/fp-profiles-v2/%s", cache, fd.cFileName);
+                FILE* in = fopen(path, "r"); FpProfile p = {0}; unsigned long long samplers = 0;
+                int n = in ? fscanf(in, "%x %x %x %x %llx %x %x %x %x", &p.exp32, &p.cube, &p.stencil,
+                                    &p.unnorm, &samplers, &p.ghi, &p.shd, &p.unhi, &p.textures) : 0;
+                if (in) fclose(in); p.samplers = (u64)samplers;
+                if (n == 9 && p.textures <= 0xFFFFu && p.exp32 <= 1 && !(p.stencil & ~(1u << 26)) && np < profile_limit + 2) profiles[np++] = p;
+            } while (np < profile_limit + 2 && FindNextFileA(f, &fd));
+            FindClose(f);
+        }
+    }
+    snprintf(pattern, sizeof pattern, "%s/*.fp", dir);
+    HANDLE f = FindFirstFileA(pattern, &fd);
+    if (f == INVALID_HANDLE_VALUE) { fprintf(stderr, "[shader-library] no extracted fragment programs in %s\n", dir); return; }
+    u32 count = 0, rejected = 0, attempts = 0, visited = 0;
+    u32 old_ghi = s_pso_ghi, old_shd = s_pso_shd, old_unhi = s_pso_unhi;
+    const char* lim = getenv("RSX_SHADER_LIBRARY_LIMIT");
+    u32 limit = lim ? (u32)strtoul(lim, NULL, 10) : 16384;
