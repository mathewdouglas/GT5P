+        off_rt_transition(sl, D3D12_RESOURCE_STATE_COPY_SOURCE);
+        u32 y = 0;
+        for (u32 l = 0; l < c->mips; l++) {
+            u32 d = (c->w >> l) ? (c->w >> l) : 1u;
+            if (y + d > r->h) break;
+            D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+            dst.pResource = c->res; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+            dst.SubresourceIndex = l + f * c->mips;
+            src.pResource = r->res; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+            src.SubresourceIndex = 0;
+            D3D12_BOX box = { 0, y, 0, d, y + d, 1 };
+            DRED_MARK_COPY(s_d3d.cmd_list);
+            s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dst, 0, 0, 0, &src, &box);
+            y += d;
+        }
+    }
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+}
+
+static void screen_copy_ensure(void)
+{
+    if (s_screen_copy || !s_d3d.device) return;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = s_d3d.width; td.Height = s_d3d.height;
+    td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL,
+            &IID_ID3D12Resource, (void**)&s_screen_copy)))
+        s_screen_copy = NULL;
+}
+
+/* A copy of the shared depth buffer that a draw can sample. The guest binds
+ * its depth surface as a texture (depth of field in this title's menu); the
+ * depth buffer itself is cleared at every change of target, so it is copied
+ * out when the draws that filled it are over. Same size as the depth buffer;
+ * typeless so that it can take the copy and still be read as R24. */
+#define DEPTH_COPY_DIM 2048
+/* As wide as the shared depth buffer (CopyResource needs the same size). */
+static u32 depth_copy_w(void) { return s_d3d.width > DEPTH_COPY_DIM ? s_d3d.width : DEPTH_COPY_DIM; }
+static u32 depth_copy_h(void) { return s_d3d.height > DEPTH_COPY_DIM ? s_d3d.height : DEPTH_COPY_DIM; }
+static ID3D12Resource* s_depth_copy = NULL;
+static u32 s_dz_want;      /* zeta offset some draw samples this frame, 0 = none */
+static u32 s_dz_src;       /* colour target that depth was drawn with, 0 = the display */
+static ID3D12PipelineState* s_depth_resolve_pso;
+
+static D3D12_CPU_DESCRIPTOR_HANDLE depth_copy_dsv(void)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_d3d.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.dsv_heap, &h);
+    h.ptr += (SIZE_T)(2 + ZB_MAX) * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_DSV);
+    return h;
+}
+
+/* D3D12 cannot CopyResource a multisampled depth image into a single-sample
+ * image. Resolve in a depth-only draw, retaining the nearest covered depth
+ * at edges so foreground does not acquire the background's defocus. */
+static int depth_resolve_ensure(void)
+{
+    if (s_depth_resolve_pso) return 1;
+    static const char src[] =
+        "Texture2DMS<float> z : register(t0);"
+        "float4 vs(uint i : SV_VertexID) : SV_Position {"
+        " return float4(i == 1 ? 3 : -1, i == 2 ? -3 : 1, 0, 1); }"
+        "float ps(float4 p : SV_Position) : SV_Depth {"
+        " uint w,h,n; z.GetDimensions(w,h,n); float d=1;"
+        " for(uint i=0;i<n;i++) d=min(d,z.Load(int2(p.xy),i)); return d; }";
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL;
+    HRESULT hr = D3DCompile(src, sizeof(src)-1, "depth-resolve", NULL, NULL,
+        "vs", "vs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vs, &err);
+    if (err) { err->lpVtbl->Release(err); err = NULL; }
+    if (SUCCEEDED(hr)) hr = D3DCompile(src, sizeof(src)-1, "depth-resolve", NULL, NULL,
+        "ps", "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &ps, &err);
+    if (SUCCEEDED(hr)) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = s_d3d.vp_root_sig;
+        pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+        pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+        pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+        pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.RasterizerState.DepthClipEnable = TRUE;
+        pd.DepthStencilState.DepthEnable = TRUE;
+        pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+        pd.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+        pd.SampleMask = UINT_MAX;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+        pd.SampleDesc.Count = 1;
+        hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(s_d3d.device, &pd,
+            &IID_ID3D12PipelineState, (void**)&s_depth_resolve_pso);
+    }
+    if (FAILED(hr)) fprintf(stderr, "[depth-resolve] creation failed 0x%08lX %s%c",
+        (unsigned long)hr, err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "", 10);
+    if (err) err->lpVtbl->Release(err);
+    if (vs) vs->lpVtbl->Release(vs);
+    if (ps) ps->lpVtbl->Release(ps);
+    return s_depth_resolve_pso != NULL;
+}
+
+static void depth_copy_ensure(void)
+{
+    if (s_depth_copy || !s_d3d.device) return;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = depth_copy_w(); td.Height = depth_copy_h();
+    td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R24G8_TYPELESS; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL,
+            &IID_ID3D12Resource, (void**)&s_depth_copy);
+    if (FAILED(hr)) {
+        s_depth_copy = NULL;
+        fprintf(stderr, "[D3D12] depth copy creation failed (0x%08lX)%c", (unsigned long)hr, 10);
+    }
+    if (s_depth_copy) {
+        D3D12_DEPTH_STENCIL_VIEW_DESC dv = {0};
+        dv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+        dv.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+        s_d3d.device->lpVtbl->CreateDepthStencilView(s_d3d.device, s_depth_copy, &dv, depth_copy_dsv());
+    }
+}
+
+static void depth_copy_capture(int rt)
+{
+    if (!s_depth_copy || !s_d3d.depth_buffer) return;
+    static int ms_copy = -1;
+    if (ms_copy < 0) { const char* e = getenv("RSX_MSAA_DEPTH_COPY"); ms_copy = !(e && e[0] == '0'); }
+    if (ms_copy && rt >= 0 && s_d3d.off_rt[rt].ms && s_ms_depth && depth_resolve_ensure()) {
+        D3D12_RESOURCE_BARRIER b[2] = {0};
+        b[0].Type = b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[0].Transition.pResource = s_ms_depth;
+        b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+        b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[1].Transition = b[0].Transition;
+        b[1].Transition.pResource = s_depth_copy;
+        b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 2, b);
+        /* Reserved slot 21 is outside RT views and all per-draw windows. */
+        D3D12_CPU_DESCRIPTOR_HANDLE ch;
+        D3D12_GPU_DESCRIPTOR_HANDLE gh;
+        s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &ch);
+        s_d3d.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &gh);
+        ch.ptr += 21u * s_d3d.srv_inc; gh.ptr += 21u * s_d3d.srv_inc;
+        D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+        sv.Format = DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DMS;
+        sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, s_ms_depth, &sv, ch);
+        D3D12_CPU_DESCRIPTOR_HANDLE dh = depth_copy_dsv();
+        s_d3d.cmd_list->lpVtbl->OMSetRenderTargets(s_d3d.cmd_list, 0, NULL, FALSE, &dh);
+        s_d3d.cmd_list->lpVtbl->ClearDepthStencilView(s_d3d.cmd_list, dh,
+            D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL, 1.0f, 0, 0, NULL);
+        D3D12_VIEWPORT vp = {0, 0, (float)s_ms_w, (float)s_ms_h, 0, 1};
+        D3D12_RECT sc = {0, 0, (LONG)s_ms_w, (LONG)s_ms_h};
+        s_d3d.cmd_list->lpVtbl->RSSetViewports(s_d3d.cmd_list, 1, &vp);
+        s_d3d.cmd_list->lpVtbl->RSSetScissorRects(s_d3d.cmd_list, 1, &sc);
+        s_d3d.cmd_list->lpVtbl->SetPipelineState(s_d3d.cmd_list, s_depth_resolve_pso);
+        s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 1, gh);
+        s_d3d.cmd_list->lpVtbl->DrawInstanced(s_d3d.cmd_list, 3, 1, 0, 0);
+        for (int i = 0; i < 2; i++) {
+            D3D12_RESOURCE_STATES before = b[i].Transition.StateBefore;
+            b[i].Transition.StateBefore = b[i].Transition.StateAfter;
+            b[i].Transition.StateAfter = before;
+        }
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 2, b);
+        static int logged;
+        if (!logged) { logged = 1;
+            fprintf(stderr, "[depth-resolve] %ux%u %u samples -> sampled depth%c", s_ms_w, s_ms_h, s_ms_n, 10); }
+        return;
+    }
+    D3D12_RESOURCE_BARRIER bb[2] = {0};
+    bb[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    bb[0].Transition.pResource   = s_d3d.depth_buffer;
+    bb[0].Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    bb[0].Transition.StateAfter  = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    bb[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    bb[1] = bb[0];
+    bb[1].Transition.pResource   = s_depth_copy;
+    bb[1].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    bb[1].Transition.StateAfter  = D3D12_RESOURCE_STATE_COPY_DEST;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 2, bb);
+    s_d3d.cmd_list->lpVtbl->CopyResource(s_d3d.cmd_list, s_depth_copy, s_d3d.depth_buffer);
+    bb[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    bb[0].Transition.StateAfter  = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    bb[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    bb[1].Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 2, bb);
+}
+
+/* Depth-only passes. A draw with colour target NONE and a depth surface (GT5
+ * Prologue's shadow pass: 18 draws into a 1024x1024 DEPTH24_D8 at local
+ * 0x5080000) used to land on the display with the shared depth buffer, which
+ * is cleared at every change of target, so nothing that sampled the surface
+ * saw it. Each such surface now has a depth buffer of its own, kept from frame
+ * to frame, and a unit bound to it with a depth format compares against it
+ * (rsx_shd<u> in the fragment program). RSX_ZONLY=0: as before. */
+static struct { u32 off, w, h; ID3D12Resource* res; D3D12_RESOURCE_STATES st; int fresh; u32 gw, gh; } s_zb[ZB_MAX];
+static u64 s_zb_first;   /* frame of the first depth-only pass, 0 = none yet */
+
+static int zb_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_ZONLY"); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE zb_dsv(int i)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_d3d.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.dsv_heap, &h);
+    h.ptr += (SIZE_T)(2 + i) * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_DSV);
+    return h;
+}
+
+static int zb_find(u32 off)
+{
+    for (int i = 0; i < ZB_MAX; i++)
+        if (s_zb[i].res && s_zb[i].off == off) return i;
+    return -1;
+}
+
+/* The buffer for surface `off` at w x h, made if there is none. A buffer is
+ * never remade at another size, since the GPU may still be reading it (the
+ * Phase 33 device removal); a new size takes a new slot. */
+static int zb_get_impl(u32 off, u32 w, u32 h);
+static int zb_get(u32 off, u32 w, u32 h)
+{
+    const int i = zb_get_impl(off, w, h);
+    if (i >= 0) {
+        const int sc = rs_guest_scaled(w, h);
+        s_zb[i].gw = sc ? w : 0; s_zb[i].gh = sc ? h : 0;
+    }
+    return i;
+}
+/* The guest size a target or depth surface holds (native scaling). */
+static u32 rt_gw(int i) { const OffRT* r = &s_d3d.off_rt[i]; return r->gw ? r->gw : uw_guest_w(r->w, r->h); }
+static u32 rt_gh(int i) { const OffRT* r = &s_d3d.off_rt[i]; return r->gh ? r->gh : uw_guest_h(r->w, r->h); }
+static u32 zbs_gw(int i) { return s_zb[i].gw ? s_zb[i].gw : uw_guest_w(s_zb[i].w, s_zb[i].h); }
+static u32 zbs_gh(int i) { return s_zb[i].gh ? s_zb[i].gh : uw_guest_h(s_zb[i].w, s_zb[i].h); }
+static int zb_get_impl(u32 off, u32 w, u32 h)
+{
+    { const u32 gw0 = w; w = uw_host_w(gw0, h); h = uw_host_h(gw0, h); }
+    for (int i = 0; i < ZB_MAX; i++)
+        if (s_zb[i].res && s_zb[i].off == off && s_zb[i].w == w && s_zb[i].h == h) return i;
+    int i = 0;
+    while (i < ZB_MAX && s_zb[i].res) i++;
+    if (i == ZB_MAX || !s_d3d.device || !s_d3d.dsv_heap ||
+        w < 1 || h < 1 || w > 8192 || h > 8192) return -1;   /* 5120x2160 at 4K ultrawide */
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w; td.Height = h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R24G8_TYPELESS; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT; cv.DepthStencil.Depth = 1.0f;
+    ID3D12Resource* r = NULL;
+    HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv, &IID_ID3D12Resource, (void**)&r);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[ZONLY] depth buffer %ux%u for 0x%X failed (0x%08lX)%c",
+                w, h, off, (unsigned long)hr, 10);
+        return -1;
+    }
+    D3D12_DEPTH_STENCIL_VIEW_DESC dv = {0};
+    dv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    dv.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+    s_d3d.device->lpVtbl->CreateDepthStencilView(s_d3d.device, r, &dv, zb_dsv(i));
+    s_zb[i].off = off; s_zb[i].w = w; s_zb[i].h = h; s_zb[i].res = r;
+    s_zb[i].st = D3D12_RESOURCE_STATE_DEPTH_WRITE; s_zb[i].fresh = 1;
+    fprintf(stderr, "[ZONLY] depth-only surface 0x%X: %ux%u depth buffer in slot %d%c",
+            off, w, h, i, 10);
+    return i;
+}
+
+/* Colour targets that are not window-sized get no shared depth buffer
+ * (cur_has_dsv). One whose draws depth-test gets a buffer of its own instead,
+ * keyed by the guest depth surface and the target's size, and cleared only by
+ * the guest's own clears. GT5 Prologue's reflection probe (six 256x511 cube
+ * faces with a 256x256 depth surface) depth-tests its sky behind the
+ * scenery; with no depth the sky, drawn last, covered a tunnel, the probe
+ * metered daylight and the exposure never rose there. RSX_RT_OWN_DEPTH=0: as
+ * before (no depth buffer). */
+static int rt_own_depth_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_RT_OWN_DEPTH"); on = !(e && e[0] == '0'); }
+    return on;
+}
+static int dr_wants_depth(const D3D12DrawRecord* dr)
+{
+    if (!dr->zeta_off) return 0;
+    if (dr->is_clear) return dr->clear_z_flags != 0;
+    /* rsx_depth_bits: ALWAYS with writes off is "no depth test". */
+    return !(((dr->stencil >> 28) & 7u) == 7u && (dr->stencil >> 31)) || (dr->stencil & 1u);
+}
+
+static void zb_transition(int i, D3D12_RESOURCE_STATES to)
+{
+    if (s_zb[i].st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource   = s_zb[i].res;
+    b.Transition.StateBefore = s_zb[i].st;
+    b.Transition.StateAfter  = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    s_zb[i].st = to;
+}
+
+/* Before a draw samples buffer i. One nothing has drawn into yet reads as the
+ * far plane, so every compare passes, as outside the map (white border). */
+static void zb_for_sampling(int i)
+{
+    if (s_zb[i].fresh) {
+        zb_transition(i, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+        s_d3d.cmd_list->lpVtbl->ClearDepthStencilView(s_d3d.cmd_list, zb_dsv(i),
+            D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL, 1.0f, 0, 0, NULL);
+        s_zb[i].fresh = 0;
+    }
+    zb_transition(i, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+}
+
+/* Small results the title reads back with the CPU. This backend keeps render
+ * targets on the GPU and never writes them to guest memory, so a title that
+ * reduces an image on the GPU and reads the result (GT5 Prologue's average
+ * luminance, which sets its exposure and bloom) reads stale bytes. A draw of
+ * at most 16 pixels into an offscreen target is copied out at the end of the
+ * frame and written into the surface's guest bytes when the next frame
+ * starts, when the GPU is idle (render_frame_body waits for it).
+ * A8R8G8B8 targets only. RSX_RT_WB=0: never; RSX_RT_WB_SIDE=<n>: also
+ * regions up to n x n (diagnostic, 64 at most). */
+#define WB_MAX 64
+#define WB_SLOT 16384u           /* readback bytes per request: 64 rows of 256 */
+/* hx, hw: the region's columns in the resource (a widened target's are 4/3
+ * wider, ultrawide native); guest column c reads host column
+ * (u32)((x + c) * kx) - hx. */
+/* bpp: 4 for an 8-bit target, 8 for one kept at 16 bits (RSX_HIGH_PRECISION);
+ * the slot's rows are then 512 bytes apart and hold 32 rows. */
+static struct { int rt; u32 x, y, w, h, ea, pitch, hx, hw, hy, hh, bpp; float kx, ky; } s_wb[WB_MAX], s_wb_done[WB_MAX];
+static int s_wb_n, s_wb_done_n;
