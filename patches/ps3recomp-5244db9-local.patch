+static void pso_job_release_source(PsoAsyncJob* j) {
+    free(j->vs); free(j->ps); j->vs = j->ps = NULL;
+    if(j->owned_bytes) {InterlockedAdd64(&s_pso_source_bytes,-(LONG64)j->owned_bytes);j->owned_bytes=0;}
+    if (j->desc.pRootSignature) j->desc.pRootSignature->lpVtbl->Release(j->desc.pRootSignature);
+    j->desc.pRootSignature = NULL;
+}
+static int pso_job_copy(PsoAsyncJob* j, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd) {
+    if (!pd || !pd->pRootSignature || !pd->VS.pShaderBytecode || !pd->PS.pShaderBytecode ||
+        !pd->VS.BytecodeLength || !pd->PS.BytecodeLength ||
+        pd->VS.BytecodeLength > PSO_WARM_CODE_MAX || pd->PS.BytecodeLength > PSO_WARM_CODE_MAX ||
+        pd->InputLayout.NumElements > PSO_WARM_INPUTS || pd->StreamOutput.NumEntries ||
+        pd->StreamOutput.NumStrides || pd->GS.BytecodeLength || pd->HS.BytecodeLength || pd->DS.BytecodeLength)
+        return 0;
+    for (u32 i = 0; i < pd->InputLayout.NumElements; ++i)
+        if (!pd->InputLayout.pInputElementDescs || !pd->InputLayout.pInputElementDescs[i].SemanticName ||
+            strlen(pd->InputLayout.pInputElementDescs[i].SemanticName) >= sizeof j->names[i]) return 0;
+    j->vs = malloc(pd->VS.BytecodeLength); j->ps = malloc(pd->PS.BytecodeLength);
+    if (!j->vs || !j->ps) { free(j->vs); free(j->ps); j->vs = j->ps = NULL; return -1; }
+    memcpy(j->vs, pd->VS.pShaderBytecode, pd->VS.BytecodeLength);
+    memcpy(j->ps, pd->PS.pShaderBytecode, pd->PS.BytecodeLength);
+    j->desc = *pd; j->desc.VS.pShaderBytecode = j->vs; j->desc.PS.pShaderBytecode = j->ps;
+    j->desc.CachedPSO.pCachedBlob = NULL; j->desc.CachedPSO.CachedBlobSizeInBytes = 0;
+    j->desc.InputLayout.pInputElementDescs = j->input;
+    for (u32 i = 0; i < pd->InputLayout.NumElements; ++i) {
+        j->input[i] = pd->InputLayout.pInputElementDescs[i];
+        strcpy(j->names[i], j->input[i].SemanticName); j->input[i].SemanticName = j->names[i];
+    }
+    pd->pRootSignature->lpVtbl->AddRef(pd->pRootSignature);
+    j->owned_bytes=(u64)pd->VS.BytecodeLength+pd->PS.BytecodeLength;
+    InterlockedAdd64(&s_pso_source_bytes,(LONG64)j->owned_bytes);
+    return 1;
+}
+static int pso_worker_start_locked(void) {
+    if (s_pso_stopping) return 0;
+    if (!s_pso_worker) {
+        if (!s_race_ready) s_race_ready = CreateEventA(NULL, TRUE, TRUE, NULL);
+        if (s_race_ready) s_pso_worker = CreateThread(NULL, 0, pso_worker_main, NULL, 0, NULL);
+    }
+    return s_pso_worker != NULL;
+}
+static int pso_queue_pending(u64 hash) {
+    int pending = 0;
+    AcquireSRWLockShared(&s_pso_queue_lock);
+    for (u32 i = 0; i < PSO_ASYNC_MAX; ++i)
+        if (s_pso_jobs[i].state && s_pso_jobs[i].hash == hash) {
+            pending = s_pso_jobs[i].state < 3; break;
+        }
+    ReleaseSRWLockShared(&s_pso_queue_lock);
+    return pending;
+}
+static HRESULT pso_queue_get(u64 hash, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                              ID3D12PipelineState** out) {
+    *out = NULL;
+    if (pso_warm_get(hash, out)) return S_OK;
+    HRESULT result = E_PENDING;
+    AcquireSRWLockExclusive(&s_pso_queue_lock);
+    int slot = -1; u64 oldest = ~0ull;
+    for (u32 i = 0; i < PSO_ASYNC_MAX; ++i) {
+        PsoAsyncJob* j = &s_pso_jobs[i];
+        if (j->state && j->hash == hash) {
+            j->serial = ++s_pso_serial;
+            if (j->state == 3) {
+                result = j->result;
+                if (SUCCEEDED(result) && j->pso) { *out = j->pso; (*out)->lpVtbl->AddRef(*out); }
+            }
+            goto done;
+        }
+        if (!j->state) { slot = (int)i; oldest = 0; }
+        else if (j->state == 3 && j->serial < oldest) { slot = (int)i; oldest = j->serial; }
+    }
+    if (slot < 0 || (pd && (u64)pd->VS.BytecodeLength+pd->PS.BytecodeLength+
+                    (u64)InterlockedCompareExchange64(&s_pso_source_bytes,0,0)>PSO_ASYNC_SOURCE_MAX)) {
+        InterlockedIncrement(&s_pso_full); goto done;
+    }
+    if (!pso_worker_start_locked()) { InterlockedIncrement(&s_pso_full); goto done; }
+    PsoAsyncJob* j = &s_pso_jobs[slot];
+    if (j->pso) j->pso->lpVtbl->Release(j->pso);
+    memset(j, 0, sizeof *j);
+    int copied = pso_job_copy(j, pd);
+    if (copied <= 0) { if(copied<0)InterlockedIncrement(&s_pso_full); result = copied ? E_PENDING : E_INVALIDARG; goto done; }
+    j->hash = hash; j->serial = ++s_pso_serial; j->state = 1;
+    InterlockedIncrement(&s_pso_queued); InterlockedIncrement(&g_rsx_shaders_pending);
+    WakeConditionVariable(&s_pso_queue_cv);
+done:
