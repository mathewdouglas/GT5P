+static void host_apply_prio(HANDLE h, int32_t prio)
+{
+    int n = host_sched_cores();
+    if (n <= 0 || !h) return;
+    SetThreadAffinityMask(h, n >= 2 ? 3 : 1);
+    SetThreadPriorityBoost(h, TRUE);            /* TRUE disables boosting */
+    SetThreadPriority(h, prio <= 1    ? THREAD_PRIORITY_TIME_CRITICAL
+                       : prio < 200   ? THREAD_PRIORITY_HIGHEST
+                       : prio < 400   ? THREAD_PRIORITY_ABOVE_NORMAL
+                       : prio < 800   ? THREAD_PRIORITY_NORMAL
+                       : prio < 1000  ? THREAD_PRIORITY_BELOW_NORMAL
+                       : prio <= 1001 ? THREAD_PRIORITY_LOWEST
+                       :                THREAD_PRIORITY_IDLE);
+}
+#else
