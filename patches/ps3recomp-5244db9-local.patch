diff --git a/include/ps3emu/getenv_cache.h b/include/ps3emu/getenv_cache.h
new file mode 100644
index 0000000..36e18e0
--- /dev/null
+++ b/include/ps3emu/getenv_cache.h
@@ -0,0 +1,24 @@
+/* Per-call-site cache for getenv in hot paths.
+ *
+ * The D3D12 backend, the FIFO walker and the HLE dispatcher test dozens of
+ * debug switches per draw or per call with a bare getenv. On Windows each call
+ * takes the CRT environment lock and scans the whole environment block; at GT5
+ * Prologue's 4,300 draws a frame that was a third of the present thread's time
+ * on the showroom page (Phase 43).
+ *
+ * Including this after the system headers turns each `getenv("LITERAL")` into
+ * one real lookup per call site, the first time it runs. Only for files whose
+ * every getenv takes a string literal, and only for switches set before the
+ * process starts: a value changed with _putenv later is not seen. Define
+ * PS3EMU_GETENV_LIVE before including it to turn the cache off. */
+#ifndef PS3EMU_GETENV_CACHE_H
+#define PS3EMU_GETENV_CACHE_H
+#include <stdlib.h>
+#ifndef PS3EMU_GETENV_LIVE
+#define getenv(name) (__extension__ ({                                       \
+    static char* volatile ps3_ge_v_ = (char*)1;                            \
+    char* ps3_ge_r_ = ps3_ge_v_;                                           \
+    if (ps3_ge_r_ == (char*)1) { ps3_ge_r_ = getenv(name); ps3_ge_v_ = ps3_ge_r_; } \
+    ps3_ge_r_; }))
+#endif
+#endif
diff --git a/include/ps3emu/thread_name.h b/include/ps3emu/thread_name.h
new file mode 100644
index 0000000..25e3db3
--- /dev/null
+++ b/include/ps3emu/thread_name.h
@@ -0,0 +1,17 @@
+/* Name the calling host thread, for debuggers and profilers (GetThreadDescription).
+ * SetThreadDescription is Windows 10 1607 and later, so it is looked up rather
+ * than linked; elsewhere this does nothing. */
+#pragma once
+#ifdef _WIN32
+#include <windows.h>
+static inline void ps3_name_thread(const wchar_t* name)
+{
+    typedef HRESULT (WINAPI *SetDesc)(HANDLE, PCWSTR);
+    static SetDesc set = (SetDesc)-1;
+    if (set == (SetDesc)-1)
+        set = (SetDesc)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription");
+    if (set) set(GetCurrentThread(), name);
+}
+#else
+static inline void ps3_name_thread(const wchar_t* name) { (void)name; }
+#endif
