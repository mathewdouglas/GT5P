+    for (int i = 0; i < 8; i++) if (g->lane_in[i]) {
+        if (g->lane_work[i]) g->idle_streak[i] = 0;
+        else if (g->idle_streak[i] < 255) g->idle_streak[i]++;
+    }
+    spurs_cont_store(g->a.ea, g->a.wid, 0);
+    ps3_tl('E', g->a.wid, 0);
+    InterlockedExchange(&g->busy, 0);
+    if (spurs_kern_wake_on()) spurs_kern_wake(g->a.ea);
+}
+/* Where a render lane runs (SPURS_LANE_PIN, Phase 62). The physical cores,
+ * from the processor topology, without the ones the PPU threads are pinned
+ * to (ppu_sched_mask); lane i of workload w gets core i (wrapping) and that
+ * core's hardware thread w. Workloads 0 and 1, GT5P's render lists, take
+ * alternate frames, so a pass has its lanes on separate physical cores and
+ * the two lists never share a logical CPU. Left to the scheduler, two lanes
+ * often shared a core: pinned, a lane run took 1.14 times less wall time
+ * within the same boot. Returns -1 with no topology or no spare core. */
+static volatile int g_lane_pin = 0;   /* SPURS_LANE_PIN_AB: this window pinned */
+extern DWORD_PTR ppu_sched_mask(void);
+static int spurs_lane_cpu(int w, int i)
+{
+    /* Built once under a lock: the lanes of a workload start together, and a
+     * lane that read the table half-built got CPU 0 -- the PPU core, where the
+     * render thread and Main spin at a higher priority -- and never ran again
+     * (a frozen page, 3 runs in 8). */
+    static SRWLOCK lk = SRWLOCK_INIT;
+    static volatile LONG ready = 0;
+    static int ncore = 0;
+    static int core_lp[64][2], core_n[64];
+    if (!ready) {
+        AcquireSRWLockExclusive(&lk);
+        if (!ready) {
+            int nc = 0, lp[64][2], cn[64];
+            DWORD len = 0;
+            GetLogicalProcessorInformationEx(RelationProcessorCore, NULL, &len);
+            char* buf = len ? (char*)malloc(len) : NULL;
+            const DWORD_PTR ppu = ppu_sched_mask();
+            if (buf && GetLogicalProcessorInformationEx(RelationProcessorCore,
+                           (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)buf, &len)) {
+                for (DWORD off = 0; off < len && nc < 64; ) {
+                    PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX x = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)(buf + off);
+                    if (x->Relationship == RelationProcessorCore && x->Processor.GroupMask[0].Group == 0) {
+                        const KAFFINITY m = x->Processor.GroupMask[0].Mask;
+                        /* Without a known PPU mask, keep the core with CPU 0 for them anyway. */
+                        if (!((ppu ? ppu : (DWORD_PTR)1) & m)) {
+                            int n = 0;
+                            for (int b = 0; b < 64 && n < 2; b++) if (m & ((KAFFINITY)1 << b)) lp[nc][n++] = b;
+                            if (n) { cn[nc] = n; nc++; }
+                        }
+                    }
+                    off += x->Size;
+                }
+            }
+            free(buf);
+            memcpy(core_lp, lp, sizeof lp); memcpy(core_n, cn, sizeof cn); ncore = nc;
+            fprintf(stderr, "[spurs-lane] %d spare cores for render lanes%c", ncore, 10);
+            MemoryBarrier();
+            ready = 1;
+        }
+        ReleaseSRWLockExclusive(&lk);
+    }
+    if (ncore <= 0) return -1;
+    /* Never wrap: on a CPU with fewer spare cores than lane numbers, two
+     * lanes pinned to one logical CPU would take turns while each spins
+     * for the other's output. The lanes past the spare cores stay free. */
+    if (i >= ncore) return -1;
+    const int c = i;
+    const int cpu = core_lp[c][w % core_n[c]];
+    { const DWORD_PTR ppu = ppu_sched_mask();       /* never onto the PPU core */
+      if (ppu & ((DWORD_PTR)1 << cpu)) return -1; }
+    return cpu;
+}
+struct spurs_pool_slot { struct spurs_wkl_group* g; int i; };
+
+static struct spurs_pool_slot s_pool_slot[CELL_SPURS_MAX_WORKLOAD][8];
+static DWORD WINAPI spurs_pool_lane(LPVOID p)
+{
+    spu_host_fp_mode();     /* SPU float flushes denormals (SPU_FTZ) */
+    struct spurs_pool_slot* sl = (struct spurs_pool_slot*)p;
+    struct spurs_wkl_group* g = sl->g; int i = sl->i;
+    fprintf(stderr, "[hostthread] spurs-lane hosttid=%lu\n", (unsigned long)GetCurrentThreadId());
+    ps3_name_thread(L"spurs-lane");
+#ifdef _WIN32
+    { ULONG gs = 256 * 1024; SetThreadStackGuarantee(&gs); }
+#endif
+    if (g_spurs_lane_start_hook) g_spurs_lane_start_hook();
+    /* SPURS_LANE_CPUS=<cpu>,<cpu>,...: pool lane i runs only on the i-th
+     * logical CPU listed (wrapping), e.g. one lane per physical core. Only the
+     * workloads in SPURS_LANE_CPU_WIDS (default "0,1": GT5P's two render
+     * lists, which take alternate frames). Pinning every workload put the
+     * short jobs of workloads 2 and 3 behind a render lane on its CPU, and
+     * the render thread waits on those. */
+    { const char* e = getenv("SPURS_LANE_CPUS");
+      const char* wl = getenv("SPURS_LANE_CPU_WIDS");
+      const int wid = (int)(g - s_wkl_group);
+      int listed = 0;
+      for (const char* q = (wl && *wl) ? wl : "0,1"; *q; ) {
+          if (atoi(q) == wid) listed = 1;
+          while (*q && *q != ',') q++;
+          if (*q == ',') q++;
+      }
+      /* SPURS_LANE_PIN: 2 a hard mask (1.14x faster lanes; it made the dealer
+       * freeze more likely until Phase 64 fixed the freeze, and is GT5P's
+       * default since: 0 stalls in 20), 1 a hint (no gain), 0 (the runtime's
+       * default) the scheduler's choice; by topology (spurs_lane_cpu) unless SPURS_LANE_CPUS lists
+       * CPUs. Render workloads only (SPURS_LANE_CPU_WIDS). */
+      { static int pin = -1;
+        if (pin < 0) { const char* pe = getenv("SPURS_LANE_PIN"); pin = pe ? atoi(pe) : 0; }
+        if (listed && pin && !(e && *e) && !getenv("SPURS_LANE_PIN_AB")) {
+            const int cpu = spurs_lane_cpu(wid, i);
+            if (cpu >= 0) {
+                if (pin >= 2) {
+                    SetThreadAffinityMask(GetCurrentThread(), (DWORD_PTR)1 << cpu);
+                    /* A pinned lane cannot move away from a busier thread of
+                     * higher priority (the sound chain and the replay thread
+                     * run above normal): at normal it stalled the page in 5
+                     * of 7 runs. Same priority, the CPU is shared in turn.
+                     * SPURS_LANE_PRIO=0: leave it at normal. */
+                    const char* pr = getenv("SPURS_LANE_PRIO");
+                    if (!(pr && *pr == '0')) SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+                } else
+                    SetThreadIdealProcessor(GetCurrentThread(), (DWORD)cpu);
+            }
+        } }
+      if (e && *e && listed) {
+          int cpus[16], n = 0;
+          for (const char* q = e; *q && n < 16; ) {
+              cpus[n++] = atoi(q);
+              while (*q && *q != ',') q++;
+              if (*q == ',') q++;
+          }
+          /* A hint by default (SetThreadIdealProcessor); SPURS_LANE_CPU_HARD=1
+           * is a hard mask, which stalled 1 run in 4: a spinning thread can
+           * shut out another pinned to the same CPU. */
+          if (n && cpus[i % n] >= 0 && cpus[i % n] < 64) {
+              if (getenv("SPURS_LANE_CPU_HARD"))
+                  SetThreadAffinityMask(GetCurrentThread(), (DWORD_PTR)1 << cpus[i % n]);
+              else
+                  SetThreadIdealProcessor(GetCurrentThread(), (DWORD)cpus[i % n]);
+          }
+      } }
+    for (;;) {
+        WaitForSingleObject(g->lane_go[i], INFINITE);
+        struct spurs_pm_worker_arg* a = &g->lane_a[i];
+        s_tls_spurs_ea = a->ea;
+        if (a->delay_ms) Sleep(a->delay_ms);
+        if (a->delay_us) {
+            LARGE_INTEGER f0, t0, t1; QueryPerformanceFrequency(&f0); QueryPerformanceCounter(&t0);
+            const LONGLONG until = t0.QuadPart + (LONGLONG)a->delay_us * f0.QuadPart / 1000000;
+            do { YieldProcessor(); QueryPerformanceCounter(&t1); } while (t1.QuadPart < until);
+        }
+        /* SPURS_LANE_PIN_AB=1 (experiment): render lanes of workload 0 on the
+         * first hardware thread of cores 1-5 and workload 1's on the second,
+         * in every other lane-timing window; free in the rest. Measures
+         * whether placement matters within one boot. */
+        { static int pab = -1; if (pab < 0) { const char* e = getenv("SPURS_LANE_PIN_AB"); pab = e ? (atoi(e) == 2 ? 2 : 1) : 0; }
+          const int w = (int)(g - s_wkl_group);
+          if (pab && w <= 1) {
+              static DWORD_PTR procmask = 0;
+              if (!procmask) { DWORD_PTR sm; GetProcessAffinityMask(GetCurrentProcess(), &procmask, &sm); }
+              const int cpu = spurs_lane_cpu(w, i);
+              /* =1 a hard mask in pinned windows; =2 only the ideal
+               * processor (a hint), set back to the lane's own in the rest. */
+              static __declspec(thread) DWORD own_ideal = (DWORD)-1;
+              if (own_ideal == (DWORD)-1) own_ideal = SetThreadIdealProcessor(GetCurrentThread(), MAXIMUM_PROCESSORS);
+              if (cpu >= 0) {
+                  if (pab == 2) SetThreadIdealProcessor(GetCurrentThread(), g_lane_pin ? (DWORD)cpu : own_ideal);
+                  else SetThreadAffinityMask(GetCurrentThread(), g_lane_pin ? ((DWORD_PTR)1 << cpu) : procmask);
+              }
+          } }
+        /* SPURS_LANE_CYC=1: every 5 s, per workload, the mean lane run in
+         * wall time against the lane thread's own CPU cycles (in ms at the
+         * TSC rate): a run that grows in cycles is slowed on its core, one
+         * that grows only in wall time waits. */
+        { static int cyc = -1; if (cyc < 0) cyc = getenv("SPURS_LANE_CYC") ? 1 : 0;
+          if (!cyc) spurs_lane_run(a);
+          else {
+              static volatile LONG64 s_wall[CELL_SPURS_MAX_WORKLOAD], s_cy[CELL_SPURS_MAX_WORKLOAD];
+              static volatile LONG s_n[CELL_SPURS_MAX_WORKLOAD]; static volatile LONG64 s_t0;
+              ULONG64 c0, c1; LARGE_INTEGER q0, q1, qf;
+              QueryThreadCycleTime(GetCurrentThread(), &c0); QueryPerformanceCounter(&q0);
+              spurs_lane_run(a);
+              QueryThreadCycleTime(GetCurrentThread(), &c1); QueryPerformanceCounter(&q1);
+              QueryPerformanceFrequency(&qf);
+              const int w = (int)(g - s_wkl_group);
+              InterlockedAdd64(&s_wall[w], (LONG64)((q1.QuadPart - q0.QuadPart) * 1000000 / qf.QuadPart));
+              InterlockedAdd64(&s_cy[w], (LONG64)(c1 - c0));
+              InterlockedIncrement(&s_n[w]);
+              ULONGLONG now = GetTickCount64();
+              if (!s_t0) s_t0 = (LONG64)now;
+              if (now - (ULONGLONG)s_t0 >= 5000 && InterlockedExchange64(&s_t0, (LONG64)now) != (LONG64)now) {
+                  /* TSC ticks per us, from the cycle counter against QPC over this window. */
+                  static ULONG64 tsc0; static LARGE_INTEGER qq0;
+                  ULONG64 tsc = __rdtsc(); LARGE_INTEGER qq; QueryPerformanceCounter(&qq);
+                  double tpu = (tsc0 && qq.QuadPart > qq0.QuadPart)
+                      ? (double)(tsc - tsc0) / ((double)(qq.QuadPart - qq0.QuadPart) * 1e6 / (double)qf.QuadPart) : 0;
+                  tsc0 = tsc; qq0 = qq;
+                  extern volatile int g_spu_fast;
+                  static int ab = -1; if (ab < 0) ab = getenv("SPU_FAST_AB") ? 1 : 0;
+                  extern volatile int g_spu_exp;
+                  static int xab = -1; if (xab < 0) xab = getenv("SPU_EXP_AB") ? 1 : 0;
+                  fprintf(stderr, "[lane-cyc] fast=%d pin=%d exp=%d", g_spu_fast, g_lane_pin, g_spu_exp);
+                  for (int k = 0; k < CELL_SPURS_MAX_WORKLOAD; k++) {
+                      LONG n = InterlockedExchange(&s_n[k], 0);
+                      LONG64 wl = InterlockedExchange64(&s_wall[k], 0), cy = InterlockedExchange64(&s_cy[k], 0);
+                      if (n && tpu > 0)
+                          fprintf(stderr, " w%d: %ld runs, wall %.2f ms, cpu %.2f ms", k, (long)n,
+                                  wl / 1000.0 / n, cy / tpu / 1000.0 / n);
+                  }
+                  fprintf(stderr, "%c", 10);
+                  /* SPU_FAST_AB=1: the next window runs the other way. */
+                  if (ab) g_spu_fast = !g_spu_fast;
+                  /* SPU_EXP_AB=1: the experiment under test (g_spu_exp) flips. */
+                  if (xab) g_spu_exp = !g_spu_exp;
+                  { static int pab2 = -1; if (pab2 < 0) pab2 = getenv("SPURS_LANE_PIN_AB") ? 1 : 0;
+                    if (pab2) g_lane_pin = !g_lane_pin; }
+              }
+          } }
+        if (InterlockedDecrement(&g->remaining) == 0) spurs_group_end(g);
+    }
+    return 0;
+}
+/* Sends the group's lanes; 0 if the pool could not be set up. */
+static int spurs_pool_dispatch(struct spurs_wkl_group* g)
+{
+    u32 wid = g->a.wid, n = g->lanes > 8 ? 8 : g->lanes;
+    static int prune = -1, st = -1;
+    if (prune < 0) { const char* e = getenv("SPURS_LANE_PRUNE"); prune = (e && *e == '0') ? 0 : 1; }
+    if (st < 0) { const char* e = getenv("SPURS_LANE_STAGGER_MS"); st = e ? atoi(e) : 1; }
+    /* SPURS_LANE_STAGGER_US=<us>: every lane after the first starts that many
+     * microseconds late, all together, instead of 1, 2, 3... ms late. Only the
+     * first lane sets the list up; the 1 ms steps cost the later lanes several
+     * ms of a ~30 ms pass (Phase 60). */
+    static int stus = -2;
+    if (stus == -2) { const char* e = getenv("SPURS_LANE_STAGGER_US"); stus = e ? atoi(e) : -1; }
+    for (u32 i = 0; i < n; i++) if (!g->lane_go[i]) {
+        g->lane_go[i] = CreateEventW(NULL, FALSE, FALSE, NULL);
+        s_pool_slot[wid][i].g = g; s_pool_slot[wid][i].i = (int)i;
+        HANDLE t = g->lane_go[i] ? CreateThread(NULL, 1u << 20, spurs_pool_lane, &s_pool_slot[wid][i], 0, NULL) : NULL;
+        if (!t) { if (g->lane_go[i]) CloseHandle(g->lane_go[i]); g->lane_go[i] = NULL; return 0; }
+        CloseHandle(t);
+    }
+    g->dispatch_n++;
+    /* SPURS_LANE_MASK (on): a WWS job list names the SPUs allowed on it in a
+     * byte at its header +0x2F (bit 0x80 >> spuNum). Gran Turismo 5
+     * Prologue's render lists say 0xEF: no SPU 3. Such an SPU takes no job,
+     * but the module still writes its own bookkeeping row, header +0x40 +
+     * 16 * spuNum, with plain PUTs as it enters and leaves -- and SPU 3's row
+     * is queue 3's progress row, the one the title waits on. Sent in, lane 3
+     * overwrote the other SPUs' progress (the frozen dealer page, Phase 64:
+     * stalls on the first dispatches, before lane 3 was pruned, and on its
+     * every-64th retry). Lanes outside the mask are not sent. =0: send them. */
+    u8 allow = 0xFF;
+    { static int on = -1;
+      if (on < 0) { const char* e = getenv("SPURS_LANE_MASK"); on = (e && *e == '0') ? 0 : 1; }
+      const u32 hd = (u32)g->a.arg;
+      if (on && hd >= 0x10000 && hd < 0x40000000 && !(hd & 0x7F)) {
+          allow = *(vm_base + hd + 0x2F);
+          if (!allow) allow = 0xFF;                   /* no mask written yet */
+          static u8 said[CELL_SPURS_MAX_WORKLOAD];
+          if (allow != 0xFF && !said[wid]) {
+              said[wid] = 1;
+              fprintf(stderr, "[spurs-lane] wid=%u job list 0x%08X allows SPUs mask 0x%02X%c", wid, hd, allow, 10);
+          }
+      } }
+    u32 send = 0;
+    for (u32 i = 0; i < 8; i++) {
+        g->lane_in[i] = (u8)(i < n && (i == 0 || !prune || g->idle_streak[i] < 8 || (g->dispatch_n % 64) == 0)
+                             && (i == 0 || (allow & (0x80u >> i))));
+        send += g->lane_in[i];
+    }
+    g->working = 0;
+    g->remaining = (LONG)send;
+    u32 k = 0;
+    for (u32 i = 0; i < n; i++) if (g->lane_in[i]) {
+        g->lane_a[i] = g->a;
+        g->lane_a[i].spu_num = i;
+        g->lane_a[i].working = &g->working;
+        g->lane_a[i].did_work = &g->lane_work[i];
+        g->lane_a[i].delay_ms = stus >= 0 ? 0 : (uint32_t)st * k;
+        g->lane_a[i].delay_us = (stus >= 0 && k) ? (uint32_t)stus : 0;
+        k++;
+        g->lane_work[i] = 0;
+    }
+    for (u32 i = 0; i < n; i++) if (g->lane_in[i]) SetEvent(g->lane_go[i]);
+    return 1;
+}
+/* For a stall report (gt5p_present.cpp): every workload's host-side group
+ * state and the guest's contention and ready bytes, and the kernel event log. */
+void cellSpurs_debug_dump_to(FILE* out)
+{
+    for (u32 w = 0; w < CELL_SPURS_MAX_WORKLOAD; w++) {
+        if (!s_workloads[w].in_use) continue;
+        const struct spurs_wkl_group* g = &s_wkl_group[w];
+        const u32 ea = g->a.ea;
+        fprintf(out, "[stall]   wid=%u busy=%ld lanes=%u remaining=%ld working=%ld dispatches=%u",
+                w, (long)g->busy, g->lanes, (long)g->remaining, (long)g->working, g->dispatch_n);
+        if (ea) {
+            u8 cont = 0, ready = 0;
+#ifdef _WIN32
+            ReadProcessMemory(GetCurrentProcess(), vm_base + ea + SPURS_WKL_CURCONT + w, &cont, 1, NULL);
+            ReadProcessMemory(GetCurrentProcess(), vm_base + ea + SPURS_WKL_READY1 + w, &ready, 1, NULL);
+#else
+            cont = *(vm_base + ea + SPURS_WKL_CURCONT + w); ready = *(vm_base + ea + SPURS_WKL_READY1 + w);
+#endif
+            fprintf(out, " guest cont=%u ready=%u", cont, ready);
+        }
+        fprintf(out, " lane_in=");
+        for (int i = 0; i < 8; i++) fprintf(out, "%u", g->lane_in[i]);
+        fprintf(out, " idle=");
+        for (int i = 0; i < 8; i++) fprintf(out, "%u.", g->idle_streak[i]);
+        fprintf(out, " arg=%llX%c", (unsigned long long)g->a.arg, 10);
+        /* A WWS job list's header: list pointers at +0x30, then a row per
+         * queue from +0x40 (published head, then per-SPU progress). */
+        const u32 hd = (u32)g->a.arg;
+        if (hd >= 0x10000 && hd < 0x40000000 && !(hd & 0xF))
+            for (u32 o = 0x20; o < 0x90; o += 16) {
+                u8 q[16];
+#ifdef _WIN32
+                SIZE_T got = 0;
+                if (!ReadProcessMemory(GetCurrentProcess(), vm_base + hd + o, q, sizeof q, &got) || got != sizeof q) {
+                    fprintf(out, "[stall]     %08X: unavailable\n", hd + o); continue;
+                }
+#else
+                memcpy(q, vm_base + hd + o, sizeof q);
+#endif
+                fprintf(out, "[stall]     %08X:", hd + o);
+                for (int k = 0; k < 16; k++) fprintf(out, "%s%02X", (k & 1) ? "" : " ", q[k]);
+                fprintf(out, "%c", 10);
+            }
+    }
+    fflush(out);
+}
+
+void cellSpurs_debug_dump(void)
+{
+    cellSpurs_debug_dump_to(stderr);
+    { extern void spu_rowlog_dump(void); spu_rowlog_dump(); }
+}
