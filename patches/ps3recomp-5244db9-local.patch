+/* PAD_HOLD="<from_ms>-<to_ms>:<KEY>,...": hold a button over a span of time
+ * measured from the first poll, with no keyboard and no window focus needed,
+ * so a run that has to be driven can be repeated unattended. Keys: UP DOWN
+ * LEFT RIGHT CROSS CIRCLE SQUARE TRIANGLE START SELECT. Returns -1 when the
+ * variable is not set, else the buttons held now. */
+/* Draw count of the last frame the video backend presented. */
+unsigned g_pad_frame_draws;
+
+static int pad_script_buttons(void)
+{
+    static int parsed = 0, n = 0;
+    static struct { u32 from, to; u16 btn; } ev[64];
+    static ULONGLONG t0 = 0;
+    if (!parsed) {
+        parsed = 1;
+        const char* e = getenv("PAD_HOLD");
+        static const struct { const char* name; u16 btn; } names[] = {
+            { "UP", CELL_PAD_CTRL_UP }, { "DOWN", CELL_PAD_CTRL_DOWN },
+            { "LEFT", CELL_PAD_CTRL_LEFT }, { "RIGHT", CELL_PAD_CTRL_RIGHT },
+            { "CROSS", CELL_PAD_CTRL_CROSS }, { "CIRCLE", CELL_PAD_CTRL_CIRCLE },
+            { "SQUARE", CELL_PAD_CTRL_SQUARE }, { "TRIANGLE", CELL_PAD_CTRL_TRIANGLE },
+            { "START", CELL_PAD_CTRL_START }, { "SELECT", CELL_PAD_CTRL_SELECT },
+        };
+        while (e && *e && n < 64) {
+            unsigned a = 0, b = 0; char key[16] = {0};
+            if (sscanf(e, "%u-%u:%15[A-Z]", &a, &b, key) == 3)
+                for (unsigned i = 0; i < sizeof names / sizeof names[0]; i++)
+                    if (!strcmp(key, names[i].name)) {
+                        ev[n].from = a; ev[n].to = b; ev[n].btn = names[i].btn; n++;
+                    }
+            e = strchr(e, ',');
+            if (e) e++;
+        }
+        if (n) { t0 = GetTickCount64();
+                 printf("[cellPad] PAD_HOLD: %d timed presses%c", n, 10); fflush(stdout); }
+    }
+    if (!n) return -1;
+    /* PAD_HOLD_STOP_DRAWS="<ms>,<m>": after <ms>, wait for a frame of under m
+     * draws (a plain dialog), then let go of everything as soon as the draw
+     * count moves off that frame's by more than 8. How long the load behind a
+     * dialog takes varies by seconds from boot to boot, and the dialog takes
+     * its OK only when the load is done, so "press until it goes away, then
+     * stop" cannot be written as times alone. */
+    { static int inited = 0, done = 0, armed = 0;
+      static unsigned after = 0, below = 0, at = 0;
+      if (!inited) { inited = 1;
+          const char* e = getenv("PAD_HOLD_STOP_DRAWS");
+          if (e) { after = (unsigned)atoi(e);
+                   const char* c = strchr(e, ','); below = c ? (unsigned)atoi(c + 1) : 0; } }
+      if (below && !done) {
+          unsigned d = g_pad_frame_draws;
+          if (!armed) {
+              if ((unsigned)(GetTickCount64() - t0) >= after && d && d < below) { armed = 1; at = d; }
+          } else if (d > at + 8u || d + 8u < at) {
+              done = 1;
+              printf("[cellPad] PAD_HOLD: stopped, draws went %u -> %u%c", at, d, 10); fflush(stdout);
+          }
+      }
+      if (done) return 0; }
+    u32 now = (u32)(GetTickCount64() - t0);
+    int btns = 0;
+    for (int i = 0; i < n; i++)
+        if (now >= ev[i].from && now < ev[i].to) btns |= ev[i].btn;
+    return btns;
+}
