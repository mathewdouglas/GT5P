+/* A persistently mapped per-frame buffer in `hp` (the upload heap, or the GPU
+ * upload heap with RSX_GPU_UPLOAD=1); falls back to the upload heap. */
+static HRESULT create_dyn_buffer(const D3D12_HEAP_PROPERTIES* hp, const D3D12_RESOURCE_DESC* bd,
+                                 ID3D12Resource** out)
+{
+    HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, hp,
+        D3D12_HEAP_FLAG_NONE, bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+        &IID_ID3D12Resource, (void**)out);
+    if (FAILED(hr) && hp->Type != D3D12_HEAP_TYPE_UPLOAD) {
+        fprintf(stderr, "[D3D12] GPU upload heap buffer (%llu MB) failed 0x%08lX; system memory%c",
+                (unsigned long long)(bd->Width >> 20), (unsigned long)hr, 10);
+        D3D12_HEAP_PROPERTIES up = *hp; up.Type = D3D12_HEAP_TYPE_UPLOAD;
+        hr = s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &up,
+            D3D12_HEAP_FLAG_NONE, bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+            &IID_ID3D12Resource, (void**)out);
+    }
+    return hr;
+}
