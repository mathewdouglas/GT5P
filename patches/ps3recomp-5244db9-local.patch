+              }
+          } }
+        if (InterlockedDecrement(&g->remaining) == 0) spurs_group_end(g);
+    }
+    return 0;
+}
+/* Sends the group's lanes; 0 if the pool could not be set up. */
+static int spurs_pool_dispatch(struct spurs_wkl_group* g)
+{
+    u32 wid = g->a.wid, n = g->lanes > 8 ? 8 : g->lanes;
+    static int prune = -1, st = -1;
+    if (prune < 0) { const char* e = getenv("SPURS_LANE_PRUNE"); prune = (e && *e == '0') ? 0 : 1; }
+    if (st < 0) { const char* e = getenv("SPURS_LANE_STAGGER_MS"); st = e ? atoi(e) : 1; }
+    /* SPURS_LANE_STAGGER_US=<us>: every lane after the first starts that many
+     * microseconds late, all together, instead of 1, 2, 3... ms late. Only the
+     * first lane sets the list up; the 1 ms steps cost the later lanes several
+     * ms of a ~30 ms pass (Phase 60). */
+    static int stus = -2;
+    if (stus == -2) { const char* e = getenv("SPURS_LANE_STAGGER_US"); stus = e ? atoi(e) : -1; }
+    for (u32 i = 0; i < n; i++) if (!g->lane_go[i]) {
+        g->lane_go[i] = CreateEventW(NULL, FALSE, FALSE, NULL);
+        s_pool_slot[wid][i].g = g; s_pool_slot[wid][i].i = (int)i;
+        HANDLE t = g->lane_go[i] ? CreateThread(NULL, 1u << 20, spurs_pool_lane, &s_pool_slot[wid][i], 0, NULL) : NULL;
+        if (!t) { if (g->lane_go[i]) CloseHandle(g->lane_go[i]); g->lane_go[i] = NULL; return 0; }
+        CloseHandle(t);
+    }
+    g->dispatch_n++;
+    /* SPURS_LANE_MASK (on): a WWS job list names the SPUs allowed on it in a
+     * byte at its header +0x2F (bit 0x80 >> spuNum). Gran Turismo 5
+     * Prologue's render lists say 0xEF: no SPU 3. Such an SPU takes no job,
+     * but the module still writes its own bookkeeping row, header +0x40 +
+     * 16 * spuNum, with plain PUTs as it enters and leaves -- and SPU 3's row
+     * is queue 3's progress row, the one the title waits on. Sent in, lane 3
+     * overwrote the other SPUs' progress (the frozen dealer page, Phase 64:
+     * stalls on the first dispatches, before lane 3 was pruned, and on its
+     * every-64th retry). Lanes outside the mask are not sent. =0: send them. */
+    u8 allow = 0xFF;
+    { static int on = -1;
+      if (on < 0) { const char* e = getenv("SPURS_LANE_MASK"); on = (e && *e == '0') ? 0 : 1; }
+      const u32 hd = (u32)g->a.arg;
+      /* Below 0x40000000 only: Gran Turismo 5's lists (0x402xxxxx) keep
+       * four 16-bit queue masks at +0x20..+0x2F (workload 5: 03FF 03FF
+       * 000F 000F), so +0x2F is no SPU mask there; read as one, it cut
+       * workload 5 to a single lane and the race froze (GT5 Phase 23). */
+      if (on && hd >= 0x10000 && hd < 0x40000000 && !(hd & 0x7F)) {
+          allow = *(vm_base + hd + 0x2F);
+          if (!allow) allow = 0xFF;                   /* no mask written yet */
+          static u8 said[CELL_SPURS_MAX_WORKLOAD];
+          if (allow != 0xFF && !said[wid]) {
+              said[wid] = 1;
+              fprintf(stderr, "[spurs-lane] wid=%u job list 0x%08X allows SPUs mask 0x%02X%c", wid, hd, allow, 10);
+          }
+      } }
+    u32 send = 0;
+    for (u32 i = 0; i < 8; i++) {
+        g->lane_in[i] = (u8)(i < n && (i == 0 || !prune || g->idle_streak[i] < 8 || (g->dispatch_n % 64) == 0)
+                             && (i == 0 || (allow & (0x80u >> i))));
+        send += g->lane_in[i];
+    }
+    g->working = 0;
+    g->remaining = (LONG)send;
+    u32 k = 0;
+    for (u32 i = 0; i < n; i++) if (g->lane_in[i]) {
+        g->lane_a[i] = g->a;
+        g->lane_a[i].spu_num = i;
+        g->lane_a[i].working = &g->working;
+        g->lane_a[i].did_work = &g->lane_work[i];
+        g->lane_a[i].delay_ms = stus >= 0 ? 0 : (uint32_t)st * k;
+        g->lane_a[i].delay_us = (stus >= 0 && k) ? (uint32_t)stus : 0;
+        k++;
+        g->lane_work[i] = 0;
+    }
+    for (u32 i = 0; i < n; i++) if (g->lane_in[i]) SetEvent(g->lane_go[i]);
+    return 1;
+}
+/* For a stall report (gt5p_present.cpp): every workload's host-side group
+ * state and the guest's contention and ready bytes, and the kernel event log. */
+void cellSpurs_debug_dump_to(FILE* out)
+{
+    for (u32 w = 0; w < CELL_SPURS_MAX_WORKLOAD; w++) {
+        if (!s_workloads[w].in_use) continue;
+        const struct spurs_wkl_group* g = &s_wkl_group[w];
+        const u32 ea = g->a.ea;
+        fprintf(out, "[stall]   wid=%u busy=%ld lanes=%u remaining=%ld working=%ld dispatches=%u",
+                w, (long)g->busy, g->lanes, (long)g->remaining, (long)g->working, g->dispatch_n);
+        if (ea) {
+            u8 cont = 0, ready = 0;
+#ifdef _WIN32
+            ReadProcessMemory(GetCurrentProcess(), vm_base + ea + SPURS_WKL_CURCONT + w, &cont, 1, NULL);
+            ReadProcessMemory(GetCurrentProcess(), vm_base + ea + SPURS_WKL_READY1 + w, &ready, 1, NULL);
+#else
+            cont = *(vm_base + ea + SPURS_WKL_CURCONT + w); ready = *(vm_base + ea + SPURS_WKL_READY1 + w);
+#endif
+            fprintf(out, " guest cont=%u ready=%u", cont, ready);
+        }
+        fprintf(out, " lane_in=");
+        for (int i = 0; i < 8; i++) fprintf(out, "%u", g->lane_in[i]);
+        fprintf(out, " idle=");
+        for (int i = 0; i < 8; i++) fprintf(out, "%u.", g->idle_streak[i]);
+        fprintf(out, " arg=%llX%c", (unsigned long long)g->a.arg, 10);
+        /* A WWS job list's header: list pointers at +0x30, then a row per
+         * queue from +0x40 (published head, then per-SPU progress). */
+        const u32 hd = (u32)g->a.arg;
+        if (hd >= 0x10000 && hd < 0xC0000000u && !(hd & 0xF))
+            for (u32 o = 0x20; o < 0x90; o += 16) {
+                u8 q[16];
+#ifdef _WIN32
+                SIZE_T got = 0;
+                if (!ReadProcessMemory(GetCurrentProcess(), vm_base + hd + o, q, sizeof q, &got) || got != sizeof q) {
+                    fprintf(out, "[stall]     %08X: unavailable\n", hd + o); continue;
+                }
+#else
+                memcpy(q, vm_base + hd + o, sizeof q);
+#endif
+                fprintf(out, "[stall]     %08X:", hd + o);
+                for (int k = 0; k < 16; k++) fprintf(out, "%s%02X", (k & 1) ? "" : " ", q[k]);
+                fprintf(out, "%c", 10);
+            }
+    }
+    fflush(out);
+}
+
+void cellSpurs_debug_dump(void)
+{
+    cellSpurs_debug_dump_to(stderr);
+    /* GCM labels 0x40-0x5F (guest 0x03000400): render jobs waiting for ring
+     * space poll one each (Gran Turismo 5: 0x48 + SPU), written by semaphore
+     * releases in the command stream. */
+#ifdef _WIN32
+    for (u32 l = 0x40; l < 0x60; l += 8) {
+        u8 q[0x80]; SIZE_T got = 0;
+        if (!ReadProcessMemory(GetCurrentProcess(), vm_base + 0x03000000u + l * 16, q, sizeof q, &got) || got != sizeof q) break;
+        fprintf(stderr, "[stall]   labels %02X..%02X:", l, l + 7);
+        for (int k = 0; k < 8; k++)
+            fprintf(stderr, " %02X%02X%02X%02X", q[k * 16], q[k * 16 + 1], q[k * 16 + 2], q[k * 16 + 3]);
+        fprintf(stderr, "%c", 10);
+    }
+#endif
+    { extern void spu_rowlog_dump(void); spu_rowlog_dump(); }
+}
