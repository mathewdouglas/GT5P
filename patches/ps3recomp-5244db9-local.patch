+    const u64 n = f->draw_count < s_draw_cap ? f->draw_count : s_draw_cap;
+    if (f->ext_vb > s_peak_vb) s_peak_vb = f->ext_vb;
+    if (f->ext_ib > s_peak_ib) s_peak_ib = f->ext_ib;
+    if (f->ext_vraw > s_peak_vraw) s_peak_vraw = f->ext_vraw;
+    if (n > s_peak_draws) s_peak_draws = (u32)n;
