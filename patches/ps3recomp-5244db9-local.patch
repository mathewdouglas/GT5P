+    fprintf(stderr, "[RTCUBE] cube from targets at 0x%X: %ux%u, %u levels, face stride %u%c",
+            raw, w, h, mips, r0->pitch * rtcube_rows(h, mips), 10);
+    return free_i;
+}
+static void rtcube_srv(u32 heap_slot, int i)
+{
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = (DXGI_FORMAT)s_rtcube[i].dxgi;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
